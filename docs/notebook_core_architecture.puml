@startuml GC2D_notebook_core_architecture
title Notebook Execution and Core modules Package Architecture

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowColor #4A5568
skinparam ComponentBorderColor #2D3748
skinparam ComponentBackgroundColor #F7FAFC
skinparam PackageBorderColor #718096
skinparam PackageBackgroundColor #EDF2F7
skinparam ArtifactBorderColor #2D3748
skinparam ArtifactBackgroundColor #FFFFF0

actor "Notebook user" as user

package "Notebook layer" {
  component "notebooks/\nworkflows_demo.ipynb" as notebook
  component "Parameter cells\nbase dict + overrides" as params_cells
  component "Plot cells\nPoincare / diagnostics" as plot_cells
}

package "src public notebook API" {
  component "workflows_api.py" as notebook_api
  component "make_params(base, **overrides)" as make_params
  component "make_system(params)" as make_system
  component "to_symp_params(params)" as to_symp_params
  component "run_workflow(system, plot=True, save=True)" as run_workflow
  component "integrate_simulation(system)" as integrate_simulation
  component "plot_poincare(result)" as plot_poincare
  component "SimulationResult\nsystem, sol, elapsed,\nfig, ax" as result
}

package "src numerical model" {
  component "classes/fourier_system.py\nFourierSystem" as fourier_system
  component "initial_conditions()" as initial_conditions
  component "Hamiltonian methods\ny_dot(), k_dot(),\npotential(), hamiltonian()" as hamiltonian_methods
  component "Full-orbit splitting\nchi(), chi_star()" as splitting_methods
}

package "src workflows" {
  component "workflows/export.py\nsave_data(system, sol)" as save_data
}

package "src support" {
  component "conf/notebook/fourier/test/v_1.json\noptional base configuration" as fourier_config
  component "config_logging.py\nsimulation_label()" as config_logging
}

package "External runtime" {
  component "pyhamsys\nsolve_ivp_sympext()" as solve_gc
  component "pyhamsys\nsolve_ivp_symp()" as solve_fo
  component "NumPy / SciPy\narrays, Bessel J0,\nNumPy export" as scientific_stack
  component "Matplotlib\naxes, figures, display" as matplotlib
}

artifact "Notebook outputs\ninline figures\nSimulationResult object\noptional .npz files" as outputs

user --> notebook : runs cells
notebook --> params_cells : edits parameters
notebook --> plot_cells : inspects results

params_cells --> fourier_config : may load defaults
params_cells --> make_params : creates case dict
params_cells --> make_system : creates FourierSystem system

notebook --> run_workflow : simple path
notebook --> integrate_simulation : manual integration path
notebook --> plot_poincare : manual plotting path

notebook_api --> config_logging : labels integration logs
notebook_api --> result : returns structured result

make_params --> to_symp_params : validates parameters
make_system --> to_symp_params : normalizes traj_type\nand eta
make_system --> fourier_system : FourierSystem(params)
run_workflow --> integrate_simulation : executes simulation
run_workflow --> plot_poincare : optional plot for\nMethod=poincare_*

integrate_simulation --> initial_conditions : builds y0
integrate_simulation --> solve_gc : if traj_type='gc'
integrate_simulation --> solve_fo : if traj_type='fo'
integrate_simulation --> result : stores system, sol,\nelapsed time

fourier_system --> hamiltonian_methods : guiding-center dynamics
fourier_system --> splitting_methods : full-orbit dynamics
fourier_system --> scientific_stack : Fourier turbulent potential,\nFLR correction

solve_gc --> fourier_system : calls HamSys interface
solve_fo --> splitting_methods : calls chi / chi_star
solve_fo --> fourier_system : rectify_sol(check_energy)

plot_poincare --> result : reads sol.y and system
plot_poincare --> matplotlib : creates or reuses axes
plot_cells --> matplotlib : displays figures

save_data --> outputs : optional .npz export
plot_poincare --> outputs : inline figure handles
result --> outputs : returned to notebook

note right of integrate_simulation
  Integration branch:
  - gc: solve_ivp_sympext(system, ...)
  - fo: solve_ivp_symp(system.chi, system.chi_star, ...)
        then system.rectify_sol(...)
end note

note bottom of result
  SimulationResult is the notebook-friendly boundary:
  it keeps numerical state, timing, and plot handles together.
end note

@enduml
