@startuml GC2D_notebook_architecture
title Notebook API sobre Potential, Trajectory y System

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

actor "Notebook user" as user

package "Notebook" {
  component "parameter cells" as params
  component "simulation cell" as simulation_cell
  component "plot / diagnostics cells" as plot_cells
}

package "Public workflow API" {
  component "load config" as load
  component "make_potential()" as make_potential
  component "make_trajectory()" as make_trajectory
  component "create_system()" as create_system
  component "run_workflow()" as workflow
}

package "Domain" {
  component "Potential" as potential
  component "GridPotential" as grid_potential
  component "FourierPotential" as fourier_potential
  component "Trajectory" as trajectory
  component "TrajectoryGC" as trajectory_gc
  component "TrajectoryFC" as trajectory_fc
  component "System" as system
  component "SystemGC" as system_gc
  component "SystemFC" as system_fc
}

package "Simulation" {
  component "system.simulate()" as simulate
  component "gc_solver" as gc_solver
  component "fc_solver" as fc_solver
  component "SimulationResult" as result
}

package "Presentation" {
  component "plotting" as plotting
  component "optional export" as export
}

user --> params
params --> load
load --> make_potential
load --> make_trajectory
make_potential --> grid_potential
make_potential --> fourier_potential
grid_potential --|> potential
fourier_potential --|> potential
make_trajectory --> trajectory_gc
make_trajectory --> trajectory_fc
trajectory_gc --|> trajectory
trajectory_fc --|> trajectory
potential --> create_system
trajectory --> create_system
create_system --> system_gc
create_system --> system_fc
system_gc --|> system
system_fc --|> system

simulation_cell --> workflow
workflow --> simulate
system --> simulate
simulate --> gc_solver : SystemGC
simulate --> fc_solver : SystemFC
gc_solver --> result
fc_solver --> result
result --> plot_cells
plot_cells --> plotting
result --> export

note right of workflow
  The workflow coordinates I/O.
  Numerical branching stays in System.
end note

@enduml
