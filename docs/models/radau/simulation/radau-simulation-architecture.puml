@startdot
digraph architecture {
  graph [rankdir=TB, bgcolor="#f8fafc"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans"];
  recipe [label="Numerical scheme\nSciPy adaptive Radau IIA stages", fillcolor="#fff0d9"];
  method [label="Radau\nExports: simulation / methods\nAdaptive tolerances and step bounds", fillcolor="#e5ecfa"];
  driver [label="Simulation + execution\nBind f / derivatives and observer functions\nAccepted intervals, samples and collection", fillcolor="#e5ecfa"];
  state [label="Physical state\nInitialConditions: values and layout\nNo formulation or auxiliary coordinates", fillcolor="#e5ecfa"];
  advance [label="Physical advance\nEvaluate injected f and optional derivatives\nReturn Z, work and optional quadrature", fillcolor="#e5ecfa"];
  energy [label="EnergyObserver\nOwn momentum; consume accepted quadrature\nBind H and -partial_t H through execution", fillcolor="#e1f0e6"];
  observe [label="Step callbacks\nPassed through simulate(observers=...)\nExecution supplies physical provenance", fillcolor="#f0e5f5"];
  projection [label="Adaptive step\nOne retained SciPy numerical session", fillcolor="#e1f0e6"];
  solver [label="SciPy adaptive control\nMethod owns atol / rtol and step bounds\nPhysical-only error and acceptance", fillcolor="#fff0d9"];
  placement [label="Method identity\nLive physical solver and dense output", fillcolor="#fff0d9"];
  compose [label="Physical evaluations\nPhysical vector-field and optional derivative calls\nNo Hamiltonian or momentum evaluation", fillcolor="#e1f0e6"];
  tangent [label="Sampling\nAccepted dense output", fillcolor="#e1f0e6"];
  maps [label="Accepted numerical data\nDense interpolant for passive quadrature", fillcolor="#e1f0e6"];
  dynamics [label="Injected physical functions\nf(t, Z) and optional Jacobian\nMethod and maps retain no dynamics object", fillcolor="#e5ecfa"];
  recipe -> method;
  method -> driver;
  driver -> advance;
  state -> advance;
  advance -> projection;
  driver -> energy;
  advance -> energy;
  advance -> observe;
  projection -> compose;
  projection -> solver;
  compose -> tangent;
  compose -> maps;
  maps -> dynamics;
}
@enddot
