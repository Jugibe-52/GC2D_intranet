@startdot
digraph architecture {
  graph [rankdir=TB, bgcolor="#f8fafc"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans"];
  recipe [label="Composition recipe\nTwelve alternating signed stages\nOptional harmonic coupling", fillcolor="#fff0d9"];
  method [label="BM4Midpoint\nExports: simulation / methods.extended\nClasses: extended/abba.py and bm4.py", fillcolor="#e5ecfa"];
  driver [label="Simulation + integration\nsrc/simulation/runner.py and src/integration/\nMain steps, output sampling, collection", fillcolor="#e5ecfa"];
  state [label="DoubledFormulation\nsrc/formulations/state.py\nTwo copies; optional time and kappa", fillcolor="#e5ecfa"];
  advance [label="advance\nBound recipe and projection configuration\nOne accepted numerical result", fillcolor="#e5ecfa"];
  energy [label="Passive energy and outputs\ncore/energy.py: accepted shear quadrature\nH + kappa; no feedback into the root", fillcolor="#e1f0e6"];
  observe [label="Optional observations\nextended/observations.py: event adapters\nPublic records: contracts/observation.py", fillcolor="#f0e5f5"];
  projection [label="midpoint_step\ncore/midpoint.py\nOne arithmetic diagonal average", fillcolor="#e1f0e6"];
  solver [label="Explicit projection\nAverage the two final copies\nNo Newton / Broyden calls", fillcolor="#fff0d9"];
  placement [label="Method identity\nArithmetic mean after the full cycle\nNo nonlinear solve", fillcolor="#fff0d9"];
  compose [label="compose\ncore/composition.py: signed stage clock\nAccepted trace reused by all consumers", fillcolor="#e1f0e6"];
  tangent [label="Accepted stage trace\nSigned times, durations and shear inputs\nEnergy evaluated after the spatial map", fillcolor="#e1f0e6"];
  maps [label="GCDoubledMaps\ndirect_map / adjoint_map\nSpatial shears and optional coupling", fillcolor="#e1f0e6"];
  dynamics [label="Physical dynamics\nVector field, analytic derivatives, H and partial_t H\nExisting dynamics and potential contracts", fillcolor="#e5ecfa"];
  recipe -> method;
  method -> driver;
  driver -> advance;
  state -> advance;
  advance -> projection;
  advance -> energy;
  advance -> observe;
  projection -> compose;
  projection -> solver;
  compose -> tangent;
  compose -> maps;
  maps -> dynamics;
}
@enddot
