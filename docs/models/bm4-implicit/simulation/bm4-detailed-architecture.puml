@startdot
digraph BM4DetailedArchitecture {
  // Canonical source; render with scripts/render_detailed_architecture.cjs <this-file>.
  // Source columns retain the current package ownership; EXECUTION numbers follow calls.
  graph [rankdir=TB, newrank=true, compound=true, splines=polyline,
    nodesep=0.62, ranksep=0.60, pad=0.35, bgcolor="#FFFFFF",
    fontname="DejaVu Sans", fontsize=25, labelloc=t, labeljust=l,
    label="BM4Implicit | Detailed reduced-projection architecture\n\nCurrent source ownership from potential to Solution. One nonlinear solve surrounds the complete twelve-stage palindromic composition.\nOrange: method configuration. Green: spatial maps, projection and passive energy. Blue: lifecycle and shared records. Purple: opt-in observations.\nN = particle count; m = 2N physical coordinates; q = 4N or 6N accepted internal coordinates; T = saved times. Module paths are repository-relative."];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#C4CFDC",
    penwidth=1.15, margin="0.02,0.02", fontname="DejaVu Sans", fontsize=11];
  edge [color="#64748B", penwidth=1.2, arrowsize=0.75, fontname="DejaVu Sans", fontsize=10];
  subgraph cluster_potential {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="potential"];
    Head_potential [fillcolor="#263D59", color="#263D59", fontcolor="white", width=4.8, height=0.68, margin="0.22,0.16", label="01  potential/\nField data and periodic geometry"];
    Potential [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">PHYSICAL FIELD / PUBLIC CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Potential</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/potential/potential.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Data and construction</B><BR ALIGN="LEFT"/>Grid; spatial mode amplitudes; time dependence.<BR ALIGN="LEFT"/>Construct from data or Potential.random(...).</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>evaluate(t, x, y, dx, dy, dt)<BR ALIGN="LEFT"/>electric_field(t, x, y); gyroaverage(rho)</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Ownership</B><BR ALIGN="LEFT"/>Interpolation and field derivatives live here.<BR ALIGN="LEFT"/>Dynamics consumes the same physical field.</TD></TR>
      </TABLE>
    >];
    H5Loader [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">MEASURED FIELD ADAPTER</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>load_gc2d_h5_potential</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/potential/gc2d_h5.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Input</B><BR ALIGN="LEFT"/>HDF5 field, magnetic field, characteristic length,<BR ALIGN="LEFT"/>source selection and interpolation settings.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Output</B><BR ALIGN="LEFT"/>Potential with attached GC2DH5Metadata.<BR ALIGN="LEFT"/>Normalize measured coordinates and field data.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Reproducibility</B><BR ALIGN="LEFT"/>Study parameters remain explicit at the caller.<BR ALIGN="LEFT"/>Metadata describes the loaded physical source.</TD></TR>
      </TABLE>
    >];
    Grid [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">PERIODIC GEOMETRY / PUBLIC CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Grid</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/potential/grid.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Geometry</B><BR ALIGN="LEFT"/>Periodic spatial axes; shape and spacing.<BR ALIGN="LEFT"/>Grid.periodic(nx, ny, period).</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operation</B><BR ALIGN="LEFT"/>normalize(x, y): wrap coordinates into the cell.<BR ALIGN="LEFT"/>Potential owns interpolation on this grid.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Boundary</B><BR ALIGN="LEFT"/>Physical periodicity is separate from the<BR ALIGN="LEFT"/>integration time grid and output sample grid.</TD></TR>
      </TABLE>
    >];
    Pad_potential_3 [shape=point, width=0, height=0, style=invis];
    Pad_potential_4 [shape=point, width=0, height=0, style=invis];
    Pad_potential_5 [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_dynamics {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="dynamics"];
    Head_dynamics [fillcolor="#263D59", color="#263D59", fontcolor="white", width=4.8, height=0.68, margin="0.22,0.16", label="02  dynamics/\nGuiding-center field and derivatives"];
    Dynamics [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#E8EFF8"><FONT POINT-SIZE="9">PHYSICAL CAPABILITY</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Guiding-center vector field</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/dynamics/protocols.py; gc.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Required spatial data</B><BR ALIGN="LEFT"/>N planar particles; physical size m = 2N.<BR ALIGN="LEFT"/>vector_field(t, z): packed derivative [m].</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Concrete implementation</B><BR ALIGN="LEFT"/>GuidingCenterDynamics(potential, rho=...).<BR ALIGN="LEFT"/>Uses the gyroaveraged potential at radius rho.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Numerical use</B><BR ALIGN="LEFT"/>Both BM4 copies evaluate this same physical field.<BR ALIGN="LEFT"/>Initial geometry is supplied independently.</TD></TR>
      </TABLE>
    >];
    GC [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">CONCRETE PHYSICAL SYSTEM</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GuidingCenterDynamics</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/dynamics/gc.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Construction</B><BR ALIGN="LEFT"/>potential: Potential; rho: normalized gyro-radius.<BR ALIGN="LEFT"/>effective_potential = potential.gyroaverage(rho).</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>vector_field; hamiltonian; momentum derivative.<BR ALIGN="LEFT"/>particle_vector_field_jacobians: [N, 2, 2].</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Coordinates</B><BR ALIGN="LEFT"/>N uncoupled planar particles; m = 2N.<BR ALIGN="LEFT"/>Field uses the gyroaveraged electric potential.</TD></TR>
      </TABLE>
    >];
    Capabilities [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#E8EFF8"><FONT POINT-SIZE="9">OPTIONAL CAPABILITIES</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Hamiltonian / analytic Jacobians</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/dynamics/protocols.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Analytic Newton</B><BR ALIGN="LEFT"/>GuidingCenterJacobianSystem supplies<BR ALIGN="LEFT"/>particle_vector_field_jacobians: [N, 2, 2].</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Passive energy</B><BR ALIGN="LEFT"/>HamiltonianSystem supplies H and -partial_t H.<BR ALIGN="LEFT"/>Required when track_energy=True.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Solver choice</B><BR ALIGN="LEFT"/>Finite-difference Newton and Broyden use<BR ALIGN="LEFT"/>spatial map evaluations without analytic Jacobians.</TD></TR>
      </TABLE>
    >];
    Pad_dynamics_3 [shape=point, width=0, height=0, style=invis];
    Pad_dynamics_4 [shape=point, width=0, height=0, style=invis];
    Pad_dynamics_5 [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_initial {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="initial"];
    Head_initial [fillcolor="#263D59", color="#263D59", fontcolor="white", width=4.8, height=0.68, margin="0.22,0.16", label="03  initial_conditions/\nPhysical input and packed GC layout"];
    Initial [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">BASE INITIAL CONFIGURATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>StateConfiguration</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/base.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>initial_state: finite packed physical vector [m].<BR ALIGN="LEFT"/>layout: matching PackedStateLayout.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Construction</B><BR ALIGN="LEFT"/>set_initial_state validates and copies the vector.<BR ALIGN="LEFT"/>Concrete geometry supplies the physical layout.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Assembly</B><BR ALIGN="LEFT"/>The caller combines this configuration and<BR ALIGN="LEFT"/>dynamics in InitialValueProblem (contracts/).</TD></TR>
      </TABLE>
    >];
    InitialGC [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#E8EFF8"><FONT POINT-SIZE="9">CONCRETE GC CONFIGURATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GCInitialConfiguration</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/gc.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Construction</B><BR ALIGN="LEFT"/>from_components(x=x0, y=y0).<BR ALIGN="LEFT"/>Each component supplies N initial positions.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Packed input</B><BR ALIGN="LEFT"/>z = [x_1,...,x_N, y_1,...,y_N].<BR ALIGN="LEFT"/>GCDoubledMaps requires this GC configuration.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Assembly</B><BR ALIGN="LEFT"/>InitialValueProblem(dynamics, configuration)<BR ALIGN="LEFT"/>validates the initial state and physical dimensions.</TD></TR>
      </TABLE>
    >];
    Layouts [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#E8EFF8"><FONT POINT-SIZE="9">PACKED COORDINATE CONVENTION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GCStateLayout</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/gc.py; base.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>split; pack_components; particle_count.<BR ALIGN="LEFT"/>validate_packed_state_layout.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Internal spatial map</B><BR ALIGN="LEFT"/>(u, v) = [ux, uy, vx, vy] in component-major blocks.<BR ALIGN="LEFT"/>Each block contains all N particle values.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Physical output</B><BR ALIGN="LEFT"/>Solution.states keeps [x, y] only.<BR ALIGN="LEFT"/>The source layout interprets saved trajectories.</TD></TR>
      </TABLE>
    >];
    Pad_initial_3 [shape=point, width=0, height=0, style=invis];
    Pad_initial_4 [shape=point, width=0, height=0, style=invis];
    Pad_initial_5 [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_formulations {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="formulations"];
    Head_formulations [fillcolor="#2E6651", color="#2E6651", fontcolor="white", width=4.8, height=0.68, margin="0.22,0.16", label="04  formulations/\nDoubled state and exact map order"];
    Doubled [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#E2F1E9"><FONT POINT-SIZE="9">ACCEPTED INTERNAL STATE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>DoubledFormulation</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/formulations/state.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Bound inputs</B><BR ALIGN="LEFT"/>problem; initial_time; track_energy.<BR ALIGN="LEFT"/>initial_state duplicates the physical z0.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Size and invariant</B><BR ALIGN="LEFT"/>q = 4N, or 6N with passive time and kappa.<BR ALIGN="LEFT"/>Accepted copies are diagonal; physical size m = 2N.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>physical(state); finish(...); extract_history(...).<BR ALIGN="LEFT"/>Time and kappa never enter the nonlinear root.</TD></TR>
      </TABLE>
    >];
    Maps [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#E2F1E9"><FONT POINT-SIZE="9">PER-RUN SPATIAL MAPS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GCDoubledMaps</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/formulations/gc.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Construction</B><BR ALIGN="LEFT"/>GCDoubledMaps(problem, coupling_frequency).<BR ALIGN="LEFT"/>BM4 binds spatial maps without internal energy variables.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>direct_map(delta, tau, (u,v))<BR ALIGN="LEFT"/>adjoint_map(delta, tau, (u,v))</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Coupling</B><BR ALIGN="LEFT"/>Exact harmonic mixing C_delta uses angle 2*w*delta.<BR ALIGN="LEFT"/>w = 0 gives identity coupling.<BR ALIGN="LEFT"/>Signed durations are preserved.</TD></TR>
      </TABLE>
    >];
    Direct [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#E2F1E9"><FONT POINT-SIZE="9">ONE DIRECT STAGE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>direct_map</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/formulations/gc.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Two shears at evaluation time tau</B><BR ALIGN="LEFT"/>v1 = v + delta * f(tau, u)<BR ALIGN="LEFT"/>u1 = u + delta * f(tau, v1)</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Coupling last</B><BR ALIGN="LEFT"/>(u_out, v_out) = C_delta(u1, v1).<BR ALIGN="LEFT"/>Direct stages evaluate at the signed stage endpoint.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Retained sources</B><BR ALIGN="LEFT"/>(tau, delta, u) and (tau, delta, v1).<BR ALIGN="LEFT"/>Reuse for exact tangents and passive quadrature.</TD></TR>
      </TABLE>
    >];
    Adjoint [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#E2F1E9"><FONT POINT-SIZE="9">ONE ADJOINT STAGE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>adjoint_map</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/formulations/gc.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Coupling first</B><BR ALIGN="LEFT"/>(u0, v0) = C_delta(u, v).<BR ALIGN="LEFT"/>Adjoint stages evaluate at the signed stage start.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Two shears at evaluation time tau</B><BR ALIGN="LEFT"/>u1 = u0 + delta * f(tau, v0)<BR ALIGN="LEFT"/>v1 = v0 + delta * f(tau, u1)</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Retained sources</B><BR ALIGN="LEFT"/>(tau, delta, v0) and (tau, delta, u1).<BR ALIGN="LEFT"/>No diagonal projection between the twelve stages.</TD></TR>
      </TABLE>
    >];
    StateFinish [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#E2F1E9"><FONT POINT-SIZE="9">ACCEPTED STATE AND OUTPUT</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>finish / extract_history</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/formulations/state.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>After the converged spatial step</B><BR ALIGN="LEFT"/>finish embeds z_next into both accepted copies.<BR ALIGN="LEFT"/>Append t+h and updated kappa when tracking.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>At requested saved times</B><BR ALIGN="LEFT"/>extract_history returns physical states [2N,T].<BR ALIGN="LEFT"/>Auxiliary values are separate diagnostic arrays.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Energy normalization</B><BR ALIGN="LEFT"/>Physical momentum kappa; generalized energy H+kappa.<BR ALIGN="LEFT"/>The doubled momentum convention is k=2*kappa.</TD></TR>
      </TABLE>
    >];
    Pad_formulations_5 [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_methods {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="methods"];
    Head_methods [fillcolor="#815E22", color="#815E22", fontcolor="white", width=4.8, height=0.68, margin="0.22,0.16", label="05  methods/extended/\nOne reduced solve around twelve stages"];
    Config [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#FBE0C7"><FONT POINT-SIZE="9">REUSABLE PUBLIC CONFIGURATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>BM4Implicit</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/methods/extended/bm4.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Default spatial / solver options</B><BR ALIGN="LEFT"/>coupling_frequency = 0.0.<BR ALIGN="LEFT"/>nonlinear_solver = newton; Jacobian = analytic.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Convergence defaults</B><BR ALIGN="LEFT"/>atol = 1e-13; rtol = 1e-12; max corrections = 12.<BR ALIGN="LEFT"/>FD relative step = cube root of machine epsilon.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Optional controls</B><BR ALIGN="LEFT"/>track_energy=False; progress=False; step_observer=None.<BR ALIGN="LEFT"/>Constructor validates numerical and solver choices.</TD></TR>
      </TABLE>
    >];
    Initialize [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#FBE0C7"><FONT POINT-SIZE="9">EXECUTION 3 / PER-RUN PREPARATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>BM4Implicit.initialize</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/methods/extended/bm4.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>State and maps</B><BR ALIGN="LEFT"/>Construct DoubledFormulation and GCDoubledMaps.<BR ALIGN="LEFT"/>Bind SolverOptions and the shared BM4 recipe.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Bound callable</B><BR ALIGN="LEFT"/>self.project = partial(solve_projection, maps, BM4,<BR ALIGN="LEFT"/>options, reduced_multiplier, Jacobian options).</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Metadata</B><BR ALIGN="LEFT"/>One nonlinear solve per accepted main step.<BR ALIGN="LEFT"/>Root size 2N; formulation bm4_implicit_reduced.</TD></TR>
      </TABLE>
    >];
    Advance [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#FBE0C7"><FONT POINT-SIZE="9">EXECUTION 6 / COMPLETE NUMERICAL STEP</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>BM4Implicit.advance(t, state, h)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/methods/extended/bm4.py</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Spatial solve</B><BR ALIGN="LEFT"/>z = state_formulation.physical(state).<BR ALIGN="LEFT"/>result = self.project(t, z, h).</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Accepted auxiliary update</B><BR ALIGN="LEFT"/>Optionally evaluate momentum_increment.<BR ALIGN="LEFT"/>finish(state, result.state, t+h, increment).</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Return</B><BR ALIGN="LEFT"/>contracts.step.StepResult(after, statistics, result).<BR ALIGN="LEFT"/>No collection or observer dispatch inside advance.</TD></TR>
      </TABLE>
    >];
    EngineEntry [label=<
      <TABLE WIDTH="350" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT" BGCOLOR="#E2F1E9"><FONT POINT-SIZE="9">SHARED BM4 / ABBA ENGINE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Reduced BM4 numerical engine</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/methods/extended/core/</FONT></TD></TR>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Main path</B><BR ALIGN="LEFT"/>advance -&gt; solve_projection -&gt; compose.<BR ALIGN="LEFT"/>The projection encloses all twelve signed map stages.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Shared implementation</B><BR ALIGN="LEFT"/>Newton/Broyden; analytic/FD tangents; passive energy.<BR ALIGN="LEFT"/>Accepted CompositionTrace is reused by consumers.</TD></TR><HR/>
        <TR><TD WIDTH="350" BALIGN="LEFT" ALIGN="LEFT"><B>Detailed equations</B><BR ALIGN="LEFT"/>See the six numerical cards below the source columns.<BR ALIGN="LEFT"/>BM4Implicit always selects the reduced multiplier root.</TD></TR>
      </TABLE>
    >];
    Pad_methods_4 [shape=point, width=0, height=0, style=invis];
