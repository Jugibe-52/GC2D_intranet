@startdot
digraph BM4ImplicitFullExecution {
  // Implemented BM4Implicit lifecycle, using the ABBA4 diagram's six-phase layout.
  // Read numbered phase headers horizontally and each phase vertically.
  // Cards distinguish actual types/functions from inline work and numerical details.
  // Preparation and execution show two parts of the same integration coordinator.
  // Cross-cluster edges follow the nodes to preserve cluster ownership.
  graph [
    rankdir=TB, newrank=true, compound=true, splines=line,
    nodesep=0.80, ranksep=0.56, pad=0.30,
    bgcolor="#FFFFFF", fontname="DejaVu Sans", fontsize=23,
    labelloc="t", labeljust="l",
    label="BM4Implicit | Complete physical Hairer-projection execution\n\nHorizontal: complete lifecycle. Vertical: preparation, numerical solve and accepted-step records.\nBlue: public contracts and shared infrastructure. Orange: BM4 method. Green: numerical kernels. Purple: optional observation.\nOne reduced projection surrounds each complete twelve-stage cycle. N = particles; T = saved times; m = 2N.\nModule paths are relative to src/simulation/methods/bm4/ unless stated otherwise."
  ];
  node [
    shape=box, style="rounded,filled", fillcolor="#FFFFFF",
    color="#C4CFDC", penwidth=1.15, margin="0.02,0.02",
    fontname="DejaVu Sans", fontsize=11
  ];
  edge [
    color="#64748B", penwidth=1.15, arrowsize=0.72,
    arrowhead=normal, arrowtail=none, dir=forward,
    fontname="DejaVu Sans", fontsize=10
  ];

  subgraph cluster_physics {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="physics"];
    PhasePhysics [fillcolor="#263D59", color="#263D59", fontcolor="white", margin="0.22,0.16", label="01  PHYSICS AND INITIAL STATE\nDefine the reproducible physical inputs"];

    Potential [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Potential</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/potential/potential.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>interpolation_order: int<BR ALIGN="LEFT"/>metadata: field provenance</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>evaluate(t, x, y, derivatives): array<BR ALIGN="LEFT"/>electric_field(t, x, y): (Ex, Ey)<BR ALIGN="LEFT"/>gyroaverage(rho): Potential</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Load with load_gc2d_h5_potential(...),<BR ALIGN="LEFT"/>or construct with Potential.random(...).<BR ALIGN="LEFT"/>Keep normalization and seed explicit.</TD></TR>
      </TABLE>
    >];
    Dynamics [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CLASS / PHYSICAL FIELD</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GuidingCenterDynamics</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/dynamics/gc.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>potential, effective_potential: Potential<BR ALIGN="LEFT"/>rho: float; state_dimension = 2</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>vector_field(t, z): array[2N]<BR ALIGN="LEFT"/>particle_vector_field_jacobians(t, z)<BR ALIGN="LEFT"/>hamiltonian(t, z): array[N]</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The field determines physical velocities.<BR ALIGN="LEFT"/>Analytic Newton corrections require this class<BR ALIGN="LEFT"/>and effective interpolation_order &gt;= 3.<BR ALIGN="LEFT"/>Energy can be evaluated by downstream analysis.</TD></TR>
      </TABLE>
    >];
    Initial [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GCInitialConfiguration</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/gc.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>initial_state: array[2N]<BR ALIGN="LEFT"/>layout: GCStateLayout</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>from_components(x, y): configuration<BR ALIGN="LEFT"/>initial_state: independent state copy</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Inherits StateConfiguration.<BR ALIGN="LEFT"/>Supplies geometry; physical parameters<BR ALIGN="LEFT"/>remain in the dynamics.</TD></TR>
      </TABLE>
    >];
    Layout [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CLASS / STATE CONTRACT</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GCStateLayout</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/gc.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Convention</B><BR ALIGN="LEFT"/>z = [x1, ..., xN, y1, ..., yN]<BR ALIGN="LEFT"/>state_dimension = 2</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>validate_packed_state_layout(z)<BR ALIGN="LEFT"/>split(z): GCState(x, y)<BR ALIGN="LEFT"/>particle_count(z): N<BR ALIGN="LEFT"/>positions(z): (x, y)</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Inherits PackedStateLayout.<BR ALIGN="LEFT"/>Also interprets saved histories [2N, T].</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_definition {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="definition"];
    PhaseDefinition [fillcolor="#263D59", color="#263D59", fontcolor="white", margin="0.22,0.16", label="02  RUN DEFINITION\nAssemble problem, time request and method"];

    Problem [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING FROZEN RECORD</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>InitialValueProblem</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/problem.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>dynamics: DynamicalSystem<BR ALIGN="LEFT"/>initial_configuration: InitialConfiguration</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>__post_init__(): validate compatibility<BR ALIGN="LEFT"/>initial_state: array[2N]<BR ALIGN="LEFT"/>particle_count: int</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Require a finite initial state and<BR ALIGN="LEFT"/>matching dynamics/layout dimensions.</TD></TR>
      </TABLE>
    >];
    Request [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING FROZEN RECORD</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>SimulationRequest</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/request.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>t_span: (t0, tf)<BR ALIGN="LEFT"/>max_step: float<BR ALIGN="LEFT"/>output_times: read-only array[T]</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>uniform(t_span, max_step, sample_count)<BR ALIGN="LEFT"/>__post_init__(): validate time request</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Increasing times include both endpoints.<BR ALIGN="LEFT"/>The saved grid need not equal the step grid.</TD></TR>
      </TABLE>
    >];
    Method [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#FBE0C7" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING PUBLIC CLASS / BM4 CONFIGURATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>BM4Implicit</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Configuration</B><BR ALIGN="LEFT"/>coupling_frequency; nonlinear_solver<BR ALIGN="LEFT"/>newton_absolute_tolerance<BR ALIGN="LEFT"/>newton_relative_tolerance; newton_max_iterations<BR ALIGN="LEFT"/>newton_jacobian_method<BR ALIGN="LEFT"/>newton_jacobian_relative_step<BR ALIGN="LEFT"/>progress; step_observer</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Public operation</B><BR ALIGN="LEFT"/>integrate(problem, request): IntegrationData</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Frozen dataclass; validates controls at construction.<BR ALIGN="LEFT"/>Implements NumericalMethod structurally.<BR ALIGN="LEFT"/>Delegates to _integrate_implicit_bm4(...).</TD></TR>
      </TABLE>
    >];
    Configuration [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#FBE0C7" ALIGN="LEFT"><FONT POINT-SIZE="9">FIXED NUMERICAL CONSTRUCTION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>One physical BM4 method</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">Accepted state: z in R^m, m = 2N.<BR ALIGN="LEFT"/>Temporary coupled copies: (u, v) in R^(2m).<BR ALIGN="LEFT"/>Reduced multiplier: mu in R^m.<BR ALIGN="LEFT"/>One symmetric Hairer projection per full cycle.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Newton: analytic or finite-difference Jacobian.<BR ALIGN="LEFT"/>Broyden: residual-only secant updates.<BR ALIGN="LEFT"/>All solve the same reduced equation.</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_preparation {
    label=""; style="rounded,filled"; color="#C4D0F1"; fillcolor="#F8FAFF";
    node [group="preparation"];
    PhasePreparation [fillcolor="#354D89", color="#354D89", fontcolor="white", margin="0.22,0.16", label="03  ENTRY AND PREPARATION\nValidate inputs and prepare coupled physical maps"];

    Runner [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CLASS / PUBLIC FACADE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>SimulationRunner</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/runner.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Entry</B><BR ALIGN="LEFT"/>simulate(problem, method, request): Solution<BR ALIGN="LEFT"/>The public simulate(...) function delegates here.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Before integration</B><BR ALIGN="LEFT"/>Validate the three public input contracts.<BR ALIGN="LEFT"/>Call method.integrate(problem, request).</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The same call resumes in phase 06<BR ALIGN="LEFT"/>after IntegrationData is returned.</TD></TR>
      </TABLE>
    >];
    Prepare [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">PREPARATION INSIDE THE BM4 COORDINATOR</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GCExtendedFormulation.prepare</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/formulations/gc.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> problem, coupling_frequency<BR ALIGN="LEFT"/><B>OUT</B> prepared coupled physical maps</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Called once by _integrate_implicit_bm4(...).<BR ALIGN="LEFT"/>Set track_energy=False.<BR ALIGN="LEFT"/>Require GCInitialConfiguration and DynamicalSystem.<BR ALIGN="LEFT"/>Bind dynamics, layout, particle count and frequency.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Initialize the two physical copies (z0, z0).<BR ALIGN="LEFT"/>The scheduler itself starts from physical z0.<BR ALIGN="LEFT"/>Time is passed separately to each map.</TD></TR>
      </TABLE>
    >];
    Prepared [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING PREPARED IMPLEMENTATION / CONTRACT</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>_PreparedGC</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/formulations/gc.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Contract</B> PreparedDirectAdjointFormulation<BR ALIGN="LEFT"/>Declared in src/simulation/formulations/base.py.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>State used by BM4</B><BR ALIGN="LEFT"/>dynamics; configuration; dynamics_name<BR ALIGN="LEFT"/>particle_count; physical_size = m<BR ALIGN="LEFT"/>coupling_frequency; track_energy = False<BR ALIGN="LEFT"/>initial_internal_state: array[2m]</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Bound operations</B><BR ALIGN="LEFT"/>direct_map(duration, t, copies): array[2m]<BR ALIGN="LEFT"/>adjoint_map(duration, t, copies): array[2m]<BR ALIGN="LEFT"/>The BM4 composition consumes these maps.</TD></TR>
      </TABLE>
    >];
    StateSpace [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">STATE DIMENSIONS / NUMERICAL CONTRACT</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Physical and internal states</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">BM4 state flow</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Public and scheduler state</B><BR ALIGN="LEFT"/>z = [x1, ..., xN, y1, ..., yN] in R^m.<BR ALIGN="LEFT"/>Physical history has shape [m, T].</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Temporary doubled workspace</B><BR ALIGN="LEFT"/>Y = (u, v) in R^(2m), used inside one solve.<BR ALIGN="LEFT"/>Each solve starts from (z + mu, z - mu).<BR ALIGN="LEFT"/>Only the accepted physical state persists.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">This doubling contains physical coordinates only.<BR ALIGN="LEFT"/>Time and conjugate momentum are not state blocks.<BR ALIGN="LEFT"/>These dimensions apply to maps and result records.</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_execution {
    label=""; style="rounded,filled"; color="#DECBA3"; fillcolor="#FFFCF5";
    node [group="execution"];
    PhaseExecution [fillcolor="#815E22", color="#815E22", fontcolor="white", margin="0.22,0.16", label="04  INTEGRATION AND NONLINEAR SOLVE\nDescend into one complete numerical advance"];
    HistoryExit [shape=point, width=0, height=0, style=invis];

    Runtime [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">BM4 COORDINATOR / CONTINUED AFTER PREPARATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>_integrate_implicit_bm4(...)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> method, problem, request<BR ALIGN="LEFT"/><B>OUT</B> IntegrationData</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Prepare the maps once (phase 03).<BR ALIGN="LEFT"/>Create metric lists and the advance closure.<BR ALIGN="LEFT"/>Call integrate_fixed_grid with physical z0.<BR ALIGN="LEFT"/>Finalize physical history and diagnostic arrays.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The same call owns preparation, stepping,<BR ALIGN="LEFT"/>main-step metrics and optional observations.</TD></TR>
      </TABLE>
    >];
    Grid [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING FUNCTION / OUTER TIME LOOP</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>integrate_fixed_grid(...)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/_fixed.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> initial workspace, request, advance<BR ALIGN="LEFT"/><B>OUT</B> sampled history, main-step count</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Choose uniform h &lt;= max_step.<BR ALIGN="LEFT"/>Run complete main steps up to tf.<BR ALIGN="LEFT"/>For off-grid output, make a shadow advance<BR ALIGN="LEFT"/>from the preceding main-grid state.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Shadow advances change neither the main<BR ALIGN="LEFT"/>trajectory nor main-step metrics/events.</TD></TR>
      </TABLE>
    >];
    Advance [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">BM4 PER-ADVANCE CLOSURE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>advance(...)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py / _integrate_implicit_bm4</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> t, physical state, h, step_index, observe<BR ALIGN="LEFT"/><B>OUT</B> accepted physical state for the scheduler</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Call _solve_reduced_projected_bm4_step(...).<BR ALIGN="LEFT"/>Receive one _ProjectedBM4Step.<BR ALIGN="LEFT"/>When observe=True, append metrics and optionally<BR ALIGN="LEFT"/>reconstruct the accepted cycle for the observer.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Return result.state on main and shadow advances.<BR ALIGN="LEFT"/>A shadow solve returns a sample; its work is<BR ALIGN="LEFT"/>excluded from main-step metrics and events.</TD></TR>
      </TABLE>
    >];
    StepRecipe [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#FBE0C7" ALIGN="LEFT"><FONT POINT-SIZE="9">BM4 COMPLETE-STEP RECIPE / NUMERICAL DETAIL</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>One projected twelve-stage cycle</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">_core.py / implicit.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Base coefficients</B><BR ALIGN="LEFT"/>_BM4_STAGES = (a1, ..., a6, a6, ..., a1).<BR ALIGN="LEFT"/>Sum = 1; a4 &lt; 0 occurs twice.<BR ALIGN="LEFT"/>Alternate adjoint, direct, ..., adjoint, direct.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>One complete physical step</B><BR ALIGN="LEFT"/>Solve one multiplier around the full composition.<BR ALIGN="LEFT"/>Use signed duration b_i h for every stage.<BR ALIGN="LEFT"/>Carry the signed composition clock forward.<BR ALIGN="LEFT"/>There is no projection between the twelve maps.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The stage maps are explicit sequential updates.<BR ALIGN="LEFT"/>The outer multiplier equation makes BM4 implicit.</TD></TR>
      </TABLE>
    >];
    Projection [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E3F0E9" ALIGN="LEFT"><FONT POINT-SIZE="9">BM4 REDUCED HAIRER SOLVE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>_solve_reduced_projected_<BR/>bm4_step(...)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> prepared maps, t, z, h, solver controls<BR ALIGN="LEFT"/><B>OUT</B> _ProjectedBM4Step</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Unknown</B> mu in R^m; initial guess mu = 0.<BR ALIGN="LEFT"/>Input copies: Y_hat = (z + mu, z - mu).<BR ALIGN="LEFT"/>Mapped copies: (u, v) = Psi(t, h, Y_hat).<BR ALIGN="LEFT"/>Residual: r(mu) = u - v + 2 mu.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>After convergence</B><BR ALIGN="LEFT"/>Correct both outputs: (u + mu, v - mu).<BR ALIGN="LEFT"/>Return their mean as the accepted physical state.<BR ALIGN="LEFT"/>The same mu shifts input and output copies.</TD></TR>
      </TABLE>
    >];
    Nonlinear [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E3F0E9" ALIGN="LEFT"><FONT POINT-SIZE="9">BM4 NEWTON LOOP / SHARED BROYDEN SERVICE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Nonlinear solve</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py / src/simulation/methods/_nonlinear.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Stop when</B> ||r||_inf &lt;= atol + rtol max(1, ||z||_inf).<BR ALIGN="LEFT"/>Count corrections and residual evaluations.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Newton:</B> local loop in the reduced BM4 solve.<BR ALIGN="LEFT"/>G = [I, -I]; J = D Psi; K = G J G^T + 2I.<BR ALIGN="LEFT"/>Solve K delta = r; update mu = mu - delta.<BR ALIGN="LEFT"/>J uses exact stage products or centered differences.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Broyden:</B> call shared _solve_broyden(...).<BR ALIGN="LEFT"/>Start the reduced Jacobian approximation at 4I.<BR ALIGN="LEFT"/>Update it from secants using residuals only.<BR ALIGN="LEFT"/>Reuse the converged mapped-copy payload.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">An unconverged or singular solve raises an error.<BR ALIGN="LEFT"/>A zero-correction solve still evaluates a residual.</TD></TR>
      </TABLE>
    >];
    Maps [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E3F0E9" ALIGN="LEFT"><FONT POINT-SIZE="9">BM4 COMPLETE-MAP AND TANGENT KERNELS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Base cycle and Jacobian</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py / _core.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Residual evaluation</B><BR ALIGN="LEFT"/>_bm4_evaluation(...) displaces the input copies.<BR ALIGN="LEFT"/>_bm4_map(...) calls _advance_composition(...).<BR ALIGN="LEFT"/>Evaluate all twelve stages with events disabled.<BR ALIGN="LEFT"/>Return mapped copies with shape [2m].</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Newton correction only</B><BR ALIGN="LEFT"/>_bm4_map_jacobian(...) returns array[2m, 2m].<BR ALIGN="LEFT"/>Analytic: J_total = J12 ... J2 J1,<BR ALIGN="LEFT"/>with particle blocks and exact coupling derivatives.<BR ALIGN="LEFT"/>Finite difference: differentiate the complete map.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Broyden does not request map Jacobians.<BR ALIGN="LEFT"/>Each analytic factor uses its own stage state/time.</TD></TR>
      </TABLE>
    >];
    Stages [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E3F0E9" ALIGN="LEFT"><FONT POINT-SIZE="9">SHARED GC MAPS / BM4 SIGNED COMPOSITION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Direct and adjoint stages</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/formulations/gc.py / _core.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">Let d = b_i h; tau = current composition clock.<BR ALIGN="LEFT"/>f is the physical vector field.<BR ALIGN="LEFT"/>C_d is the exact harmonic coupling of both copies.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Adjoint (odd stages), evaluated at tau</B><BR ALIGN="LEFT"/>(u, v) = C_d(u, v)<BR ALIGN="LEFT"/>u = u + d f(tau, v)<BR ALIGN="LEFT"/>v = v + d f(tau, u)</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Direct (even stages), evaluated at tau + d</B><BR ALIGN="LEFT"/>v = v + d f(tau + d, u)<BR ALIGN="LEFT"/>u = u + d f(tau + d, v)<BR ALIGN="LEFT"/>(u, v) = C_d(u, v)</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">After either map: tau = tau + d.<BR ALIGN="LEFT"/>Negative durations also move the clock backward.<BR ALIGN="LEFT"/>All twelve signed durations sum to h.</TD></TR>
      </TABLE>
    >];

  }

  subgraph cluster_records {
    label=""; style="rounded,filled"; color="#D5CDE9"; fillcolor="#FCFAFF";
    node [group="records"];
    PhaseRecords [fillcolor="#654780", color="#654780", fontcolor="white", margin="0.22,0.16", label="05  ACCEPTED STEPS AND DIAGNOSTICS\nRecord basic metrics and optional observations"];
    ObservationStart [group="observer_route", shape=point, width=0, height=0, style=invis];
    ObservationEnd [group="observer_route", shape=point, width=0, height=0, style=invis];
    FinalPhaseLink [group="observer_route", shape=point, width=0, height=0, style=invis];
    MetricsLink [group="observer_route", shape=point, width=0, height=0, style=invis];
    FailurePass [shape=point, width=0, height=0, style=invis];

    Recording [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">INLINE MAIN-STEP RECORDING</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Append accepted-step metrics</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py / advance(...), when observe=True</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> _ProjectedBM4Step and state_before<BR ALIGN="LEFT"/><B>OUT</B> one row per accepted main step</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Append iterations, residual_evaluations,<BR ALIGN="LEFT"/>residual_norm, the effective tolerance,<BR ALIGN="LEFT"/>and ||multiplier||_inf.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Each row describes one complete BM4 solve.<BR ALIGN="LEFT"/>Recording runs even without a step_observer.<BR ALIGN="LEFT"/>Shadow advances bypass these lists.</TD></TR>
      </TABLE>
    >];
    ProjectedStep [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING FROZEN RECORD / ONE ACCEPTED SOLVE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>_ProjectedBM4Step</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>state: array[m], accepted physical coordinates<BR ALIGN="LEFT"/>multiplier: array[m]<BR ALIGN="LEFT"/>internal_input: array[2m]<BR ALIGN="LEFT"/>mapped: array[2m]</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Nonlinear work</B><BR ALIGN="LEFT"/>iterations: int<BR ALIGN="LEFT"/>residual_evaluations: int<BR ALIGN="LEFT"/>residual_norm: float</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">advance(...) returns state to the scheduler.<BR ALIGN="LEFT"/>Recording reads the counters and multiplier.<BR ALIGN="LEFT"/>Observation reads the stored converged copies.</TD></TR>
      </TABLE>
    >];
    Snapshots [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">ARRAY FIELDS / CONVERGED BASE-CYCLE DATA</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Converged doubled snapshots</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">_ProjectedBM4Step.internal_input / mapped</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>internal_input</B> = (z + mu, z - mu).<BR ALIGN="LEFT"/><B>mapped</B> = Psi(t, h, internal_input).<BR ALIGN="LEFT"/>Both contain two physical copies in R^(2m).</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Retained from the converged residual evaluation.<BR ALIGN="LEFT"/>The observer replays from internal_input and<BR ALIGN="LEFT"/>checks exact equality with mapped.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The copies support observation of the base cycle.<BR ALIGN="LEFT"/>The next main step starts from result.state.</TD></TR>
      </TABLE>
    >];
    DiagnosticFields [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">FINAL DIAGNOSTIC FIELDS / MAIN-STEP ARRAYS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Nonlinear and projection metrics</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py / diagnostics dictionary</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">step_count; nonlinear_solver<BR ALIGN="LEFT"/>nonlinear_iterations; residual_evaluations<BR ALIGN="LEFT"/>nonlinear_residual_norms; nonlinear_tolerances<BR ALIGN="LEFT"/>projection_multiplier_norms</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Persist tolerance and correction-limit controls,<BR ALIGN="LEFT"/>Jacobian strategy, finite-difference relative step,<BR ALIGN="LEFT"/>and coupling_frequency.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">projection_solver_formulation =<BR ALIGN="LEFT"/>"bm4_implicit_reduced".<BR ALIGN="LEFT"/>Retain the existing newton_* metric aliases.<BR ALIGN="LEFT"/>Arrays index main steps, not requested samples.</TD></TR>
      </TABLE>
    >];
    EventBuilder [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#F0E8FA" ALIGN="LEFT"><FONT POINT-SIZE="9">INLINE OPTIONAL OBSERVER PREPARATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Reconstruct the accepted cycle</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">implicit.py / advance(...), after convergence</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Only if</B> main step AND step_observer installed.<BR ALIGN="LEFT"/>Replay _advance_composition(...) once from<BR ALIGN="LEFT"/>result.internal_input with a stage observer.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Collect twelve IntegrationStage snapshots.<BR ALIGN="LEFT"/>Require array_equal(replayed_output, result.mapped).<BR ALIGN="LEFT"/>Keep the accepted result.state unchanged.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Build ImplicitBM4IntegrationStep and call<BR ALIGN="LEFT"/>step_observer(event).<BR ALIGN="LEFT"/>Its map_state closure solves the complete<BR ALIGN="LEFT"/>projected physical step for a supplied candidate.</TD></TR>
      </TABLE>
    >];
    Events [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#F0E8FA" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING OPTIONAL EVENT CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>ImplicitBM4IntegrationStep</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/observation.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Physical step</B><BR ALIGN="LEFT"/>step_index; start_time; time; duration<BR ALIGN="LEFT"/>state_before / state_after: array[m]<BR ALIGN="LEFT"/>map_state: physical projected-step callable</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Accepted solve</B><BR ALIGN="LEFT"/>nonlinear_solver; residual_evaluations<BR ALIGN="LEFT"/>newton_iterations; newton_residual_norm<BR ALIGN="LEFT"/>newton_tolerance; projection_multiplier_norm<BR ALIGN="LEFT"/>multiplier; coupling_frequency<BR ALIGN="LEFT"/>base_stages: tuple of twelve IntegrationStage records</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Method/dynamics identity and formulation marker<BR ALIGN="LEFT"/>remain available to diagnostics/ observers.</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_output {
    label=""; style="rounded,filled"; color="#C4DDCF"; fillcolor="#F8FCFA";
    node [group="output"];
    PhaseOutput [fillcolor="#2E6651", color="#2E6651", fontcolor="white", margin="0.22,0.16", label="06  FINAL RESULT\nFinalize, validate and interpret the trajectory"];
    HistoryEntry [shape=point, width=0, height=0, style=invis];

    Data [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E2F1E9" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING INTERNAL RECORD</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>IntegrationData</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/_result.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>t: requested times [T]<BR ALIGN="LEFT"/>states: physical history [m, T]<BR ALIGN="LEFT"/>diagnostics: dict[str, DiagnosticValue]</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Created after the scheduler reaches tf.<BR ALIGN="LEFT"/>The history already contains physical coordinates.<BR ALIGN="LEFT"/>Attach accepted-step arrays and solver metadata.<BR ALIGN="LEFT"/>Retain the established diagnostic aliases.</TD></TR>
      </TABLE>
    >];
    Resume [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E2F1E9" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CALL CONTINUATION / SAME RUNNER</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>SimulationRunner resumes</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#537866">src/simulation/runner.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> IntegrationData<BR ALIGN="LEFT"/><B>OUT</B> Solution</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Require exactly the requested output times.<BR ALIGN="LEFT"/>Check shape, finiteness and packed layout.<BR ALIGN="LEFT"/>Verify that the initial state is preserved.<BR ALIGN="LEFT"/>Retain the source initial configuration.</TD></TR>
      </TABLE>
    >];
    Solution [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E2F1E9" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING PUBLIC CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Solution</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#537866">src/simulation/solution.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Read-only public properties</B><BR ALIGN="LEFT"/>t: array[T]<BR ALIGN="LEFT"/>states: array[2N, T]<BR ALIGN="LEFT"/>source: InitialConfiguration<BR ALIGN="LEFT"/>diagnostics: read-only mapping</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Owns copies of trajectory and diagnostic arrays.<BR ALIGN="LEFT"/>Layout and provenance remain available<BR ALIGN="LEFT"/>through the source configuration.</TD></TR>
      </TABLE>
    >];
    Interpret [fillcolor="#F1F8F4", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">OPTIONAL DOWNSTREAM CONSUMERS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Interpret and present</B></FONT></TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>studies/</B> compares and summarizes runs.<BR ALIGN="LEFT"/><B>visualization/</B> builds plots and animations.<BR ALIGN="LEFT"/><B>diagnostics/</B> provides supported persistence.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The calling notebook keeps scientific choices<BR ALIGN="LEFT"/>and interpretation explicit.<BR ALIGN="LEFT"/>These consumers do not advance the solution.</TD></TR>
      </TABLE>
    >];
    Failure [fillcolor="#FFF0F0", color="#D6A5A5", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FAILURE PATH</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Explicit error to caller</B></FONT></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Invalid inputs or incompatible capabilities.<BR ALIGN="LEFT"/>Non-finite evaluations or singular systems.<BR ALIGN="LEFT"/>Nonlinear iteration limit reached.<BR ALIGN="LEFT"/>Invalid final output.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Stop the run; do not construct a successful<BR ALIGN="LEFT"/>Solution from a failed integration.<BR ALIGN="LEFT"/>Retain method, time and solve context.</TD></TR>
      </TABLE>
    >];
  }

  Legend [shape=note, fillcolor="#F8FAFC", color="#CBD5E1", margin="0.18,0.14", label=<
    <B>HOW TO READ THIS DIAGRAM</B><BR/><BR/>
    Thick arrows between phase headers: overall lifecycle; phases 04 and 05 repeat together for each main step.<BR/>
    Thin solid arrows: calls or required data. Dotted blue arrows: returned values. Dashed purple arrows: optional events.<BR/>
    A hollow diamond means a record contains another record. Red dashed arrows indicate failure propagation.<BR/>
    Card subtitles distinguish actual APIs from inline operations and numerical contracts.<BR/><BR/>
    <B>PRESERVED BM4 NUMERICS</B><BR/>
    One accepted physical state in R^m; two temporary copies in R^(2m); one multiplier in R^m.<BR/>
    One reduced Hairer projection surrounds the complete twelve-stage direct/adjoint composition.<BR/>
    The nonlinear solve can evaluate the full base cycle many times before accepting one physical step.<BR/>
    Newton and Broyden solve the same equation. The local Newton loop uses analytic or finite-difference map Jacobians.<BR/>
    Shadow advances and optional cycle reconstruction preserve the main trajectory and its accepted-solve statistics.
  >];

  // A common ordered parent fixes the six columns independently of return arrows.
  ColumnOrder [shape=point, width=0, height=0, style=invis, ordering=out];
  ColumnOrder -> PhasePhysics [style=invis, weight=1000];
  ColumnOrder -> PhaseDefinition [style=invis, weight=1000];
  ColumnOrder -> PhasePreparation [style=invis, weight=1000];
  ColumnOrder -> PhaseExecution [style=invis, weight=1000];
  ColumnOrder -> PhaseRecords [style=invis, weight=1000];
  ColumnOrder -> FinalPhaseLink [style=invis, weight=1000];
  ColumnOrder -> PhaseOutput [style=invis, weight=1000];

  // Global rows combine a horizontal lifecycle with vertically readable columns.
  { rank=same; PhasePhysics; PhaseDefinition; PhasePreparation; PhaseExecution; PhaseRecords; FinalPhaseLink; PhaseOutput; }
  { rank=same; HistoryExit; HistoryEntry; }
  { rank=same; Potential; Problem; Runner; Runtime; Recording; MetricsLink; Data; }
  { rank=same; Dynamics; Request; Prepare; Grid; ProjectedStep; ObservationStart; Resume; }
  { rank=same; Initial; Method; Prepared; Advance; Snapshots; Solution; }
  { rank=same; Layout; Configuration; StateSpace; StepRecipe; DiagnosticFields; Interpret; }
  { rank=same; Projection; EventBuilder; ObservationEnd; }
  { rank=same; FailurePass; Failure; }
  { rank=same; Nonlinear; Events; }

  PhasePhysics -> PhaseDefinition -> PhasePreparation -> PhaseExecution -> PhaseRecords [color="#334155", penwidth=2.4, weight=100];
  PhaseRecords -> FinalPhaseLink [color="#334155", penwidth=2.4, arrowhead=none, weight=100];
  FinalPhaseLink -> PhaseOutput [color="#334155", penwidth=2.4, weight=100];

  // Column guides only. Invisible links carry no execution semantics.
  PhasePhysics -> Potential [style=invis, weight=100];
  PhaseDefinition -> Problem -> Request -> Method -> Configuration [style=invis, weight=100];
  PhasePreparation -> Runner [style=invis, weight=100];
  PhaseExecution -> HistoryExit -> Runtime [style=invis, weight=100];
  PhaseRecords -> Recording -> ProjectedStep -> Snapshots -> DiagnosticFields -> EventBuilder -> Events [style=invis, weight=100];
  PhaseOutput -> HistoryEntry [style=invis, weight=100];
  EventBuilder -> FailurePass -> Events [style=invis, weight=100];
  FinalPhaseLink -> MetricsLink [style=invis, weight=1000];
  Dynamics -> Initial -> Layout [style=invis, weight=100];
  Solution -> Interpret -> Failure [style=invis, weight=100];

  // Inputs and preparation. Cross-column dependencies do not alter phase order.
  Potential -> Dynamics [label="gyroaverage(rho)", weight=100];
  Dynamics -> Problem [constraint=false, xlabel="equations"];
  Initial -> Problem [constraint=false, xlabel="initial state\nand layout"];
  Layout -> Initial [constraint=false, arrowhead=odiamond];
  Problem -> Runner [constraint=false, xlabel="problem"];
  Request -> Runner [constraint=false, xlabel="request"];
  Method -> Runner [constraint=false, xlabel="method"];
  Runner -> Prepare [label="BM4Implicit.integrate\nstarts coordinator", weight=100];
  Prepare -> Prepared [color="#4676A7", style=dotted, label="prepared maps", weight=100];
  Prepared -> StateSpace [style=invis, weight=100];

  Prepared -> Runtime [constraint=false, xlabel="prepared\nphysical maps"];

  // Normal execution descends into the selected complete step and its solver.
  Runtime -> Grid [label="start main time loop", weight=100];
  Grid -> Advance [label="main advance or\nshadow sample", weight=100];
  Advance -> StepRecipe [label="one complete projected step", weight=100];
  StepRecipe -> Projection [label="reduced multiplier solve", weight=100];
  Projection -> Nonlinear [label="selected solver branch", weight=100];
  Nonlinear -> Maps [label="evaluate full-cycle residual\nand Newton tangent when needed", weight=100];
  Nonlinear -> Nonlinear [constraint=false, color="#4676A7", style=dotted, label="correct unknown\nand repeat"];


  // One returned BM4 record supplies the scheduler, metrics and optional events.
  Advance:ne -> ProjectedStep:sw [constraint=false, color="#4676A7", style=dotted, xlabel="converged record"];
  Snapshots -> ProjectedStep [constraint=false, arrowhead=odiamond, xlabel="array fields"];
  Grid -> ProjectedStep [constraint=false, color="#4676A7", style=dotted, dir=back, arrowhead=none, arrowtail=normal, xlabel="physical state"];
  ProjectedStep -> Recording [constraint=false, xlabel="main step only"];
  ProjectedStep -> ObservationStart [color="#9369B1", style=dashed, arrowhead=none, weight=100];
  ObservationStart -> ObservationEnd [color="#9369B1", style=dashed, arrowhead=none, xlabel="main step + observer", weight=1000];
  ObservationEnd -> EventBuilder [color="#9369B1", style=dashed, constraint=false];
  EventBuilder -> Events [color="#9369B1", style=dashed, xlabel="emit event", weight=1000];

  // Completion re-enters the same public runner before exposing Solution.
  Runtime -> HistoryExit [constraint=false, color="#4676A7", style=dotted, arrowhead=none, xlabel="after tf"];
  HistoryExit -> HistoryEntry [color="#4676A7", style=dotted, arrowhead=none, xlabel="runtime finalizes physical history", weight=20];
  HistoryEntry -> Data [color="#4676A7", style=dotted, weight=100];
  Recording -> MetricsLink [color="#4676A7", style=dotted, arrowhead=none, weight=100];
  MetricsLink -> Data [color="#4676A7", style=dotted, xlabel="final diagnostic\narrays", weight=100];
  Data -> Resume [label="return from method.integrate", weight=100];
  Resume -> Solution [label="validate and construct", weight=100];
  Solution -> Interpret [constraint=false, color="#60896D", style=dashed, xlabel="optional analysis / presentation"];
  Nonlinear -> FailurePass [constraint=false, color="#B96969", style=dashed, arrowhead=none];
  FailurePass -> Failure [constraint=false, color="#B96969", style=dashed, xlabel="failure: propagate error"];

  Maps -> Stages [label="twelve prepared stage maps", weight=100];
  Stages -> Legend [style=invis];
  Failure -> Legend [style=invis];
}
@enddot
