@startuml
title Classical RK4 dynamical-system capability contract

skinparam componentStyle rectangle

interface DynamicalSystem {
  +state_dimension
  +vector_field(t, state)
}

interface HamiltonianSystem {
  +hamiltonian(t, state)
}

interface ExtendedHamiltonianSystem {
  +extended_momentum_derivative(t, state)
}

interface StateLayout {
  +state_dimension
  +validate_packed_state_layout(state)
  +particle_count(state)
}

class InitialValueProblem
class RK4 {
  +track_energy
  +integrate(problem, request)
}
class GuidingCenterDynamics
class FullCyclotronDynamics

ExtendedHamiltonianSystem --|> HamiltonianSystem
GuidingCenterDynamics ..|> DynamicalSystem
GuidingCenterDynamics ..|> ExtendedHamiltonianSystem
FullCyclotronDynamics ..|> DynamicalSystem
FullCyclotronDynamics ..|> ExtendedHamiltonianSystem

InitialValueProblem --> DynamicalSystem : physical equations
InitialValueProblem --> StateLayout : validates initial state
RK4 --> InitialValueProblem
RK4 ..> DynamicalSystem : four staged vector-field evaluations
RK4 ..> ExtendedHamiltonianSystem : only when track_energy=true

note right of StateLayout
  The layout owns component packing.
  RK4 treats the state as one vector.
end note

note right of ExtendedHamiltonianSystem
  Internal triangular extension:
  [physical state, k_1, ..., k_N]
  k does not feed back into the physical field.
end note

@enduml
