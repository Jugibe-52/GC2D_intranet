@startuml
title Implicit ABBA 1 Simulation Runtime Path
scale max 4000 width

left to right direction

skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 60
skinparam defaultTextAlignment left
skinparam classAttributeIconSize 0
skinparam wrapWidth 160
skinparam package<<layout>> {
  BorderColor transparent
  BackgroundColor transparent
  FontColor transparent
}

hide circle
hide empty members

package "Inherited boundary" as InheritedBoundary {
  class "src/dynamics/protocols.py" as DynamicalSystem <<protocol>> {
    DynamicalSystem
    --
    state_dimension
    vector_field(t, state)
  }

  class "src/dynamics/protocols.py" as GuidingCenterJacobianSystem <<protocol>> {
    GuidingCenterJacobianSystem
    --
    particle_vector_field_jacobians(...)
  }

  class "src/dynamics/gc.py" as GuidingCenterDynamics <<implementation>> {
    GuidingCenterDynamics
    --
    state_dimension = 2
    vector_field(t, state)
    particle_vector_field_jacobians(...)
  }
}

package "Run assembly" as RunAssembly {
  package " " as MethodSlot <<layout>> {
    class "src/simulation/methods/\nabba_implicit_1.py" as ImplicitABBA1 <<method>> {
      ImplicitABBA1
      --
      Reduced projection formulation
      Solver tolerances and iteration limit
      Newton or Broyden selection
    }

    class "src/simulation/methods/\n_implicit_abba.py" as ImplicitABBABase <<base method>> {
      _ImplicitABBA
      --
      Nonlinear solver configuration
      integrate(problem, request)
    }

    class "src/simulation/methods/base.py" as NumericalMethod <<protocol>> {
      NumericalMethod
      --
      integrate(problem, request)
    }
  }

  package " " as RunnerSlot <<layout>> {
    class "src/simulation/runner.py" as SimulationRunner <<facade>> {
      simulate(problem, method, request)
      --
      Validates public inputs
      Delegates numerical integration
    }
  }

  package " " as RequestSlot <<layout>> {
    class "src/simulation/request.py" as SimulationRequest <<value>> {
      SimulationRequest
      --
      Time span
      Maximum step
      Requested output times
    }
  }

  package "Shared state implementation" as SharedStateImplementation {
    top to bottom direction
    class "src/initial_conditions/base.py" as PackedStateLayout <<shared layout>> {
      PackedStateLayout
      --
      validate / split / particle_count
      as_blocks(...) / from_blocks(...)
      pack_components(...)
    }

    class "src/initial_conditions/base.py" as StateConfiguration <<abstract storage>> {
      StateConfiguration
      --
      initial_state
      abstract layout property
      compatibility forwarding methods
    }
  }

  package "Guiding-center initial state" as GuidingCenterInitialState {
    top to bottom direction
    class "src/initial_conditions/gc.py" as GCStateLayout <<concrete layout>> {
      GCStateLayout
      --
      state_dimension = 2
      split(...) -> GCState
      positions(...)
    }

    class "src/initial_conditions/gc.py" as GCInitialConfiguration <<concrete>> {
      GCInitialConfiguration
      --
      layout: GCStateLayout
      from_components(x, y)
    }
  }

  package "State contracts" as StateContracts {
    top to bottom direction
    class "src/simulation/configuration.py" as InitialConfiguration <<protocol>> {
      InitialConfiguration
      --
      Supplies the initial physical state
      Exposes an independent StateLayout
    }

    class "src/simulation/configuration.py" as StateLayout <<protocol>> {
      StateLayout
      --
      state_dimension
      validate_packed_state_layout(...)
      split(...) / particle_count(...)
      positions(...)
    }
  }

  package " " as ProblemSlot <<layout>> {
    class "src/simulation/problem.py" as InitialValueProblem <<value>> {
      InitialValueProblem
      --
      Binds dynamics to initial configuration
      Checks state-dimension compatibility
    }
  }
}

package "Implicit ABBA integration" as ImplicitIntegration {
  class "src/simulation/methods/\n_projected_abba.py" as IntegrationCoordinator <<coordinator>> {
    _integrate_projected_abba(...)
    --
    Checks the required dynamics capability
    Collects nonlinear-work diagnostics
  }

  class "src/simulation/_fixed.py" as FixedGrid <<scheduler>> {
    integrate_fixed_grid(...)
    --
    Output-independent uniform main grid
    Shadow advances for off-grid samples
  }

  class "src/simulation/methods/\n_projected_abba.py" as ProjectedStep <<step>> {
    _solve_projected_step(...)
    --
    Initialize mu = 0
    Set residual tolerance
  }

  class "Duplicated ABBA\nstage map" as ABBAStages <<map>> {
    u0 = z + mu
    v0 = z - mu
    --
    Apply endpoint-time
    A-B-B-A shears
    Return u_final, v_final
  }

  class "Nonlinear\nprojection root" as ProjectionRoot <<solve>> {
    residual = u_final - v_final
    residual += 2 mu
    --
    Newton: exact 2 x 2 blocks
    Broyden: residual-only updates
    Update mu until converged
  }

  class "Accepted\nphysical step" as AcceptedStep <<state>> {
    Average projected copies
    --
    State at t + h
    Multiplier and solver metrics
  }

  class "src/simulation/observation.py" as StepObservation <<optional event>> {
    ImplicitABBAIntegrationStep
    --
    Accepted stage snapshots
    Exact generating dynamics instance
  }
}

package "Result boundary" as ResultBoundary {
  class "src/simulation/_result.py" as IntegrationData <<internal value>> {
    Requested times
    Sampled physical states
    Method diagnostics
  }

  class "Return to\nSimulationRunner" as RunnerReturn <<facade continuation>> {
    Same simulate(...) call
    --
    Receives IntegrationData
    Validates returned arrays
    Builds Solution
  }

  class "src/simulation/solution.py" as Solution <<public result>> {
    Solution
    --
    Immutable sampled trajectory
    Read-only diagnostics
    Initial configuration plus composed layout
  }
}

' Type and implementation relationships.
GuidingCenterJacobianSystem -right-|> DynamicalSystem
GuidingCenterDynamics .right.|> GuidingCenterJacobianSystem
GCStateLayout -right-|> PackedStateLayout
GCInitialConfiguration -right-|> StateConfiguration
GCStateLayout .left.|> StateLayout
GCInitialConfiguration .left.|> InitialConfiguration
InitialConfiguration o-down- StateLayout
GCInitialConfiguration o-down- GCStateLayout
StateConfiguration -[hidden]down- PackedStateLayout
ProblemSlot -[hidden]right-> StateContracts
StateContracts -[hidden]right-> GuidingCenterInitialState
GuidingCenterInitialState -[hidden]right-> SharedStateImplementation
SharedStateImplementation -[hidden]right-> RequestSlot
RequestSlot -[hidden]right-> RunnerSlot
RunnerSlot -[hidden]right-> MethodSlot
ImplicitABBABase .left.|> NumericalMethod
ImplicitABBA1 -left-|> ImplicitABBABase

note bottom of StateConfiguration
  Abstract initial-state storage.
  It cannot be instantiated without a concrete layout.
end note

' Public run assembly.
DynamicalSystem -right-> InitialValueProblem
InitialConfiguration -left-> InitialValueProblem
InitialValueProblem -right-> SimulationRunner
NumericalMethod -left-> SimulationRunner
SimulationRequest -right-> SimulationRunner

' Implicit ABBA runtime path.
ImplicitABBA1 -right-> IntegrationCoordinator
IntegrationCoordinator -right-> FixedGrid
FixedGrid -right-> ProjectedStep
ProjectedStep -right-> ABBAStages
ABBAStages <-right-> ProjectionRoot
ProjectionRoot -right-> AcceptedStep

' The inherited layer is consumed only through its public capabilities.
GuidingCenterJacobianSystem .right.> ABBAStages
GuidingCenterJacobianSystem .right.> ProjectionRoot

' Results and optional observation.
AcceptedStep .right.> StepObservation
AcceptedStep -right-> IntegrationData
IntegrationData -right-> RunnerReturn
RunnerReturn -right-> Solution

' Preserve the three principal phases independently of cross-phase dependencies.
InheritedBoundary -[hidden]right-> RunAssembly
RunAssembly -[hidden]right-> ImplicitIntegration
ImplicitIntegration -[hidden]right-> ResultBoundary

note bottom of GuidingCenterDynamics
  This is the hand-off from the dynamics diagram.
  Its internal field model and equations are intentionally omitted here.
end note

note bottom of FixedGrid
  Shadow advances produce requested samples but do not alter
  the main integration trajectory or emit step observations.
end note

note bottom of ProjectionRoot
  Both nonlinear solvers target the same reduced implicit root.
  Only Newton consumes the inherited particle Jacobians.
end note

legend bottom
  |= Relation |= Meaning in this diagram |
  | solid line with hollow triangle | Explicit Python inheritance |
  | dashed line with hollow triangle | Structural implementation of a protocol |
  | ordinary dashed arrow into a runtime step | Required capability or optional event |
  | hollow diamond | Configuration composes and exposes its layout |
  | ordinary solid arrow into a consumer | Argument or returned data supplied to that consumer |
  | ordinary solid arrow between runtime steps | Call, construction, or forward hand-off |
endlegend

@enduml
