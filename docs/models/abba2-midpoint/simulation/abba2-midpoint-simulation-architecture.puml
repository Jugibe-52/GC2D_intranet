@startdot
digraph architecture {
  graph [rankdir=TB, bgcolor="#f8fafc"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans"];
  recipe [label="Composition recipe\nA/2, B/2, T/2, T/2, B/2, A/2\nNo harmonic coupling", fillcolor="#fff0d9"];
  method [label="ABBA2Midpoint\nExports: simulation / methods.extended\nPresets inherit PalindromicMethod", fillcolor="#e5ecfa"];
  driver [label="Simulation + execution\nsrc/simulation/runner.py and src/execution/\nMain steps, output sampling, collection", fillcolor="#e5ecfa"];
  state [label="DoubledFormulation\nsrc/formulations/state.py\nTwo copies; optional time and kappa", fillcolor="#e5ecfa"];
  advance [label="Common advance\nextended/palindromic.py\nImplicit solve or final mean; passive finish", fillcolor="#e5ecfa"];
  energy [label="Passive energy and outputs\ncore/energy.py: accepted shear quadrature\nH + kappa; no feedback into the root", fillcolor="#e1f0e6"];
  observe [label="Optional observations\nextended/observations.py: event adapters\nPublic records: contracts/methods/", fillcolor="#f0e5f5"];
  projection [label="midpoint_step\ncore/midpoint.py\nOne arithmetic diagonal average", fillcolor="#e1f0e6"];
  solver [label="Explicit projection\nAverage the two final copies\nNo Newton / Broyden calls", fillcolor="#fff0d9"];
  placement [label="Method identity\nArithmetic mean after one pair\nNo nonlinear solve", fillcolor="#fff0d9"];
  compose [label="compose\ncore/composition.py: explicit A/B/T/C\nAccepted trace reused by all consumers", fillcolor="#e1f0e6"];
  tangent [label="Accepted stage trace\nSigned times, durations and shear inputs\nEnergy evaluated after the spatial map", fillcolor="#e1f0e6"];
  maps [label="GCDoubledMaps\napply_spatial(A / B / C)\nOnly T changes the clock\nBM4 has no C operation", fillcolor="#e1f0e6"];
  dynamics [label="Physical dynamics\nVector field, analytic derivatives, H and partial_t H\nExisting dynamics and potential contracts", fillcolor="#e5ecfa"];
  recipe -> method;
  method -> driver;
  driver -> advance;
  state -> advance;
  advance -> projection;
  advance -> energy;
  advance -> observe;
  projection -> compose;
  projection -> solver;
  compose -> tangent;
  compose -> maps;
  maps -> dynamics;
}
@enddot
