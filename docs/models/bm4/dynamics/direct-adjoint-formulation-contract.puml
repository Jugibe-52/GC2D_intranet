@startuml
title BM4 physical-system and direct/adjoint formulation contract

skinparam componentStyle rectangle

package dynamics {
  interface DynamicalSystem {
    +state_dimension
    +vector_field(t, state)
  }
  interface ExtendedHamiltonianSystem {
    +hamiltonian(t, state)
    +extended_momentum_derivative(t, state)
  }
  class GuidingCenterDynamics
  class FullCyclotronDynamics
}

package initial_conditions {
  class GCInitialConfiguration
  class FCInitialConfiguration
}

package simulation.formulations {
  interface DirectAdjointFormulation {
    +prepare(problem, track_energy)
  }
  interface StageProjectedFormulation {
    +prepare(problem, track_energy)
  }
  class GCExtendedFormulation {
    +coupling_frequency
  }
  class GCStageProjectedFormulation
  class FCSplitFormulation
}

package simulation.methods.bm4 {
  class BM4Composition
  class ProjectedBM4Composition
  class MidpointBM4
  class BM4Implicit1
  class BM4Implicit2
  class BM4_implicit2
}

GuidingCenterDynamics ..|> DynamicalSystem
GuidingCenterDynamics ..|> ExtendedHamiltonianSystem
FullCyclotronDynamics ..|> DynamicalSystem
FullCyclotronDynamics ..|> ExtendedHamiltonianSystem

GCExtendedFormulation ..|> DirectAdjointFormulation
GCStageProjectedFormulation ..|> StageProjectedFormulation
StageProjectedFormulation --|> DirectAdjointFormulation
FCSplitFormulation ..|> DirectAdjointFormulation

GuidingCenterDynamics --> GCExtendedFormulation : f, H, spatial Jacobians
GCInitialConfiguration --> GCExtendedFormulation : component-major layout
GuidingCenterDynamics --> GCStageProjectedFormulation : uncoupled shears
GCInitialConfiguration --> GCStageProjectedFormulation
FullCyclotronDynamics --> FCSplitFormulation : rotation and electric kick
FCInitialConfiguration --> FCSplitFormulation

DirectAdjointFormulation --> BM4Composition
StageProjectedFormulation --> ProjectedBM4Composition
GCStageProjectedFormulation --> MidpointBM4
GCExtendedFormulation --> BM4Implicit1
GCExtendedFormulation --> BM4Implicit2
GuidingCenterDynamics --> BM4_implicit2 : one particle, full (z,t,k)

note right of GCExtendedFormulation
  Internal GC state:
  two copies (u,v) in R^(4N)
  optional triangular momentum
end note

note right of FCSplitFormulation
  Internal FC state:
  one physical state in R^(4N)
  optional triangular momentum
end note

@enduml
