@startdot
digraph architecture {
  graph [rankdir=TB, bgcolor="#f8fafc"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans"];
  recipe [label="Composition recipe\nExplicit A/B/T operations\nGeneric recipes may also include C", fillcolor="#fff0d9"];
  method [label="ABBA and BM4\nExports: simulation / methods.extended\nFixed step belongs to the method", fillcolor="#e5ecfa"];
  driver [label="Simulation + execution\nSelect device and prepare components\nAccepted intervals, samples and collection", fillcolor="#e5ecfa"];
  state [label="DoubleFormulation\nPhysical size only; lift / join / split\nTemporary copies; no time or momentum", fillcolor="#e5ecfa"];
  advance [label="Shared advance\nSame algorithm with NumPy or JAX arrays\nPhysical Z, work and optional quadrature", fillcolor="#e5ecfa"];
  energy [label="EnergyObserver\nOwn momentum; consume accepted quadrature\nBind H and -partial_t H through execution", fillcolor="#e1f0e6"];
  observe [label="Optional observations\nextended/observations.py: event adapters\nPublic records: contracts/methods/", fillcolor="#f0e5f5"];
  projection [label="Spatial projection\nsolve_projection / midpoint_step\nHairer equation or arithmetic mean", fillcolor="#e1f0e6"];
  solver [label="Prepared algebraic solver\nOrdinary or JAX; inherited controls\nOwn iterations, derivatives and callbacks", fillcolor="#fff0d9"];
  placement [label="Method identity\nOne outer projection per implicit step\nNo intermediate projections", fillcolor="#fff0d9"];
  compose [label="compose\ncore/composition.py: explicit A/B/T/C\nAccepted trace reused by all consumers", fillcolor="#e1f0e6"];
  tangent [label="Analytic tangents\ncore/jacobians.py: ordered particle tangents\nBroyden does not evaluate Jacobians", fillcolor="#e1f0e6"];
  maps [label="GCDoubledMaps\napply_spatial(A / B / C)\nOnly T changes the clock\nBM4 has no C operation", fillcolor="#e1f0e6"];
  dynamics [label="Prepared physical functions\nPotential / dynamics own _as_jax()\nMethod retains functions only", fillcolor="#e5ecfa"];
  recipe -> method;
  method -> driver;
  driver -> advance;
  state -> advance;
  advance -> projection;
  driver -> energy;
  advance -> energy;
  advance -> observe;
  projection -> compose;
  projection -> solver;
  compose -> tangent;
  compose -> maps;
  maps -> dynamics;
}
@enddot
