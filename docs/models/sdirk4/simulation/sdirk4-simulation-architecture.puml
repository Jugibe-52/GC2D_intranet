@startdot
digraph architecture {
  graph [rankdir=TB, bgcolor="#f8fafc"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans"];
  recipe [label="Numerical scheme\nFive diagonally implicit stages", fillcolor="#fff0d9"];
  method [label="SDIRK4\nInherits DiagonallyImplicitRungeKutta\nFixed step; simulation / methods", fillcolor="#e5ecfa"];
  driver [label="Simulation + execution\nSelect device and prepare components\nAccepted intervals, samples and collection", fillcolor="#e5ecfa"];
  state [label="Physical state\nInitialConditions: values and layout\nNo formulation or auxiliary coordinates", fillcolor="#e5ecfa"];
  advance [label="Shared advance\nSame algorithm with NumPy or JAX arrays\nPhysical Z, work and optional quadrature", fillcolor="#e5ecfa"];
  energy [label="EnergyObserver\nH and analytic +partial_t H at endpoints\nNo stage access or momentum integration", fillcolor="#e1f0e6"];
  observe [label="Step callbacks\nPassed through simulate(observers=...)\nExecution supplies physical provenance", fillcolor="#f0e5f5"];
  projection [label="Stage equations\nRecipe: A/B/C tableau\nInherited stage equations", fillcolor="#e1f0e6"];
  solver [label="Prepared algebraic solver\nOrdinary or JAX; inherited controls\nOwn iterations, derivatives and callbacks", fillcolor="#fff0d9"];
  placement [label="Method identity\nOne Newton system per stage", fillcolor="#fff0d9"];
  compose [label="Physical evaluations\nPhysical vector-field and optional derivative calls\nNo Hamiltonian or momentum evaluation", fillcolor="#e1f0e6"];
  tangent [label="Sampling\nIndependent shortened physical steps\nLeave the accepted trajectory unchanged", fillcolor="#e1f0e6"];
  maps [label="Accepted numerical data\nRetained stage times, states and weights", fillcolor="#e1f0e6"];
  dynamics [label="Prepared physical functions\nPotential / dynamics own _as_jax()\nMethod retains functions only", fillcolor="#e5ecfa"];
  recipe -> method;
  method -> driver;
  driver -> advance;
  state -> advance;
  advance -> projection;
  driver -> energy;
  advance -> observe;
  projection -> compose;
  projection -> solver;
  compose -> tangent;
  compose -> maps;
  maps -> dynamics;
}
@enddot
