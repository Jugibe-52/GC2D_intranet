@startdot
digraph G {
  graph [
    rankdir=LR,
    compound=true,
    newrank=true,
    splines=ortho,
    nodesep=0.32,
    ranksep=0.72,
    pad=0.18,
    bgcolor="white",
    fontname="DejaVu Sans",
    fontsize=12,
    label="ABBA Numerical Architecture - Method Instances and Common Integration\nModule overview: physical, auxiliary-energy and fully extended strategies",
    labelloc="t",
    labeljust="c"
  ];
  node [shape=plain, fontname="DejaVu Sans", fontsize=9];
  edge [color="#333333", penwidth=1.0, arrowsize=0.68, fontname="DejaVu Sans", fontsize=8];

  subgraph cluster_boundary {
    label="Problem and simulation boundary";
    labeljust="l";
    color="#777777";
    style="rounded";

    boundary_anchor [shape=point, width=0, height=0, label="", style=invis];

    InitialState [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="8">src/simulation/configuration.py<BR/>src/initial_conditions/base.py, gc.py</FONT><BR/><B>Initial state and layout</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT"><B>InitialConfiguration</B> &#171;protocol&#187;<BR ALIGN="LEFT"/><B>StateLayout</B> &#171;protocol&#187;<BR ALIGN="LEFT"/><B>StateConfiguration</B><BR ALIGN="LEFT"/><B>PackedStateLayout</B><BR ALIGN="LEFT"/><B>GCInitialConfiguration</B>.from_components(...)<BR ALIGN="LEFT"/><B>GCStateLayout</B><BR ALIGN="LEFT"/>validate_packed_state_layout(...)<BR ALIGN="LEFT"/>particle_count(...), positions(...)</TD></TR>
      </TABLE>
    >];

    Assembly [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="8">src/simulation</FONT><BR/><B>Public run assembly</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT"><B>InitialValueProblem</B>.__post_init__(...)<BR ALIGN="LEFT"/>initial_state, particle_count<BR ALIGN="LEFT"/><B>SimulationRequest</B>.__post_init__(...), uniform(...)<BR ALIGN="LEFT"/><B>SimulationRunner</B>.simulate(...)<BR ALIGN="LEFT"/>simulate(...)<BR ALIGN="LEFT"/><B>NumericalMethod</B>.integrate(...) &#171;protocol&#187;</TD></TR>
      </TABLE>
    >];

    { rank=same; boundary_anchor; InitialState; Assembly; }
  }

  subgraph cluster_public {
    label="Public ABBA family and configuration";
    labeljust="l";
    color="#6C5B7B";
    penwidth=1.2;
    style="rounded";

    public_anchor [shape=point, width=0, height=0, label="", style=invis];

    ABBA2Midpoint [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3ECF7">
        <TR><TD><FONT POINT-SIZE="8">abba/order2_midpoint.py</FONT><BR/><B>ABBA2Midpoint</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">__post_init__(), prepare(...)<BR ALIGN="LEFT"/>inherited IntegrationMethod.integrate(...)<BR ALIGN="LEFT"/>state_extension: 2 choices<BR ALIGN="LEFT"/>track_energy: False / True</TD></TR>
      </TABLE>
    >];

    ABBA2Implicit [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3ECF7">
        <TR><TD><FONT POINT-SIZE="8">abba/order2_implicit.py</FONT><BR/><B>ABBA2Implicit</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">prepare(...)<BR ALIGN="LEFT"/>inherited IntegrationMethod.integrate(...)<BR ALIGN="LEFT"/>2 x 2 x 3 configurations</TD></TR>
      </TABLE>
    >];

    ABBA4Implicit [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3ECF7">
        <TR><TD><FONT POINT-SIZE="8">abba/order4_implicit.py</FONT><BR/><B>ABBA4Implicit</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">prepare(...)<BR ALIGN="LEFT"/>inherited IntegrationMethod.integrate(...)<BR ALIGN="LEFT"/>one outer projection around all three<BR ALIGN="LEFT"/>2 x 2 x 3 configurations</TD></TR>
      </TABLE>
    >];

    ABBA6Implicit [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3ECF7">
        <TR><TD><FONT POINT-SIZE="8">abba/order6_implicit.py</FONT><BR/><B>ABBA6Implicit</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">prepare(...)<BR ALIGN="LEFT"/>inherited IntegrationMethod.integrate(...)<BR ALIGN="LEFT"/>seven projected maps</TD></TR>
      </TABLE>
    >];

    Configuration [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FBF7FD">
        <TR><TD><FONT POINT-SIZE="8">abba/_configuration.py, _implicit.py<BR/>methods/_nonlinear.py</FONT><BR/><B>Configuration symbols</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT"><B>ABBA4_PROJECTION_PLACEMENTS</B><BR ALIGN="LEFT"/><B>_ABBAImplicitConfig</B>.__post_init__(...)<BR ALIGN="LEFT"/>_validate_projection_formulation(...)<BR ALIGN="LEFT"/>_validate_projection_placement(...)<BR ALIGN="LEFT"/>_validate_state_extension(...)<BR ALIGN="LEFT"/>_resolved_track_energy(...)<BR ALIGN="LEFT"/>_state_dimension_diagnostics(...)<BR ALIGN="LEFT"/>_positive_finite(...)<BR ALIGN="LEFT"/>_positive_integer(...)<BR ALIGN="LEFT"/>_validate_nonlinear_solver(...)</TD></TR>
      </TABLE>
    >];

    { rank=same; public_anchor; ABBA2Midpoint; ABBA2Implicit; ABBA4Implicit; ABBA6Implicit; Configuration; }
  }

  subgraph cluster_coordinators {
    label="Method preparation, recipes and common integration";
    labeljust="l";
    color="#3F6F8F";
    penwidth=1.2;
    style="rounded";

    coordinator_anchor [shape=point, width=0, height=0, label="", style=invis];

    MidpointCoordinator [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9">abba/order2_midpoint.py</FONT><BR/><B>Midpoint preparation and map</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">ABBA2Midpoint.initialize(...): None<BR ALIGN="LEFT"/>advance(t, workspace, h): StepResult<BR ALIGN="LEFT"/>_midpoint_abba_step(...); _ABBA2MidpointStep<BR ALIGN="LEFT"/>build_observation(info, step); export_history(...)</TD></TR>
<HR/><TR><TD ALIGN="LEFT">Explicit four-stage map and arithmetic mean.<BR ALIGN="LEFT"/>Full branch: class-owned _extended_step.<BR ALIGN="LEFT"/>Neither branch owns a time loop.</TD></TR>
      </TABLE>
    >];

    ProjectedCoordinator [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">SHARED BASE OF ABBA2 / ABBA4 / ABBA6</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>_ABBAImplicitMethod</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">abba/_implicit.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT">initialize(problem,request): set this run's resources<BR ALIGN="LEFT"/>state_ops: StatePolicy; project; coefficients<BR ALIGN="LEFT"/>initial_state; metadata; optional event builder</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">solve_step(t,state,h): selected numerical recipe<BR ALIGN="LEFT"/>advance(t,workspace,h): StepResult<BR ALIGN="LEFT"/>build_observation(info,step); export_history(...)</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">No separate family context or method adapter.<BR ALIGN="LEFT"/>Concrete classes select order and supported placement.<BR ALIGN="LEFT"/>The common driver handles history and observer dispatch.</TD></TR>
      </TABLE>
    >];

    ComposedCoordinator [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9">abba/steps.py</FONT><BR/><B>Complete-step recipes</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">solve_single_map_step(...): one projected ABBA2 map<BR ALIGN="LEFT"/>solve_projected_composition_step(...)<BR ALIGN="LEFT"/>ABBA4: three signed maps, three projections<BR ALIGN="LEFT"/>ABBA6: seven signed maps, seven projections</TD></TR>
<HR/><TR><TD ALIGN="LEFT">Return tuple[ProjectedMapResult, ...].<BR ALIGN="LEFT"/>Each base map keeps its actual start and duration.<BR ALIGN="LEFT"/>Negative coefficients produce backward substeps.</TD></TR>
      </TABLE>
    >];

    SingleCoordinator [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9">abba/steps.py / projection_outer.py</FONT><BR/><B>ABBA4 exterior-projection recipe</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">solve_outer_projection_step(...)<BR ALIGN="LEFT"/>One projection around three unprojected base maps.<BR ALIGN="LEFT"/>Copies pass directly between the signed maps.</TD></TR>
<HR/><TR><TD ALIGN="LEFT">Return one ProjectedMapResult with three map traces.<BR ALIGN="LEFT"/>Both reduced and simultaneous equations supported.<BR ALIGN="LEFT"/>Placement is a numerical method choice.</TD></TR>
      </TABLE>
    >];

    FixedGrid [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9">src/simulation/integration.py</FONT><BR/><B>Common BM4 / ABBA integration</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">IntegrationMethod.integrate: new_run then integrate_method<BR ALIGN="LEFT"/>Run instance: initial_state, formulation, class operations<BR ALIGN="LEFT"/>StepInfo: index, interval, independent state_before<BR ALIGN="LEFT"/>StepResult: state, statistics, method-specific details</TD></TR>
<HR/><TR><TD ALIGN="LEFT">integrate_method: accepted-step orchestration<BR ALIGN="LEFT"/>FixedStepController.steps(...): uniform h &lt;= max_step<BR ALIGN="LEFT"/>sample(...): independent shortened shadow advance<BR ALIGN="LEFT"/>StepController: fixed and adaptive accepted-step contract</TD></TR>
<HR/><TR><TD ALIGN="LEFT">Collector owns history and metrics; method owns maps.<BR ALIGN="LEFT"/>Observation and export are bound method operations.<BR ALIGN="LEFT"/>_Progress updates here; ABBA uses fixed control.</TD></TR>
      </TABLE>
    >];

    { rank=same; coordinator_anchor; MidpointCoordinator; ProjectedCoordinator; ComposedCoordinator; SingleCoordinator; FixedGrid; }
  }

  subgraph cluster_physical {
    label="Physical R2 kernels and optional energy sidecar";
    labeljust="l";
    color="#4F7D63";
    penwidth=1.2;
    style="rounded";

    physical_anchor [shape=point, width=0, height=0, label="", style=invis];

    PhysicalStages [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="9">abba/maps/physical.py</FONT><BR/><B>Stages and exact tangents</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">_ABBAStages; _ResidualEvaluation<BR ALIGN="LEFT"/>_checked_vector_field(...)<BR ALIGN="LEFT"/>_evaluate_unprojected_stages(...)<BR ALIGN="LEFT"/>_checked_vector_field_jacobian(...)<BR ALIGN="LEFT"/>_evaluate_displaced_stages(...)<BR ALIGN="LEFT"/>_differentiate_stages(...)</TD></TR>
<HR/><TR><TD ALIGN="LEFT">Physical endpoint-time A-B-B-A in R^(4N).<BR ALIGN="LEFT"/>Retain exact stage-product derivatives.</TD></TR>
      </TABLE>
    >];

    ReducedProjection [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="9">abba/projection_reduced.py</FONT><BR/><B>Reduced multiplier</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">_evaluate_stages(...); _evaluate_residual(...)<BR ALIGN="LEFT"/>_solve_reduced_multiplier_step(...)</TD></TR>
<HR/><TR><TD ALIGN="LEFT">Solve copy separation + 2 mu = 0; mu in R^(2N).<BR ALIGN="LEFT"/>Newton: _solve_newton with exact particle corrections.<BR ALIGN="LEFT"/>Broyden: _solve_broyden using residuals only.</TD></TR>
      </TABLE>
    >];

    SimultaneousProjection [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="8">abba/projection_simultaneous.py</FONT><BR/><B>Simultaneous state and multiplier</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">_particle_blocks(...)<BR ALIGN="LEFT"/>_packed_particle_blocks(...)<BR ALIGN="LEFT"/>_simultaneous_residual_blocks(...)<BR ALIGN="LEFT"/>_simultaneous_newton_jacobian(...)<BR ALIGN="LEFT"/>_solve_simultaneous_state_multiplier_step(...)<BR ALIGN="LEFT"/>local residual_function()</TD></TR>
      </TABLE>
    >];

    SingleProjection [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="8">abba/projection_outer.py</FONT><BR/><B>One outer ABBA4 projection</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT"><B>_SingleProjectionBaseEvaluation</B><BR ALIGN="LEFT"/><B>_SingleProjectionResidualEvaluation</B><BR ALIGN="LEFT"/><B>_ABBA4SingleProjectionStep</B><BR ALIGN="LEFT"/>_validated_state(...)<BR ALIGN="LEFT"/>_evaluate_single_projection_base(...)<BR ALIGN="LEFT"/>_differentiate_single_projection_base(...)<BR ALIGN="LEFT"/>_projected_state(...)<BR ALIGN="LEFT"/>_solve_reduced_abba4_single_projection_step(...)<BR ALIGN="LEFT"/>_simultaneous_residual_blocks(...)<BR ALIGN="LEFT"/>_simultaneous_newton_jacobian(...)<BR ALIGN="LEFT"/>_solve_simultaneous_abba4_single_projection_step(...)<BR ALIGN="LEFT"/>local residual_function()</TD></TR>
      </TABLE>
    >];

    EnergyTracking [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3FAF5">
        <TR><TD><FONT POINT-SIZE="8">abba/_energy.py</FONT><BR/><B>Physical energy tracking</B> [optional]</TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">_validate_energy_tracking(...)<BR ALIGN="LEFT"/>_energy_tracking_initial_state(...)<BR ALIGN="LEFT"/>_unpack_energy_tracking_state(...)<BR ALIGN="LEFT"/>_conjugate_momentum_increment_from_stages(...)<BR ALIGN="LEFT"/>_pack_energy_tracking_state(...)<BR ALIGN="LEFT"/>_energy_tracking_diagnostics(...)<BR ALIGN="LEFT"/>kappa = k / 2 in R^N; no feedback into z</TD></TR>
      </TABLE>
    >];

    { rank=same; physical_anchor; PhysicalStages; ReducedProjection; SimultaneousProjection; SingleProjection; EnergyTracking; }
  }

  subgraph cluster_full {
    label="Fully extended R4 / duplicated R8 numerical kernels";
    labeljust="l";
    color="#A66A3F";
    penwidth=1.2;
    style="rounded";

    full_anchor [shape=point, width=0, height=0, label="", style=invis];

    FullCoordinator [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#FAEEE5">
        <TR><TD><FONT POINT-SIZE="9">abba/state.py / _implicit.py / order2_midpoint.py</FONT><BR/><B>Fully extended state preparation</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">extended_state_policy(...): StatePolicy<BR ALIGN="LEFT"/>initialize / unpack / finish_step / extract<BR ALIGN="LEFT"/>_fully_extended_energy_diagnostics(...)</TD></TR>
<HR/><TR><TD ALIGN="LEFT">One accepted (x,y,t,k) state; two temporary R^4 copies.<BR ALIGN="LEFT"/>Initialize implicit resources on the ABBA instance.<BR ALIGN="LEFT"/>Midpoint initializes its own extended state and maps.<BR ALIGN="LEFT"/>The common driver calls their ordinary class methods.</TD></TR>
      </TABLE>
    >];

    FullFlows [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FAEEE5">
        <TR><TD><FONT POINT-SIZE="8">abba/maps/extended.py</FONT><BR/><B>Extended field and ABBA maps</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT"><B>_AnalyticExtendedMap</B><BR ALIGN="LEFT"/>_checked_extended_state(...)<BR ALIGN="LEFT"/>_synchronized_extended_time(...)<BR ALIGN="LEFT"/>_extended_vector_field(...)<BR ALIGN="LEFT"/>_extended_vector_field_jacobian(...)<BR ALIGN="LEFT"/>_flow_first(...), _flow_second(...)<BR ALIGN="LEFT"/>_flow_first_jacobian(...)<BR ALIGN="LEFT"/>_flow_second_jacobian(...)<BR ALIGN="LEFT"/>_abba_base_map(...)<BR ALIGN="LEFT"/>_composed_abba_base_map(...)<BR ALIGN="LEFT"/>local map_state(), jacobian_state()</TD></TR>
      </TABLE>
    >];

    FullProjection [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FAEEE5">
        <TR><TD><FONT POINT-SIZE="8">abba/projection_extended.py</FONT><BR/><B>Full diagonal projection</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT"><B>_FullProjectedStep</B><BR ALIGN="LEFT"/>_full_reduced_residual_jacobian(...)<BR ALIGN="LEFT"/>_solve_abba_full_reduced_projection(...)<BR ALIGN="LEFT"/>_solve_abba_full_simultaneous_projection(...)<BR ALIGN="LEFT"/>_solve_abba_full_projection(...)<BR ALIGN="LEFT"/>local evaluate(), evaluate_unknown(), accepted()<BR ALIGN="LEFT"/>Newton: _solve_newton + exact correction<BR ALIGN="LEFT"/>Broyden: _solve_broyden(...)</TD></TR>
      </TABLE>
    >];

    FullTangent [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#FFF5EC">
        <TR><TD><FONT POINT-SIZE="9">abba/projection_extended.py / observations.py</FONT><BR/><B>Observer-requested tangent path</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">_centered_map_jacobian(...); _base_map_jacobian(...)<BR ALIGN="LEFT"/>_projected_substep_jacobian(...)<BR ALIGN="LEFT"/>bind_event_builder(...); _extended_base_event(...)</TD></TR>
<HR/><TR><TD ALIGN="LEFT">Read accepted full-map traces after convergence.<BR ALIGN="LEFT"/>Compose exact projected substep tangents when available.<BR ALIGN="LEFT"/>Retain the existing finite-difference fallback.<BR ALIGN="LEFT"/>Only the configured event builder requests this work.</TD></TR>
      </TABLE>
    >];

    { rank=same; full_anchor; FullCoordinator; FullFlows; FullProjection; FullTangent; }
  }

  subgraph cluster_shared {
    label="Nonlinear solvers, records, observation and results";
    labeljust="l";
    color="#555555";
    penwidth=1.2;
    style="rounded";

    shared_anchor [shape=point, width=0, height=0, label="", style=invis];

    Nonlinear [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#F2F2F2">
        <TR><TD><FONT POINT-SIZE="9">src/simulation/methods/_nonlinear.py</FONT><BR/><B>Shared convergence and nonlinear records</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">_solve_newton(...); _solve_broyden(...)<BR ALIGN="LEFT"/>_checked_residual_evaluation(...)<BR ALIGN="LEFT"/>_NonlinearResult; SolveStats</TD></TR>
<HR/><TR><TD ALIGN="LEFT">Shared convergence checks, errors and counters.<BR ALIGN="LEFT"/>Equation-specific residual and correction callbacks.<BR ALIGN="LEFT"/>Zero corrections still means one residual evaluation.</TD></TR>
      </TABLE>
    >];
    Records [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9">abba/records.py</FONT><BR/><B>Numerical records and step_statistics</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">records.StepResult: next_workspace, projections<BR ALIGN="LEFT"/>ProjectedMapResult: state, multiplier, SolveStats, trace<BR ALIGN="LEFT"/>PhysicalProjectionTrace / ExtendedProjectionTrace<BR ALIGN="LEFT"/>PhysicalBaseMapTrace: signed interval and stage data</TD></TR>
<HR/><TR><TD ALIGN="LEFT">step_statistics extracts one row without storing it.<BR ALIGN="LEFT"/>Sum work; retain the worst-ratio residual/tolerance pair.<BR ALIGN="LEFT"/>Take the maximum multiplier norm.<BR ALIGN="LEFT"/>Optional projection columns: one, three or seven.</TD></TR>
      </TABLE>
    >];

    Observations [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FFFDEB">
        <TR><TD><FONT POINT-SIZE="8">src/simulation/observation.py</FONT><BR/><B>Step-observer records</B> [optional]</TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT"><B>IntegrationStep</B><BR ALIGN="LEFT"/><B>ImplicitIntegrationStep</B><BR ALIGN="LEFT"/><B>ABBA2ImplicitIntegrationStep</B><BR ALIGN="LEFT"/><B>UnprojectedABBAIntegrationStep</B><BR ALIGN="LEFT"/><B>ABBAImplicitCompositionIntegrationStep</B><BR ALIGN="LEFT"/><B>ABBA4ImplicitIntegrationStep</B><BR ALIGN="LEFT"/><B>ABBA6ImplicitIntegrationStep</B><BR ALIGN="LEFT"/><B>ABBA4ImplicitSingleProjectionIntegrationStep</B><BR ALIGN="LEFT"/><B>FullyExtendedBaseMap</B><BR ALIGN="LEFT"/><B>FullyExtendedImplicitIntegrationStep</B></TD></TR>
      </TABLE>
    >];

    Result [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="6" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9">src/simulation/integration.py / _result.py / solution.py</FONT><BR/><B>Collection, export and result boundary</B></TD></TR>
<HR/><TR><TD ALIGN="LEFT">IntegrationCollector.record_step(info, statistics)<BR ALIGN="LEFT"/>Requested history and copied metric rows per run.<BR ALIGN="LEFT"/>finalize(): step_count, starts, ends, sizes, metric arrays.<BR ALIGN="LEFT"/>No retained traces or observer events.</TD></TR>
<HR/><TR><TD ALIGN="LEFT">run.export_history(times, history): physical + energy<BR ALIGN="LEFT"/>Merge metadata and legacy aliases &#8594; IntegrationData.<BR ALIGN="LEFT"/>SimulationRunner validates and constructs Solution.<BR ALIGN="LEFT"/>Read-only times, states, diagnostics and source.</TD></TR>
      </TABLE>
    >];

    Scope [shape=note, style="filled", fillcolor="#FFFDEB", color="#B8AE6F", margin="0.10,0.07", label="Coverage: active ABBA runtime symbols\nfor physical, energy-tracked physical, and fully extended paths.\nNamed local closures are shown with their owner.\nDashed arrows are optional energy, observer, or progress paths.\nOther method families and unused compatibility helpers are outside scope."];

    { rank=same; shared_anchor; Nonlinear; Records; Observations; Result; Scope; }
  }

  // Invisible spine keeps the six regions in temporal reading order.
  boundary_anchor -> public_anchor -> coordinator_anchor -> physical_anchor -> full_anchor -> shared_anchor [style=invis, weight=1000, minlen=2];

  // Public assembly and method selection.
  InitialState -> Assembly [constraint=false];
  Assembly -> ABBA2Midpoint [constraint=false];
  Assembly -> ABBA2Implicit [constraint=false];
  Assembly -> ABBA4Implicit [constraint=false];
  Assembly -> ABBA6Implicit [constraint=false];
  Configuration -> ABBA2Midpoint [style=dashed, constraint=false];
  Configuration -> ABBA2Implicit [constraint=false];
  Configuration -> ABBA4Implicit [constraint=false];
  Configuration -> ABBA6Implicit [constraint=false];

  // Method preparation selects the recipe and state strategy once.
  ABBA2Midpoint -> MidpointCoordinator [constraint=false];
  ABBA2Implicit -> ProjectedCoordinator [constraint=false];
  ABBA4Implicit -> ProjectedCoordinator [constraint=false];

  ABBA6Implicit -> ProjectedCoordinator [constraint=false];
  ABBA2Midpoint -> FullCoordinator [constraint=false];




  // Initialization sets resources on the numerical class; the driver calls its methods.
  MidpointCoordinator -> FixedGrid [constraint=false];
  ProjectedCoordinator -> FixedGrid [constraint=false];
  ProjectedCoordinator -> ComposedCoordinator [constraint=false];
  ProjectedCoordinator -> SingleCoordinator [constraint=false];
  ProjectedCoordinator -> FullCoordinator [constraint=false];

  // Active physical callback paths.
  FixedGrid -> ProjectedCoordinator [constraint=false, style=dotted];
  FixedGrid -> MidpointCoordinator [constraint=false, style=dotted];
  ProjectedCoordinator -> ReducedProjection [constraint=false];
  ProjectedCoordinator -> SimultaneousProjection [constraint=false];
  ComposedCoordinator -> ReducedProjection [constraint=false];
  ComposedCoordinator -> SimultaneousProjection [constraint=false];
  SingleCoordinator -> SingleProjection [constraint=false];
  MidpointCoordinator -> PhysicalStages [constraint=false];
  ReducedProjection -> PhysicalStages [constraint=false];
  SimultaneousProjection -> PhysicalStages [constraint=false];
  SingleProjection -> PhysicalStages [constraint=false];

  // Optional triangular momentum sidecar for every physical method.
  MidpointCoordinator -> EnergyTracking [style=dashed, constraint=false];
  ProjectedCoordinator -> EnergyTracking [style=dashed, constraint=false];
  ComposedCoordinator -> EnergyTracking [style=dashed, constraint=false];
  SingleCoordinator -> EnergyTracking [style=dashed, constraint=false];
  PhysicalStages -> EnergyTracking [style=dashed, constraint=false];
  EnergyTracking -> Result [style=dashed, constraint=false];

  // Active fully extended callback path.
  FullCoordinator -> FullFlows [constraint=false];
  FullCoordinator -> FullProjection [constraint=false];
  FullProjection -> FullFlows [constraint=false];
  FullCoordinator -> FullTangent [style=dashed, constraint=false];
  FullTangent -> FullFlows [style=dashed, constraint=false];

  // Shared solver and result hand-off.
  ReducedProjection -> Nonlinear [constraint=false];
  SimultaneousProjection -> Nonlinear [constraint=false];
  SingleProjection -> Nonlinear [constraint=false];
  FullProjection -> Nonlinear [constraint=false];
  MidpointCoordinator -> Observations [style=dashed, constraint=false];
  FixedGrid -> Observations [style=dashed, constraint=false];
  ProjectedCoordinator -> Records [constraint=false];
  Records -> Result [constraint=false];


  FullTangent -> Observations [style=dashed, constraint=false];
  FixedGrid -> Result [constraint=false];
  Result -> Assembly [constraint=false];
}
