@startdot
digraph architecture {
  graph [rankdir=TB, bgcolor="#f8fafc"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans"];
  recipe [label="Composition recipe\nABBA2 pair; ABBA4 triple jump\nABBA6: seven signed ABBA2 steps", fillcolor="#fff0d9"];
  method [label="ABBA family\nExports: simulation / methods.extended\nFixed step belongs to the method", fillcolor="#e5ecfa"];
  driver [label="Simulation + execution\nBind f / derivatives and observer functions\nAccepted intervals, samples and collection", fillcolor="#e5ecfa"];
  state [label="DoubleFormulation\nPhysical size only; lift / join / split\nTemporary copies; no time or momentum", fillcolor="#e5ecfa"];
  advance [label="Common advance\nPrepare copies; solve or average\nPhysical Z, work and optional quadrature", fillcolor="#e5ecfa"];
  energy [label="EnergyObserver\nOwn momentum; consume accepted quadrature\nBind H and -partial_t H through execution", fillcolor="#e1f0e6"];
  observe [label="Optional observations\nextended/observations.py: event adapters\nPublic records: contracts/methods/", fillcolor="#f0e5f5"];
  projection [label="Spatial projection\nsolve_projection / midpoint_step\nHairer equation or arithmetic mean", fillcolor="#e1f0e6"];
  solver [label="Newton / Broyden\nImplicit variants only; own solver controls\nTolerances, derivatives and callbacks", fillcolor="#fff0d9"];
  placement [label="Method identity\nABBA4 and ABBA6 share one outer solve\nOnly the unprojected recipe differs", fillcolor="#fff0d9"];
  compose [label="compose\ncore/composition.py: explicit A/B/T/C\nAccepted trace reused by all consumers", fillcolor="#e1f0e6"];
  tangent [label="Analytic tangents\ncore/jacobians.py: ordered particle tangents\nBroyden does not evaluate Jacobians", fillcolor="#e1f0e6"];
  maps [label="GCDoubledMaps\napply_spatial(A / B / C)\nOnly T changes the clock\nBM4 has no C operation", fillcolor="#e1f0e6"];
  dynamics [label="Injected physical functions\nf(t, Z) and optional Jacobian\nMethod and maps retain no dynamics object", fillcolor="#e5ecfa"];
  recipe -> method;
  method -> driver;
  driver -> advance;
  state -> advance;
  advance -> projection;
  driver -> energy;
  advance -> energy;
  advance -> observe;
  projection -> compose;
  projection -> solver;
  compose -> tangent;
  compose -> maps;
  maps -> dynamics;
}
@enddot
