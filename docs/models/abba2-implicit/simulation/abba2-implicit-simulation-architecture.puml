@startdot
digraph ABBA2SharedFullExecution {
  // Implemented end-to-end ABBA2Implicit execution, preserving the current public API.
  // Both diagrams expose the same implemented family components and record contracts.
  // Only the public method options, bound step recipe and event payload selection differ.
  // Read the numbered phase headers horizontally, then each phase vertically.
  // Records and operation signatures describe the shared runtime implementation.
  // They are not additional public APIs or a class required for every operation.
  // Cross-cluster edges are declared after all nodes to preserve cluster ownership.
  graph [
    rankdir=TB, newrank=true, compound=true, splines=line,
    nodesep=0.80, ranksep=0.56, pad=0.30,
    bgcolor="#FFFFFF", fontname="DejaVu Sans", fontsize=23,
    labelloc="t", labeljust="l",
    label="ABBA2 | Complete execution through the common integration lifecycle\n\nHorizontal: complete lifecycle. Vertical: shared services and the selected method recipe.\nCOMMON / FAMILY: blue services and green numerical kernels. METHOD SPECIFIC: orange step recipe.\nImplemented runtime: public contracts and numerical maps are retained. N = particles; T = saved times; m = 2N.\nModule paths are relative to src/simulation/methods/abba/ unless stated otherwise."
  ];
  node [
    shape=box, style="rounded,filled", fillcolor="#FFFFFF",
    color="#C4CFDC", penwidth=1.15, margin="0.02,0.02",
    fontname="DejaVu Sans", fontsize=11
  ];
  edge [
    color="#64748B", penwidth=1.15, arrowsize=0.72,
    arrowhead=normal, arrowtail=none, dir=forward,
    fontname="DejaVu Sans", fontsize=10
  ];

  subgraph cluster_physics {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="physics"];
    PhasePhysics [fillcolor="#263D59", color="#263D59", fontcolor="white", margin="0.22,0.16", label="01  PHYSICS AND INITIAL STATE\nDefine the reproducible physical inputs"];

    Potential [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Potential</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/potential/potential.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>interpolation_order: int<BR ALIGN="LEFT"/>metadata: field provenance</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>evaluate(t, x, y, derivatives): array<BR ALIGN="LEFT"/>electric_field(t, x, y): (Ex, Ey)<BR ALIGN="LEFT"/>gyroaverage(rho): Potential</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Load with load_gc2d_h5_potential(...),<BR ALIGN="LEFT"/>or construct with Potential.random(...).<BR ALIGN="LEFT"/>Keep normalization and seed explicit.</TD></TR>
      </TABLE>
    >];
    Dynamics [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GuidingCenterDynamics</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/dynamics/gc.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>potential, effective_potential: Potential<BR ALIGN="LEFT"/>rho: float; state_dimension = 2</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>vector_field(t, z): array[2N]<BR ALIGN="LEFT"/>particle_vector_field_jacobians(t, z)<BR ALIGN="LEFT"/>hamiltonian(t, z): array[N]<BR ALIGN="LEFT"/>extended_momentum_derivative(t, z)</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Provides physical and Hamiltonian<BR ALIGN="LEFT"/>capabilities used by the selected method.</TD></TR>
      </TABLE>
    >];
    Initial [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GCInitialConfiguration</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/gc.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>initial_state: array[2N]<BR ALIGN="LEFT"/>layout: GCStateLayout</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>from_components(x, y): configuration<BR ALIGN="LEFT"/>initial_state: independent state copy</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Inherits StateConfiguration.<BR ALIGN="LEFT"/>Supplies geometry; physical parameters<BR ALIGN="LEFT"/>remain in the dynamics.</TD></TR>
      </TABLE>
    >];
    Layout [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CLASS / STATE CONTRACT</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GCStateLayout</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/gc.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Convention</B><BR ALIGN="LEFT"/>z = [x1, ..., xN, y1, ..., yN]<BR ALIGN="LEFT"/>state_dimension = 2</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>validate_packed_state_layout(z)<BR ALIGN="LEFT"/>split(z): GCState(x, y)<BR ALIGN="LEFT"/>particle_count(z): N<BR ALIGN="LEFT"/>positions(z): (x, y)</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Inherits PackedStateLayout.<BR ALIGN="LEFT"/>Also interprets saved histories [2N, T].</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_definition {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="definition"];
    PhaseDefinition [fillcolor="#263D59", color="#263D59", fontcolor="white", margin="0.22,0.16", label="02  RUN DEFINITION\nAssemble problem, time request and method"];

    Problem [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING FROZEN RECORD</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>InitialValueProblem</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/problem.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>dynamics: DynamicalSystem<BR ALIGN="LEFT"/>initial_configuration: InitialConfiguration</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>__post_init__(): validate compatibility<BR ALIGN="LEFT"/>initial_state: array[2N]<BR ALIGN="LEFT"/>particle_count: int</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Require a finite initial state and<BR ALIGN="LEFT"/>matching dynamics/layout dimensions.</TD></TR>
      </TABLE>
    >];
    Request [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING FROZEN RECORD</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>SimulationRequest</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/request.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>t_span: (t0, tf)<BR ALIGN="LEFT"/>max_step: float<BR ALIGN="LEFT"/>output_times: read-only array[T]</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>uniform(t_span, max_step, sample_count)<BR ALIGN="LEFT"/>__post_init__(): validate time request</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Increasing times include both endpoints.<BR ALIGN="LEFT"/>The saved grid need not equal the step grid.</TD></TR>
      </TABLE>
    >];
    Method [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING PUBLIC CLASS / SHARED INTERNALS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>ABBA2Implicit</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">order2_implicit.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Configuration</B><BR ALIGN="LEFT"/>projection_formulation<BR ALIGN="LEFT"/>state_extension; track_energy; nonlinear_solver<BR ALIGN="LEFT"/>newton_absolute_tolerance<BR ALIGN="LEFT"/>newton_relative_tolerance; newton_max_iterations<BR ALIGN="LEFT"/>progress; step_observer</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Public operations</B><BR ALIGN="LEFT"/>initialize(problem, request): None<BR ALIGN="LEFT"/>new_run(problem, request): same class<BR ALIGN="LEFT"/>inherited integrate(...): IntegrationData</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Inherits _ABBAImplicitConfig and IntegrationMethod.<BR ALIGN="LEFT"/>Implements NumericalMethod structurally.<BR ALIGN="LEFT"/>Keep current public option names compatible.</TD></TR>
      </TABLE>
    >];
    Configuration [fillcolor="#EEF3FA", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD ALIGN="LEFT"><B>12 normalized ABBA2 configurations</B></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">3 state/energy strategies<BR ALIGN="LEFT"/>x 2 projection formulations<BR ALIGN="LEFT"/>x 2 nonlinear solvers</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">A run chooses one configuration.<BR ALIGN="LEFT"/>The diagram shows the available choices;<BR ALIGN="LEFT"/>they are not all executed in sequence.</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_preparation {
    label=""; style="rounded,filled"; color="#C4D0F1"; fillcolor="#F8FAFF";
    node [group="preparation"];
    PhasePreparation [fillcolor="#354D89", color="#354D89", fontcolor="white", margin="0.22,0.16", label="03  ENTRY AND PREPARATION\nValidate once and bind the selected behavior"];

    Runner [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CLASS / PUBLIC FACADE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>SimulationRunner</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/runner.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Entry</B><BR ALIGN="LEFT"/>simulate(problem, method, request): Solution<BR ALIGN="LEFT"/>The public simulate(...) function delegates here.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Before integration</B><BR ALIGN="LEFT"/>Validate the three public input contracts.<BR ALIGN="LEFT"/>Call method.integrate(problem, request).</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The same call resumes in phase 06<BR ALIGN="LEFT"/>after IntegrationData is returned.</TD></TR>
      </TABLE>
    >];
    Prepare [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">INHERITED FAMILY INITIALIZATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>ABBA2Implicit.initialize(...)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">_implicit.py / initialize</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> problem, request, method controls<BR ALIGN="LEFT"/><B>OUT</B> None; instance resources initialized</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">new_run creates an instance of the concrete order.<BR ALIGN="LEFT"/>Validate state/energy capabilities and solver options.<BR ALIGN="LEFT"/>Set StatePolicy, projection and optional event builder.<BR ALIGN="LEFT"/>The class owns solve_step, advance and export.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Physical: planar dynamics and selected derivatives.<BR ALIGN="LEFT"/>Fully extended: one GuidingCenterDynamics particle.<BR ALIGN="LEFT"/>Newton uses the relevant exact derivatives.<BR ALIGN="LEFT"/>Broyden iterations use residuals only.</TD></TR>
      </TABLE>
    >];
    RunMethod [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">SAME NUMERICAL CLASS / ONE INSTANCE PER EXECUTION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>ABBA2Implicit (run)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/methods/abba/_implicit.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Instance data</B><BR ALIGN="LEFT"/>problem; request; initial_state (read-only)<BR ALIGN="LEFT"/>formulation or dynamics; numerical resources<BR ALIGN="LEFT"/>metadata and diagnostic_aliases (read-only)</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Ordinary class methods</B><BR ALIGN="LEFT"/>initialize(problem, request): None<BR ALIGN="LEFT"/>advance(t, state, h): StepResult[Detail]<BR ALIGN="LEFT"/>build_observation(info, step): event<BR ALIGN="LEFT"/>export_history(times, history): physical + auxiliary<BR ALIGN="LEFT"/>controller(): StepController</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">No separate context or callback-based method record.<BR ALIGN="LEFT"/>Construct another instance for another integration.<BR ALIGN="LEFT"/>Completed runs cannot re-enter the global driver.<BR ALIGN="LEFT"/>The collector and external observer own histories.</TD></TR>
      </TABLE>
    >];
    StatePolicy [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">SHARED STATE OPERATIONS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>StatePolicy</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">state.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Bound operations</B><BR ALIGN="LEFT"/>initialize(z0, t0): workspace<BR ALIGN="LEFT"/>unpack(t, workspace): numerical state<BR ALIGN="LEFT"/>finish_step(t, h, workspace, projections): workspace<BR ALIGN="LEFT"/>extract(times, history): physical states + energy<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>One selected strategy</B><BR ALIGN="LEFT"/>Physical: z in R^(2N).<BR ALIGN="LEFT"/>Physical + energy: (z, kappa), kappa in R^N.<BR ALIGN="LEFT"/>Fully extended: (x, y, t, k) in R^4.<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Finish from the last accepted projection state.<BR ALIGN="LEFT"/>Physical tracking uses the accepted stage traces,<BR ALIGN="LEFT"/>including their signed durations and start times.<BR ALIGN="LEFT"/>Auxiliary kappa never feeds back into z.<BR ALIGN="LEFT"/>Full extension evolves t,k and synchronizes time.<BR ALIGN="LEFT"/></TD></TR>
      </TABLE>
    >];
    FamilyResources [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">INHERITED NUMERICAL OPERATIONS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>_ABBAImplicitMethod</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/methods/abba/_implicit.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Run resources</B><BR ALIGN="LEFT"/>state_ops: StatePolicy; project: projection equation<BR ALIGN="LEFT"/>coefficients; optional build_event; initial_state</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Shared operations</B><BR ALIGN="LEFT"/>initialize; solve_step; advance<BR ALIGN="LEFT"/>build_observation; export_history</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Concrete classes select order 2, 4 or 6.<BR ALIGN="LEFT"/>ABBA4 projects once around its complete composition.<BR ALIGN="LEFT"/>Mathematical kernels remain in steps.py and projection modules.</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_execution {
    label=""; style="rounded,filled"; color="#DECBA3"; fillcolor="#FFFCF5";
    node [group="execution"];
    PhaseExecution [fillcolor="#815E22", color="#815E22", fontcolor="white", margin="0.22,0.16", label="04  INTEGRATION AND NONLINEAR SOLVE\nDescend into one complete numerical advance"];
    HistoryExit [shape=point, width=0, height=0, style=invis];

    Runtime [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">ONE COORDINATOR FOR ALL 13 METHODS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>integrate_method(...)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/integration.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> initialized method instance; optional controller<BR ALIGN="LEFT"/><B>OUT</B> IntegrationData</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Create a fresh controller and IntegrationCollector.<BR ALIGN="LEFT"/>Validate each accepted interval and state.<BR ALIGN="LEFT"/>Record metrics; dispatch optional observations;<BR ALIGN="LEFT"/>save requested samples; report temporal progress.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">At completion: export_history + collector.finalize.<BR ALIGN="LEFT"/>Merge metadata, metrics, auxiliary output and aliases.<BR ALIGN="LEFT"/>No branch selects a numerical-method class.</TD></TR>
      </TABLE>
    >];
    Grid [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">UNIFORM ACCEPTED GRID / INDEPENDENT OUTPUTS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>FixedStepController</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/integration.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>steps(run, request)</B><BR ALIGN="LEFT"/>Choose n = ceil((tf-t0)/max_step), h = (tf-t0)/n.<BR ALIGN="LEFT"/>Floating boundary correction uses _step_count.<BR ALIGN="LEFT"/>Yield StepInfo and run.advance(t, state, h).</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>sample(run, info, result, time)</B><BR ALIGN="LEFT"/>Reuse coincident accepted endpoints.<BR ALIGN="LEFT"/>Interior output: shortened advance from a copy<BR ALIGN="LEFT"/>of the preceding accepted state.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">A shadow sample does not alter the main grid.<BR ALIGN="LEFT"/>Its work is excluded from metrics and observations.<BR ALIGN="LEFT"/>DOP853 and Radau supply a different controller.</TD></TR>
      </TABLE>
    >];
    Advance [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">INHERITED ABBA ADVANCE / NO TIME LOOP</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>run.advance(t, workspace, h)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">_implicit.py / advance</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> start time, internal workspace, duration<BR ALIGN="LEFT"/><B>OUT</B> generic StepResult(state, statistics, details)</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">StatePolicy.unpack exposes the numerical state.<BR ALIGN="LEFT"/>Call family.solve_step(t, numerical_state, h).<BR ALIGN="LEFT"/>StatePolicy.finish_step closes state and energy.<BR ALIGN="LEFT"/>Create records.StepResult(workspace, projections).</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">step_statistics(...) extracts one small metric row.<BR ALIGN="LEFT"/>Return that row and the family result as details.<BR ALIGN="LEFT"/>No accumulation or observer callback occurs here.<BR ALIGN="LEFT"/>Main and shadow calls use the same advance.</TD></TR>
      </TABLE>
    >];
    StepRecipe [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#FBE0C7" ALIGN="LEFT"><FONT POINT-SIZE="9">ABBA2 STEP RECIPE / SHARED FAMILY CONTRACT</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>solve_single_map_step(...)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#90673F">steps.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> t, numerical_state, h<BR ALIGN="LEFT"/><B>OUT</B> tuple[ProjectedMapResult, ...]<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Bind one base map for duration h.<BR ALIGN="LEFT"/>Call the shared projection formulation once.<BR ALIGN="LEFT"/>Return (projected_result,).<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">One A-B-B-A map and one nonlinear solve.<BR ALIGN="LEFT"/>The shared runtime handles the rest of the run.<BR ALIGN="LEFT"/></TD></TR>
      </TABLE>
    >];
    Projection [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E3F0E9" ALIGN="LEFT"><FONT POINT-SIZE="9">SHARED EQUATION BUILDERS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Projection formulation</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#537866">projection_reduced.py / projection_simultaneous.py<BR/>projection_outer.py / projection_extended.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> state, selected map, solver options<BR ALIGN="LEFT"/><B>OUT</B> ProjectedMapResult<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The selected map may be one A-B-B-A map<BR ALIGN="LEFT"/>or an unprojected composition.<BR ALIGN="LEFT"/>Displace input copies with +mu / -mu.<BR ALIGN="LEFT"/>Define residual, correction and recovery callbacks.<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Reduced:</B> mu in R^(2N) or R^4.<BR ALIGN="LEFT"/>Solve mapped copy separation + 2 mu = 0.<BR ALIGN="LEFT"/><B>Simultaneous:</B> two final outputs + mu,<BR ALIGN="LEFT"/>in R^(6N) or R^12; map defects + diagonal equality.<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Recover the mean of the projected output copies.<BR ALIGN="LEFT"/>Keep physical and extended equations explicit.<BR ALIGN="LEFT"/>Preserve specialized analytic Jacobians.<BR ALIGN="LEFT"/></TD></TR>
      </TABLE>
    >];
    Nonlinear [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E3F0E9" ALIGN="LEFT"><FONT POINT-SIZE="9">SHARED CONVERGENCE SUPPORT</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Nonlinear solve</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#537866">src/simulation/methods/_nonlinear.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> unknown, callbacks, tolerances<BR ALIGN="LEFT"/><B>OUT</B> _NonlinearResult; adapted to SolveStats<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Evaluate residual and test its scaled tolerance.<BR ALIGN="LEFT"/>If needed, compute a correction and repeat.<BR ALIGN="LEFT"/><B>Newton:</B> formulation-specific exact systems.<BR ALIGN="LEFT"/><B>Broyden:</B> residual-only iteration updates.<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Share stopping rules, counts and error reporting.<BR ALIGN="LEFT"/>Preserve each formulation's block layout.<BR ALIGN="LEFT"/>A failed solve raises an explicit error.<BR ALIGN="LEFT"/></TD></TR>
      </TABLE>
    >];
    Maps [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E3F0E9" ALIGN="LEFT"><FONT POINT-SIZE="9">SHARED NUMERICAL KERNELS / MODULES</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Base maps and tangents</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#537866">maps/physical.py / maps/extended.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> independent copies, t, h, dynamics<BR ALIGN="LEFT"/><B>OUT</B> mapped copies, stages, requested tangent<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Physical:</B> endpoint-time A-B-B-A in R^(4N).<BR ALIGN="LEFT"/><B>Fully extended:</B> four shears in R^8.<BR ALIGN="LEFT"/>Both methods reuse these numerical kernels.<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Fields come from the dynamics contract.<BR ALIGN="LEFT"/>Preserve exact stage-product derivatives.<BR ALIGN="LEFT"/>Composition passes copies between base maps.<BR ALIGN="LEFT"/>Projection owns the input and output shifts.<BR ALIGN="LEFT"/></TD></TR>
      </TABLE>
    >];
    Stages [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E3F0E9" ALIGN="LEFT"><FONT POINT-SIZE="9">NUMERICAL DETAIL / SELECTED STATE SPACE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>The shared four-stage kernel</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#537866">Same equations for ABBA2 and ABBA4</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Physical:</B> supplied copies u0,v0; a = h/2.<BR ALIGN="LEFT"/>f = vector_field; t is this map's start time.<BR ALIGN="LEFT"/><B>A:</B> u1 = u0 + a f(t, v0)<BR ALIGN="LEFT"/><B>B:</B> v1 = v0 + a f(t, u1)<BR ALIGN="LEFT"/><B>B:</B> v2 = v1 + a f(t+h, u1)<BR ALIGN="LEFT"/><B>A:</B> u2 = u1 + a f(t+h, v2)<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Fully extended:</B> supplied copies Z1,Z2.<BR ALIGN="LEFT"/>Z = (x,y,t,k); F(Z) = (f(t,z), 1, -partial_t H).<BR ALIGN="LEFT"/><B>A:</B> Z1 += a F(Z2)<BR ALIGN="LEFT"/><B>B:</B> Z2 += a F(Z1)<BR ALIGN="LEFT"/><B>B:</B> Z2 += a F(Z1)<BR ALIGN="LEFT"/><B>A:</B> Z1 += a F(Z2)<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">For exterior projection, each next base map<BR ALIGN="LEFT"/>receives the previous mapped copies directly.<BR ALIGN="LEFT"/>Keep every map's signed duration and start time.<BR ALIGN="LEFT"/></TD></TR>
      </TABLE>
    >];

  }

  subgraph cluster_records {
    label=""; style="rounded,filled"; color="#D5CDE9"; fillcolor="#FCFAFF";
    node [group="records"];
    PhaseRecords [fillcolor="#654780", color="#654780", fontcolor="white", margin="0.22,0.16", label="05  ACCEPTED STEPS AND DIAGNOSTICS\nRecord basic metrics and optional observations"];
    ObservationStart [group="observer_route", shape=point, width=0, height=0, style=invis];
    ObservationEnd [group="observer_route", shape=point, width=0, height=0, style=invis];
    FinalPhaseLink [group="observer_route", shape=point, width=0, height=0, style=invis];
    MetricsLink [group="observer_route", shape=point, width=0, height=0, style=invis];
    FailurePass [shape=point, width=0, height=0, style=invis];

    Recording [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">ONE RUN / REQUESTED SAMPLES + ACCEPTED METRICS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>IntegrationCollector</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/integration.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>history</B>: internal coordinates x saved times<BR ALIGN="LEFT"/><B>record_step(info, statistics)</B><BR ALIGN="LEFT"/>Copy metric rows with stable keys and shapes.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Record step_start_times, step_times, step_sizes.<BR ALIGN="LEFT"/>Never store method details or observer events.<BR ALIGN="LEFT"/>Rejected adaptive trials have no accepted row;<BR ALIGN="LEFT"/>their numerical work belongs to the accepted step.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>finalize()</B>: stack rows and provide step_count.<BR ALIGN="LEFT"/>Saved columns follow request.output_times.<BR ALIGN="LEFT"/>Metric rows follow accepted step_times.</TD></TR>
      </TABLE>
    >];
    StepResult [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">SHARED RECORD / COMPLETE ADVANCE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Generic and ABBA StepResult</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/integration.py / records.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Generic result</B><BR ALIGN="LEFT"/>state, statistics, details: records.StepResult<BR ALIGN="LEFT"/><B>ABBA details</B><BR ALIGN="LEFT"/>next_workspace: array<BR ALIGN="LEFT"/>projections: tuple[ProjectedMapResult, ...]<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">One common contract for both methods.<BR ALIGN="LEFT"/>ABBA2 returns one projection record.<BR ALIGN="LEFT"/>ABBA4 returns one outer projection record.<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The controller receives generic result.state.<BR ALIGN="LEFT"/>step_statistics and event builders read projections.<BR ALIGN="LEFT"/>Accepted numerical traces live in those records.<BR ALIGN="LEFT"/></TD></TR>
      </TABLE>
    >];
    ProjectedResult [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">SHARED RECORD / ONE PROJECTION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>ProjectedMapResult</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">records.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>start_time, duration; state_before<BR ALIGN="LEFT"/>state: accepted numerical state<BR ALIGN="LEFT"/>multiplier: array; stats: SolveStats<BR ALIGN="LEFT"/>trace: accepted numerical trace<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>Typed numerical traces</B><BR ALIGN="LEFT"/>PhysicalProjectionTrace: ordered stage maps,<BR ALIGN="LEFT"/>with their signed durations and start times.<BR ALIGN="LEFT"/>ExtendedProjectionTrace: accepted full map<BR ALIGN="LEFT"/>and the selected composition coefficients.<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">A composed trace can contain three base maps<BR ALIGN="LEFT"/>while this record still represents only one solve.<BR ALIGN="LEFT"/></TD></TR>
      </TABLE>
    >];
    Stats [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">SHARED RECORD / ONE NONLINEAR SOLVE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>SolveStats</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/methods/_nonlinear.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>solver: newton | broyden<BR ALIGN="LEFT"/>iterations, residual_evaluations: int<BR ALIGN="LEFT"/>residual_norm, tolerance: float<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Canonical nonlinear names for both methods.<BR ALIGN="LEFT"/>A zero-correction solve still counts its<BR ALIGN="LEFT"/>initial residual evaluation.<BR ALIGN="LEFT"/></TD></TR>
      </TABLE>
    >];
    EventBuilder [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#F0E8FA" ALIGN="LEFT"><FONT POINT-SIZE="9">ABBA OPTIONAL OBSERVATION ADAPTER</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>run.build_observation(info, step)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">_implicit.py / observations.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> StepInfo and generic StepResult<BR ALIGN="LEFT"/><B>OUT</B> selected IntegrationStep subclass</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Unpack info.state_before into the event domain.<BR ALIGN="LEFT"/>Call family.build_event(..., step.details).<BR ALIGN="LEFT"/>Copy accepted traces and method-specific snapshots.<BR ALIGN="LEFT"/>Compute tangents only if the event requires them.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The event retains map_state and numerical timing.<BR ALIGN="LEFT"/>integrate_method dispatches step_observer(event).<BR ALIGN="LEFT"/>Analysis and persistence remain in diagnostics/.<BR ALIGN="LEFT"/>Shadow samples never request this builder.</TD></TR>
      </TABLE>
    >];
    Events [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#F0E8FA" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING EVENT CLASSES / METHOD-SPECIFIC PAYLOADS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>ABBA2 event selection</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#79628F">src/simulation/observation.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>ABBA2ImplicitIntegrationStep</B><BR ALIGN="LEFT"/>One projected physical map and stage snapshots.<BR ALIGN="LEFT"/>Physical energy tracking retains this event type.<BR ALIGN="LEFT"/><B>FullyExtendedImplicitIntegrationStep</B><BR ALIGN="LEFT"/>One projected full-state map and one base record.<BR ALIGN="LEFT"/></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Builders adapt the same StepResult contract.<BR ALIGN="LEFT"/>Preserve times, states, map_state and tangents.<BR ALIGN="LEFT"/></TD></TR>
      </TABLE>
    >];
    MetricRow [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">ABBA STATISTIC EXTRACTION / ONE ADVANCE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>step_statistics(...)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">records.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> records.StepResult, include_substeps<BR ALIGN="LEFT"/><B>OUT</B> scalar/vector statistics mapping</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Sum corrections and residual evaluations.<BR ALIGN="LEFT"/>Select residual AND tolerance from the same solve<BR ALIGN="LEFT"/>with the largest normalized residual.<BR ALIGN="LEFT"/>Take the maximum multiplier infinity norm.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Optional vector columns count projections:<BR ALIGN="LEFT"/>ABBA2: one; ABBA4: one; ABBA6: seven.<BR ALIGN="LEFT"/>The common collector stacks accepted rows.</TD></TR>
      </TABLE>
    >];
  }

  subgraph cluster_output {
    label=""; style="rounded,filled"; color="#C4DDCF"; fillcolor="#F8FCFA";
    node [group="output"];
    PhaseOutput [fillcolor="#2E6651", color="#2E6651", fontcolor="white", margin="0.22,0.16", label="06  FINAL RESULT\nFinalize, validate and interpret the trajectory"];
    HistoryEntry [shape=point, width=0, height=0, style=invis];

    Data [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">COMMON FINAL ASSEMBLY</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>IntegrationData</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/simulation/_result.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Fields</B><BR ALIGN="LEFT"/>t: requested times [T]<BR ALIGN="LEFT"/>states: physical history [m, T]<BR ALIGN="LEFT"/>diagnostics: metadata + accepted metrics + auxiliary</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">run.export_history(times, collector.history)<BR ALIGN="LEFT"/>extracts the physical state and optional energy.<BR ALIGN="LEFT"/>Export never repeats the numerical projection.<BR ALIGN="LEFT"/>Internal and physical dimensions may differ.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Add output_interpolation_count and metric aliases.<BR ALIGN="LEFT"/>Return to the original SimulationRunner call.<BR ALIGN="LEFT"/>Only the requested trajectory is exposed by default.</TD></TR>
      </TABLE>
    >];
    Resume [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E2F1E9" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING CALL CONTINUATION / SAME RUNNER</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>SimulationRunner resumes</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#537866">src/simulation/runner.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>IN</B> IntegrationData<BR ALIGN="LEFT"/><B>OUT</B> Solution</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Require exactly the requested output times.<BR ALIGN="LEFT"/>Check shape, finiteness and packed layout.<BR ALIGN="LEFT"/>Verify that the initial state is preserved.<BR ALIGN="LEFT"/>Retain the source initial configuration.</TD></TR>
      </TABLE>
    >];
    Solution [label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD BGCOLOR="#E2F1E9" ALIGN="LEFT"><FONT POINT-SIZE="9">EXISTING PUBLIC CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Solution</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#537866">src/simulation/solution.py</FONT></TD></TR>
        <TR><TD ALIGN="LEFT"><B>Read-only public properties</B><BR ALIGN="LEFT"/>t: array[T]<BR ALIGN="LEFT"/>states: array[m, T]<BR ALIGN="LEFT"/>source: InitialConfiguration<BR ALIGN="LEFT"/>diagnostics: read-only mapping</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Owns copies of trajectory and diagnostic arrays.<BR ALIGN="LEFT"/>Layout and provenance remain available<BR ALIGN="LEFT"/>through the source configuration.</TD></TR>
      </TABLE>
    >];
    Interpret [fillcolor="#F1F8F4", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">OPTIONAL DOWNSTREAM CONSUMERS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Interpret and present</B></FONT></TD></TR><HR/>
        <TR><TD ALIGN="LEFT"><B>studies/</B> compares and summarizes runs.<BR ALIGN="LEFT"/><B>visualization/</B> builds plots and animations.<BR ALIGN="LEFT"/><B>diagnostics/</B> provides supported persistence.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">The calling notebook keeps scientific choices<BR ALIGN="LEFT"/>and interpretation explicit.<BR ALIGN="LEFT"/>These consumers do not advance the solution.</TD></TR>
      </TABLE>
    >];
    Failure [fillcolor="#FFF0F0", color="#D6A5A5", label=<
      <TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">FAILURE PATH</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Explicit error to caller</B></FONT></TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Invalid inputs or incompatible capabilities.<BR ALIGN="LEFT"/>Non-finite evaluations or singular systems.<BR ALIGN="LEFT"/>Nonlinear iteration limit reached.<BR ALIGN="LEFT"/>Invalid final output.</TD></TR><HR/>
        <TR><TD ALIGN="LEFT">Stop the run; do not construct a successful<BR ALIGN="LEFT"/>Solution from a failed integration.<BR ALIGN="LEFT"/>Retain method, time and solve context.</TD></TR>
      </TABLE>
    >];
  }

  Legend [shape=note, fillcolor="#F8FAFC", color="#CBD5E1", margin="0.18,0.14", label=<
    <B>HOW TO READ THIS DIAGRAM</B><BR/><BR/>
    Thick arrows between phase headers: overall lifecycle; phases 04 and 05 repeat together for each main step.<BR/>
    Thin solid arrows: calls or required data. Dotted blue arrows: returned values. Dashed purple arrows: optional events.<BR/>
    A hollow diamond means a record contains another record. Red dashed arrows indicate failure propagation.<BR/>
    Blue and green SHARED cards denote the same components in both diagrams; orange cards define the model step.<BR/><BR/>
    <B>PRESERVED NUMERICAL DISTINCTIONS</B><BR/>
    IntegrationMethod, integrate_method, FixedStepController and IntegrationCollector are shared by all numerical methods.<BR ALIGN="LEFT"/>_ABBAImplicitMethod, StatePolicy, projection kernels and numerical traces remain ABBA family components.<BR/>
    The generic StepResult holds state, statistics and opaque method details; ABBA details hold projection records. Each record retains a single-map or composed-map trace.<BR/>
    ABBA2: one projected map. ABBA4: one projection around three unprojected maps.<BR/>
    Projection placement remains part of the numerical method. Physical and extended equations keep their specialized algebra.<BR/>
    Physical auxiliary energy does not change z. Sampling and observation preserve main trajectories and solve statistics.
  >];

  // A common ordered parent fixes the six columns independently of return arrows.
  ColumnOrder [shape=point, width=0, height=0, style=invis, ordering=out];
  ColumnOrder -> PhasePhysics [style=invis, weight=1000];
  ColumnOrder -> PhaseDefinition [style=invis, weight=1000];
  ColumnOrder -> PhasePreparation [style=invis, weight=1000];
  ColumnOrder -> PhaseExecution [style=invis, weight=1000];
  ColumnOrder -> PhaseRecords [style=invis, weight=1000];
  ColumnOrder -> FinalPhaseLink [style=invis, weight=1000];
  ColumnOrder -> PhaseOutput [style=invis, weight=1000];

  // Global rows combine a horizontal lifecycle with vertically readable columns.
  { rank=same; PhasePhysics; PhaseDefinition; PhasePreparation; PhaseExecution; PhaseRecords; FinalPhaseLink; PhaseOutput; }
  { rank=same; HistoryExit; HistoryEntry; }
  { rank=same; Potential; Problem; Runner; Runtime; Recording; MetricsLink; Data; }
  { rank=same; Dynamics; Request; Prepare; Grid; StepResult; ObservationStart; Resume; }
  { rank=same; Initial; Method; RunMethod; Advance; ProjectedResult; Solution; }
  { rank=same; Layout; Configuration; StatePolicy; StepRecipe; Stats; Interpret; }
  { rank=same; FamilyResources; Projection; EventBuilder; ObservationEnd; }
  { rank=same; FailurePass; Failure; }
  { rank=same; Nonlinear; Events; }
  { rank=same; Maps; MetricRow; }

  PhasePhysics -> PhaseDefinition -> PhasePreparation -> PhaseExecution -> PhaseRecords [color="#334155", penwidth=2.4, weight=100];
  PhaseRecords -> FinalPhaseLink [color="#334155", penwidth=2.4, arrowhead=none, weight=100];
  FinalPhaseLink -> PhaseOutput [color="#334155", penwidth=2.4, weight=100];

  // Column guides only. Invisible links carry no execution semantics.
  PhasePhysics -> Potential [style=invis, weight=100];
  PhaseDefinition -> Problem -> Request -> Method -> Configuration [style=invis, weight=100];
  PhasePreparation -> Runner [style=invis, weight=100];
  PhaseExecution -> HistoryExit -> Runtime [style=invis, weight=100];
  PhaseRecords -> Recording -> StepResult -> ProjectedResult -> Stats -> EventBuilder -> Events [style=invis, weight=100];
  PhaseOutput -> HistoryEntry [style=invis, weight=100];
  EventBuilder -> FailurePass -> Events [style=invis, weight=100];
  FinalPhaseLink -> MetricsLink [style=invis, weight=1000];
  Dynamics -> Initial -> Layout [style=invis, weight=100];
  Solution -> Interpret -> Failure [style=invis, weight=100];

  // Inputs and preparation. Cross-column dependencies do not alter phase order.
  Potential -> Dynamics [label="gyroaverage(rho)", weight=100];
  Dynamics -> Problem [constraint=false, xlabel="equations"];
  Initial -> Problem [constraint=false, xlabel="initial state\nand layout"];
  Layout -> Initial [constraint=false, arrowhead=odiamond];
  Problem -> Runner [constraint=false, xlabel="problem"];
  Request -> Runner [constraint=false, xlabel="request"];
  Method -> Runner [constraint=false, xlabel="method"];
  Runner -> Prepare [label="inherited integrate\ncalls new_run + initialize", weight=100];
  Prepare -> RunMethod [color="#4676A7", style=dotted, label="initialized instance", weight=100];
  RunMethod -> StatePolicy [style=invis, weight=100];
  StatePolicy -> FamilyResources [constraint=false, arrowhead=odiamond, xlabel="state operations"];
  RunMethod -> Runtime [constraint=false, xlabel="method\ninstance"];

  StatePolicy -> FamilyResources [style=invis, weight=100];

  // Normal execution descends into the selected complete step and its solver.
  Runtime -> Grid [label="start main time loop", weight=100];
  Grid -> Advance [label="main advance or\nshadow sample", weight=100];
  Advance -> StepRecipe [label="run.solve_step", weight=100];
  StepRecipe -> Projection [label="selected map and projection", weight=100];
  Projection -> Nonlinear [label="residual + correction callbacks", weight=100];
  Nonlinear -> Maps [label="evaluate selected residual\nand requested tangent", weight=100];
  Nonlinear -> Nonlinear [constraint=false, color="#4676A7", style=dotted, label="correct unknown\nand repeat"];
  Advance -> StatePolicy [constraint=false, xlabel="unpack / finish"];

  // Returned records flow through one projection and the complete advance.
  Nonlinear -> Stats [constraint=false, color="#4676A7", style=dotted, xlabel="SolveStats"];
  Projection -> ProjectedResult [constraint=false, color="#4676A7", style=dotted, xlabel="accepted\nmap result"];
  Stats -> ProjectedResult [constraint=false, arrowhead=odiamond];
  ProjectedResult -> StepResult [constraint=false, arrowhead=odiamond, xlabel="exactly 1"];
  Advance -> StepResult [constraint=false, color="#4676A7", style=dotted, xlabel="completed\nadvance"];
  Grid -> StepResult [constraint=false, color="#4676A7", style=dotted, dir=back, arrowhead=none, arrowtail=normal];
  StepResult -> Recording [constraint=false, xlabel="accepted statistics"];
  StepResult -> ObservationStart [color="#9369B1", style=dashed, arrowhead=none, weight=100];
  ObservationStart -> ObservationEnd [color="#9369B1", style=dashed, arrowhead=none, xlabel="main step + observer", weight=1000];
  ObservationEnd -> EventBuilder [color="#9369B1", style=dashed, constraint=false];
  EventBuilder -> Events [color="#9369B1", style=dashed, xlabel="build event;\ncommon dispatch", weight=1000];

  Events -> MetricRow [style=invis, weight=100];

  // Completion re-enters the same public runner before exposing Solution.
  Runtime -> HistoryExit [constraint=false, color="#4676A7", style=dotted, arrowhead=none, xlabel="after tf"];
  HistoryExit -> HistoryEntry [color="#4676A7", style=dotted, arrowhead=none, xlabel="export_history(times, collector.history)", weight=20];
  HistoryEntry -> Data [color="#4676A7", style=dotted, weight=100];
  Recording -> MetricsLink [color="#4676A7", style=dotted, arrowhead=none, weight=100];
  MetricsLink -> Data [color="#4676A7", style=dotted, xlabel="final diagnostic\narrays", weight=100];
  Data -> Resume [label="return from method.integrate", weight=100];
  Resume -> Solution [label="validate and construct", weight=100];
  Solution -> Interpret [constraint=false, color="#60896D", style=dashed, xlabel="optional analysis / presentation"];
  Nonlinear -> FailurePass [constraint=false, color="#B96969", style=dashed, arrowhead=none];
  FailurePass -> Failure [constraint=false, color="#B96969", style=dashed, xlabel="failure: propagate error"];

  Maps -> Stages [label="selected kernel details", weight=100];
  Stages -> Legend [style=invis];
  Failure -> Legend [style=invis];
}
@enddot
