@startdot
digraph G {
  // Keep the graph identifier short: PlantUML Preview 2.18.1 only scans the
  // first 256 output bytes for the SVG tag generated by Graphviz.
  graph [
    rankdir=LR,
    compound=true,
    splines=ortho,
    nodesep=0.34,
    ranksep=0.78,
    pad=0.20,
    bgcolor="white",
    fontname="DejaVu Sans",
    fontsize=12,
    label="Canonical ABBA Models and 2 x 2 x 3 Configuration Runtime",
    labelloc="t",
    labeljust="c"
  ];
  node [shape=plain, fontname="DejaVu Sans", fontsize=10];
  edge [color="#333333", penwidth=1.0, arrowsize=0.72, fontname="DejaVu Sans", fontsize=9];

  subgraph cluster_inherited {
    label="Inherited dynamics boundary";
    labeljust="l";
    color="#777777";
    style="rounded";
    inherited_anchor [shape=point, width=0, height=0, label="", style=invis];

    GuidingCenterDynamics [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;implementation&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/dynamics/gc.py</FONT><BR/><B>GuidingCenterDynamics</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">state_dimension = 2<BR ALIGN="LEFT"/>vector_field(t, state)<BR ALIGN="LEFT"/>particle_vector_field_jacobians(...)<BR ALIGN="LEFT"/>extended_momentum_derivative(...)</TD></TR>
      </TABLE>
    >];
    GuidingCenterJacobianSystem [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;protocol&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/dynamics/protocols.py</FONT><BR/><B>GuidingCenterJacobianSystem</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">particle_vector_field_jacobians(...)</TD></TR>
      </TABLE>
    >];
    DynamicalSystem [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;protocol&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/dynamics/protocols.py</FONT><BR/><B>DynamicalSystem</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">state_dimension<BR ALIGN="LEFT"/>vector_field(t, state)</TD></TR>
      </TABLE>
    >];
    { rank=same; inherited_anchor; GuidingCenterDynamics; GuidingCenterJacobianSystem; DynamicalSystem; }
  }

  subgraph cluster_assembly {
    label="Run assembly";
    labeljust="l";
    color="#555555";
    penwidth=1.2;
    style="rounded";

    problem_anchor [shape=point, width=0, height=0, label="", style=invis];
    InitialValueProblem [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;value&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/problem.py</FONT><BR/><B>InitialValueProblem</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">Bind dynamics and configuration<BR ALIGN="LEFT"/>Validate state dimensions</TD></TR>
      </TABLE>
    >];
    { rank=same; problem_anchor; InitialValueProblem; }

    contracts_anchor [shape=point, width=0, height=0, label="", style=invis];
    InitialConfiguration [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;protocol&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/configuration.py</FONT><BR/><B>InitialConfiguration</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">initial_state<BR ALIGN="LEFT"/>layout: StateLayout</TD></TR>
      </TABLE>
    >];
    StateLayout [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;protocol&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/configuration.py</FONT><BR/><B>StateLayout</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">validate / split / particle_count<BR ALIGN="LEFT"/>positions(...)</TD></TR>
      </TABLE>
    >];
    { rank=same; contracts_anchor; InitialConfiguration; StateLayout; }

    gc_state_anchor [shape=point, width=0, height=0, label="", style=invis];
    GCInitialConfiguration [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;concrete&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/initial_conditions/gc.py</FONT><BR/><B>GCInitialConfiguration</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">layout: GCStateLayout<BR ALIGN="LEFT"/>from_components(x, y)</TD></TR>
      </TABLE>
    >];
    GCStateLayout [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;concrete layout&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/initial_conditions/gc.py</FONT><BR/><B>GCStateLayout</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">state_dimension = 2<BR ALIGN="LEFT"/>split(...) / positions(...)</TD></TR>
      </TABLE>
    >];
    { rank=same; gc_state_anchor; GCInitialConfiguration; GCStateLayout; }

    shared_state_anchor [shape=point, width=0, height=0, label="", style=invis];
    StateConfiguration [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;abstract storage&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/initial_conditions/base.py</FONT><BR/><B>StateConfiguration</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">initial_state<BR ALIGN="LEFT"/>abstract layout</TD></TR>
      </TABLE>
    >];
    PackedStateLayout [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;shared layout&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/initial_conditions/base.py</FONT><BR/><B>PackedStateLayout</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">validate / split / pack<BR ALIGN="LEFT"/>component-major state</TD></TR>
      </TABLE>
    >];
    { rank=same; shared_state_anchor; StateConfiguration; PackedStateLayout; }

    request_anchor [shape=point, width=0, height=0, label="", style=invis];
    SimulationRequest [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;value&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/request.py</FONT><BR/><B>SimulationRequest</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">t_span<BR ALIGN="LEFT"/>max_step<BR ALIGN="LEFT"/>output_times</TD></TR>
      </TABLE>
    >];
    { rank=same; request_anchor; SimulationRequest; }

    runner_anchor [shape=point, width=0, height=0, label="", style=invis];
    SimulationRunner [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;facade&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/runner.py</FONT><BR/><B>SimulationRunner</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">simulate(problem, method, request)<BR ALIGN="LEFT"/>Validate and delegate</TD></TR>
      </TABLE>
    >];
    { rank=same; runner_anchor; SimulationRunner; }

    protocol_anchor [shape=point, width=0, height=0, label="", style=invis];
    NumericalMethod [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F7F7F7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;protocol&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/methods/base.py</FONT><BR/><B>NumericalMethod</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">integrate(problem, request)</TD></TR>
      </TABLE>
    >];
    { rank=same; protocol_anchor; NumericalMethod; }
  }

  subgraph cluster_configuration {
    label="Five public ABBA models and canonical configuration";
    labeljust="l";
    color="#6C5B7B";
    penwidth=1.2;
    style="rounded";

    methods_anchor [shape=point, width=0, height=0, label="", style=invis];
    MidpointMethod [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3ECF7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;public method&#187;</I></FONT><BR/><FONT POINT-SIZE="9">order2_midpoint.py</FONT><BR/><B>ABBA2Midpoint</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">Arithmetic mean<BR ALIGN="LEFT"/>No residual or nonlinear solver</TD></TR>
      </TABLE>
    >];
    ImplicitMethods [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#F3ECF7">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;four public methods&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/methods/abba/</FONT></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT"><B>ABBA2Implicit</B><BR ALIGN="LEFT"/><B>ABBA4Implicit</B><BR ALIGN="LEFT"/><B>ABBA4ImplicitSingleProjection</B><BR ALIGN="LEFT"/><B>ABBA6Implicit</B></TD></TR>
      </TABLE>
    >];
    { rank=same; methods_anchor; MidpointMethod; ImplicitMethods; }

    axes_anchor [shape=point, width=0, height=0, label="", style=invis];
    MidpointAxes [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FBF7FD">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;midpoint axis&#187;</I></FONT><BR/><B>3 configurations</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">state_extension:<BR ALIGN="LEFT"/>physical<BR ALIGN="LEFT"/>shared_time<BR ALIGN="LEFT"/>fully_extended</TD></TR>
      </TABLE>
    >];
    ImplicitAxes [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#FBF7FD">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;implicit configuration base&#187;</I></FONT><BR/><FONT POINT-SIZE="9">_configuration.py / _implicit.py</FONT><BR/><B>_ABBAImplicitConfig</B><BR/><B>2 x 2 x 3 = 12 per class</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">projection_formulation: 2<BR ALIGN="LEFT"/>nonlinear_solver: 2<BR ALIGN="LEFT"/>state_extension: 3<BR ALIGN="LEFT"/><B>Global for every substep</B></TD></TR>
      </TABLE>
    >];
    CountNote [shape=note, style="filled", fillcolor="#FFFDEB", color="#B8AE6F", margin="0.10,0.07", label="Exactly five public classes\n3 + (4 x 12) = 51 valid configurations"];
    { rank=same; axes_anchor; MidpointAxes; ImplicitAxes; CountNote; }

    dimensions_anchor [shape=point, width=0, height=0, label="", style=invis];
    DimensionMatrix [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#FFFFFF">
        <TR><TD><B>state_extension</B></TD><TD><B>accepted</B></TD><TD><B>base split</B></TD><TD><B>reduced</B></TD><TD><B>simultaneous</B></TD></TR>
        <TR><TD ALIGN="LEFT">physical</TD><TD>R<SUP>2</SUP></TD><TD>R<SUP>4</SUP></TD><TD>R<SUP>2</SUP></TD><TD>R<SUP>6</SUP></TD></TR>
        <TR><TD ALIGN="LEFT">shared_time</TD><TD>R<SUP>4</SUP></TD><TD>R<SUP>6</SUP></TD><TD>R<SUP>2</SUP></TD><TD>R<SUP>6</SUP></TD></TR>
        <TR><TD ALIGN="LEFT">fully_extended</TD><TD>R<SUP>4</SUP></TD><TD>R<SUP>8</SUP></TD><TD>R<SUP>4</SUP></TD><TD>R<SUP>12</SUP></TD></TR>
        <TR><TD COLSPAN="5"><FONT POINT-SIZE="8">One-particle dimensions; physical N-particle columns scale as 2N / 4N / 2N / 6N.</FONT></TD></TR>
        <TR><TD COLSPAN="5"><FONT POINT-SIZE="8">shared_time and fully_extended require N=1; midpoint has no nonlinear unknown.</FONT></TD></TR>
      </TABLE>
    >];
    { rank=same; dimensions_anchor; DimensionMatrix; }
  }

  subgraph cluster_integration {
    label="Configured ABBA integration";
    labeljust="l";
    color="#4F7D63";
    penwidth=1.2;
    style="rounded";

    fixed_anchor [shape=point, width=0, height=0, label="", style=invis];
    FixedGrid [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;outer time loop&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/_fixed.py</FONT><BR/><B>integrate_fixed_grid(...)</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">Uniform main grid<BR ALIGN="LEFT"/>Main and shadow advances</TD></TR>
      </TABLE>
    >];
    { rank=same; fixed_anchor; FixedGrid; }

    extension_anchor [shape=point, width=0, height=0, label="", style=invis];
    ExtensionStrategy [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;state dispatch&#187;</I></FONT><BR/><B>state_extension</B></TD><TD><B>Runtime strategy</B></TD></TR>
        <TR><TD ALIGN="LEFT">physical</TD><TD ALIGN="LEFT">duplicate z</TD></TR>
        <TR><TD ALIGN="LEFT">shared_time</TD><TD ALIGN="LEFT">share (t,k), accept kappa=k/2</TD></TR>
        <TR><TD ALIGN="LEFT">fully_extended</TD><TD ALIGN="LEFT">duplicate Z=(z,t,k), direct k</TD></TR>
      </TABLE>
    >];
    { rank=same; extension_anchor; ExtensionStrategy; }

    composition_anchor [shape=point, width=0, height=0, label="", style=invis];
    CompositionPolicy [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;method policy&#187;</I></FONT><BR/><B>Method</B></TD><TD><B>ABBA maps</B></TD><TD><B>Projection placement</B></TD></TR>
        <TR><TD ALIGN="LEFT">ABBA2Midpoint</TD><TD>1</TD><TD ALIGN="LEFT">mean after map</TD></TR>
        <TR><TD ALIGN="LEFT">ABBA2Implicit</TD><TD>1</TD><TD ALIGN="LEFT">after map</TD></TR>
        <TR><TD ALIGN="LEFT">ABBA4Implicit</TD><TD>3</TD><TD ALIGN="LEFT">after each map</TD></TR>
        <TR><TD ALIGN="LEFT">ABBA4ImplicitSingleProjection</TD><TD>3</TD><TD ALIGN="LEFT">once around composition</TD></TR>
        <TR><TD ALIGN="LEFT">ABBA6Implicit</TD><TD>7</TD><TD ALIGN="LEFT">after each map</TD></TR>
      </TABLE>
    >];
    { rank=same; composition_anchor; CompositionPolicy; }

    stage_anchor [shape=point, width=0, height=0, label="", style=invis];
    StageKernel [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;A-B-B-A map&#187;</I></FONT><BR/><B>Extension-specific stage kernel</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">physical/shared: abba/_core.py<BR ALIGN="LEFT"/>fully extended: methods/_fully_extended.py<BR ALIGN="LEFT"/>Use signed composition duration</TD></TR>
      </TABLE>
    >];
    { rank=same; stage_anchor; StageKernel; }

    projection_anchor [shape=point, width=0, height=0, label="", style=invis];
    ProjectionPolicy [label=<
      <TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="4" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;projection dispatch&#187;</I></FONT><BR/><B>Method branch</B></TD><TD><B>Policy</B></TD></TR>
        <TR><TD ALIGN="LEFT">midpoint</TD><TD ALIGN="LEFT">arithmetic mean; bypass nonlinear solve</TD></TR>
        <TR><TD ALIGN="LEFT">implicit</TD><TD ALIGN="LEFT">reduced_multiplier or simultaneous_state_multiplier</TD></TR>
        <TR><TD COLSPAN="2"><FONT POINT-SIZE="8">The implicit formulations have the same exact root at convergence.</FONT></TD></TR>
      </TABLE>
    >];
    { rank=same; projection_anchor; ProjectionPolicy; }

    solver_anchor [shape=point, width=0, height=0, label="", style=invis];
    NonlinearSolver [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;implicit only&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/methods/_nonlinear.py</FONT><BR/><B>nonlinear_solver</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">newton: exact Jacobian<BR ALIGN="LEFT"/>broyden: residual-only secant update<BR ALIGN="LEFT"/>Repeat until tolerance</TD></TR>
      </TABLE>
    >];
    { rank=same; solver_anchor; NonlinearSolver; }

    accepted_anchor [shape=point, width=0, height=0, label="", style=invis];
    AcceptedState [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF6EE">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;accepted step&#187;</I></FONT><BR/><B>Physical sample and diagnostics</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">Return z to sampled history<BR ALIGN="LEFT"/>Retain t, kappa, or k in diagnostics<BR ALIGN="LEFT"/>Observer: physical/shared R<SUP>2</SUP>; fully R<SUP>4</SUP><BR ALIGN="LEFT"/>Record formulation and dimensions</TD></TR>
      </TABLE>
    >];
    { rank=same; accepted_anchor; AcceptedState; }
  }

  subgraph cluster_result {
    label="Result boundary";
    labeljust="l";
    color="#555555";
    penwidth=1.2;
    style="rounded";

    data_anchor [shape=point, width=0, height=0, label="", style=invis];
    IntegrationData [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;internal value&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/_result.py</FONT><BR/><B>IntegrationData</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">Requested times<BR ALIGN="LEFT"/>Physical states<BR ALIGN="LEFT"/>Method diagnostics</TD></TR>
      </TABLE>
    >];
    { rank=same; data_anchor; IntegrationData; }

    return_anchor [shape=point, width=0, height=0, label="", style=invis];
    RunnerReturn [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;facade continuation&#187;</I></FONT><BR/><B>Return to SimulationRunner</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">Validate arrays<BR ALIGN="LEFT"/>Build Solution</TD></TR>
      </TABLE>
    >];
    { rank=same; return_anchor; RunnerReturn; }

    solution_anchor [shape=point, width=0, height=0, label="", style=invis];
    Solution [label=<
      <TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" BGCOLOR="#EAF2F8">
        <TR><TD><FONT POINT-SIZE="9"><I>&#171;public result&#187;</I></FONT><BR/><FONT POINT-SIZE="9">src/simulation/solution.py</FONT><BR/><B>Solution</B></TD></TR>
        <HR/>
        <TR><TD ALIGN="LEFT">Read-only physical trajectory<BR ALIGN="LEFT"/>Read-only diagnostics<BR ALIGN="LEFT"/>Initial configuration and layout</TD></TR>
      </TABLE>
    >];
    { rank=same; solution_anchor; Solution; }
  }

  // One invisible high-weight spine fixes the temporal reading order. All
  // semantic relationships are constraint-free, preventing label overlap.
  inherited_anchor -> problem_anchor -> contracts_anchor -> gc_state_anchor -> shared_state_anchor -> request_anchor -> runner_anchor -> protocol_anchor -> methods_anchor -> axes_anchor -> dimensions_anchor -> fixed_anchor -> extension_anchor -> composition_anchor -> stage_anchor -> projection_anchor -> solver_anchor -> accepted_anchor -> data_anchor -> return_anchor -> solution_anchor [style=invis, weight=1000, minlen=2];

  // Structural relationships.
  GuidingCenterDynamics -> GuidingCenterJacobianSystem [style=dashed, arrowhead=empty, constraint=false];
  GuidingCenterJacobianSystem -> DynamicalSystem [style=solid, arrowhead=empty, constraint=false];
  GCInitialConfiguration -> StateConfiguration [style=solid, arrowhead=empty, constraint=false];
  GCStateLayout -> PackedStateLayout [style=solid, arrowhead=empty, constraint=false];
  GCInitialConfiguration -> InitialConfiguration [style=dashed, arrowhead=empty, constraint=false];
  GCStateLayout -> StateLayout [style=dashed, arrowhead=empty, constraint=false];
  InitialConfiguration -> StateLayout [dir=both, arrowtail=odiamond, arrowhead=none, constraint=false];
  GCInitialConfiguration -> GCStateLayout [dir=both, arrowtail=odiamond, arrowhead=none, constraint=false];
  MidpointMethod -> NumericalMethod [style=dashed, arrowhead=empty, constraint=false];
  ImplicitMethods -> NumericalMethod [style=dashed, arrowhead=empty, constraint=false];

  // Public assembly and configured method dispatch.
  DynamicalSystem -> InitialValueProblem [arrowhead=normal, constraint=false];
  InitialConfiguration -> InitialValueProblem [arrowhead=normal, constraint=false];
  InitialValueProblem -> SimulationRunner [arrowhead=normal, constraint=false];
  SimulationRequest -> SimulationRunner [arrowhead=normal, constraint=false];
  NumericalMethod -> SimulationRunner [arrowhead=normal, constraint=false];
  SimulationRunner -> MidpointMethod [arrowhead=normal, constraint=false];
  SimulationRunner -> ImplicitMethods [arrowhead=normal, constraint=false];
  MidpointMethod -> MidpointAxes [arrowhead=normal, constraint=false];
  ImplicitMethods -> ImplicitAxes [arrowhead=normal, constraint=false];
  MidpointAxes -> DimensionMatrix [arrowhead=normal, constraint=false];
  ImplicitAxes -> DimensionMatrix [arrowhead=normal, constraint=false];

  // Numerical flow. Midpoint deliberately bypasses the nonlinear solver.
  DimensionMatrix -> FixedGrid [arrowhead=normal, constraint=false];
  FixedGrid -> ExtensionStrategy [arrowhead=normal, constraint=false];
  ExtensionStrategy -> CompositionPolicy [arrowhead=normal, constraint=false];
  CompositionPolicy -> StageKernel [arrowhead=normal, constraint=false];
  StageKernel -> ProjectionPolicy [arrowhead=normal, constraint=false];
  ProjectionPolicy -> NonlinearSolver [arrowhead=normal, constraint=false];
  NonlinearSolver -> AcceptedState [arrowhead=normal, constraint=false];
  ProjectionPolicy -> AcceptedState [style=dashed, arrowhead=normal, constraint=false];

  // Result hand-off.
  AcceptedState -> IntegrationData [arrowhead=normal, constraint=false];
  IntegrationData -> RunnerReturn [arrowhead=normal, constraint=false];
  RunnerReturn -> Solution [arrowhead=normal, constraint=false];
}
@enddot
