@startdot
digraph architecture {
  graph [rankdir=TB, bgcolor="#f8fafc"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans"];
  recipe [label="Composition recipe\nadjoint(h/2), direct(h/2)\nNo harmonic coupling", fillcolor="#fff0d9"];
  method [label="ABBA2Implicit\nExports: simulation / methods.extended\nImplementation: src/methods/extended/", fillcolor="#e5ecfa"];
  driver [label="Simulation + integration\nsrc/simulation/runner.py and src/integration/\nMain steps, output sampling, collection", fillcolor="#e5ecfa"];
  state [label="DoubledFormulation\nsrc/formulations/state.py\nTwo copies; optional time and kappa", fillcolor="#e5ecfa"];
  advance [label="advance\nBound recipe and projection configuration\nOne accepted numerical result", fillcolor="#e5ecfa"];
  energy [label="Passive energy and outputs\nenergy.py: accepted shear quadrature\nH + kappa; no feedback into the root", fillcolor="#e1f0e6"];
  observe [label="Optional observations\nsrc/contracts/observation.py\nIndependent accepted records and counters", fillcolor="#f0e5f5"];
  projection [label="solve_projection\nprojection.py\nSpatial Hairer equation", fillcolor="#e1f0e6"];
  solver [label="Newton / Broyden\n_nonlinear.py: shared convergence and work\nTime and momentum excluded from roots", fillcolor="#fff0d9"];
  placement [label="Method identity\nOne spatial projection per step\nReduced or simultaneous equation", fillcolor="#fff0d9"];
  compose [label="compose\ncomposition.py: signed stage clock\nAccepted trace reused by all consumers", fillcolor="#e1f0e6"];
  tangent [label="Analytic tangents\njacobians.py: particle blocks and chain rule\nBroyden does not evaluate Jacobians", fillcolor="#e1f0e6"];
  maps [label="GCDoubledMaps\ndirect_map / adjoint_map\nSpatial shears and optional coupling", fillcolor="#e1f0e6"];
  dynamics [label="Physical dynamics\nVector field, analytic derivatives, H and partial_t H\nExisting dynamics and potential contracts", fillcolor="#e5ecfa"];
  recipe -> method;
  method -> driver;
  driver -> advance;
  state -> advance;
  advance -> projection;
  advance -> energy;
  advance -> observe;
  projection -> compose;
  projection -> solver;
  compose -> tangent;
  compose -> maps;
  maps -> dynamics;
}
@enddot
