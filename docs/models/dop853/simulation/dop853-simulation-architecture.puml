@startdot
digraph architecture {
  graph [rankdir=TB, bgcolor="#f8fafc"];
  node [shape=box, style="rounded,filled", fontname="DejaVu Sans"];
  recipe [label="Numerical scheme\nSciPy adaptive explicit stages", fillcolor="#fff0d9"];
  method [label="SciPy DOP853\nStandalone reference solver\nOutside the GC2D simulation API", fillcolor="#e5ecfa"];
  driver [label="Reference study\nOwn initial data, controls and requested times\nCollect physical history and SciPy counters", fillcolor="#e5ecfa"];
  state [label="Initial physical values\nPacked component-major vector (d*N,)\nIndependent particle positions and velocities", fillcolor="#e5ecfa"];
  advance [label="SciPy advancement\nAccepted physical state and dense interpolant\nRejected trials stay inside SciPy", fillcolor="#e5ecfa"];
  energy [label="Historical energy studies\nOptional accepted-interpolant quadrature\nSeparate from endpoint EnergyObserver", fillcolor="#e1f0e6"];
  observe [label="Study progress\nAccepted time, evaluations and status\nCaller-owned progress callback", fillcolor="#f0e5f5"];
  projection [label="Adaptive step\nOne retained SciPy numerical session", fillcolor="#e1f0e6"];
  solver [label="SciPy adaptive control\nStudy supplies atol / rtol and max_step\nPhysical-state error and acceptance", fillcolor="#fff0d9"];
  placement [label="Reference audit\nRefine maximum step or compare solvers\nMeasure trajectory discrepancy", fillcolor="#fff0d9"];
  compose [label="Physical evaluations\nPhysical vector-field and optional derivative calls\nNo Hamiltonian or momentum evaluation", fillcolor="#e1f0e6"];
  tangent [label="Sampling\nAccepted dense output", fillcolor="#e1f0e6"];
  maps [label="Accepted numerical data\nDense interpolant for passive quadrature", fillcolor="#e1f0e6"];
  dynamics [label="Physical dynamics\nNumPy vector field and optional Jacobian\nPreserve the interpolated physical model", fillcolor="#e5ecfa"];
  recipe -> method;
  method -> driver;
  driver -> advance;
  state -> advance;
  advance -> projection;
  driver -> energy;
  advance -> observe;
  projection -> compose;
  projection -> solver;
  compose -> tangent;
  compose -> maps;
  maps -> dynamics;
}
@enddot
