@startdot
digraph CurrentPackageIntegration {
  // Canonical editable source. Render SVG/PNG with scripts/render_detailed_architecture.cjs.
  // Source columns indicate ownership. Numbered EXECUTION cards indicate runtime order.
  // The compact package overview and the _old lifecycle remain separate artifacts.
  graph [rankdir=TB, newrank=true, compound=true, splines=polyline,
    nodesep=0.60, ranksep=0.62, pad=0.35, bgcolor="#FFFFFF",
    fontname="DejaVu Sans", fontsize=25, labelloc=t, labeljust=l,
    label="GC2D | Detailed package and integration architecture\n\nEight source owners, from physical field to immutable trajectory. Read each column vertically; follow numbered EXECUTION cards for runtime order.\nBlue: shared lifecycle and contracts. Orange: method configuration. Green: numerical operations and results. Purple: optional observation and analysis.\nN = particle count; m = physical state size; q = internal state size; T = requested saved times. Module paths are relative to the repository root."];
  node [shape=box, style="rounded,filled", fillcolor="#FFFFFF", color="#C4CFDC",
    penwidth=1.15, margin="0.02,0.02", fontname="DejaVu Sans", fontsize=11];
  edge [color="#64748B", penwidth=1.2, arrowsize=0.75,
    fontname="DejaVu Sans", fontsize=10];
  subgraph cluster_potential {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="potential"];
    Head_potential [fillcolor="#263D59", color="#263D59", fontcolor="white", width=4.8, height=0.68, margin="0.22,0.16", label="01  potential/\nPhysical field and input data"];
    Potential [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">PHYSICAL FIELD / PUBLIC CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Potential</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/potential/potential.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Data and construction</B><BR ALIGN="LEFT"/>Grid; spatial mode amplitudes; time dependence.<BR ALIGN="LEFT"/>Construct from data or Potential.random(...).</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>evaluate(t, x, y, dx, dy, dt)<BR ALIGN="LEFT"/>electric_field(t, x, y); gyroaverage(rho)</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Ownership</B><BR ALIGN="LEFT"/>Interpolation and field derivatives live here.<BR ALIGN="LEFT"/>Dynamics consumes the same physical field.</TD></TR>
      </TABLE>
    >];
    H5Loader [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">MEASURED FIELD ADAPTER</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>load_gc2d_h5_potential</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/potential/gc2d_h5.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Input</B><BR ALIGN="LEFT"/>HDF5 field, magnetic field, characteristic length,<BR ALIGN="LEFT"/>source selection and interpolation settings.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Output</B><BR ALIGN="LEFT"/>Potential with attached GC2DH5Metadata.<BR ALIGN="LEFT"/>Normalize measured coordinates and field data.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Reproducibility</B><BR ALIGN="LEFT"/>Study parameters remain explicit at the caller.<BR ALIGN="LEFT"/>Metadata describes the loaded physical source.</TD></TR>
      </TABLE>
    >];
    Grid [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">PERIODIC GEOMETRY / PUBLIC CLASS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Grid</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/potential/grid.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Geometry</B><BR ALIGN="LEFT"/>Periodic spatial axes; shape and spacing.<BR ALIGN="LEFT"/>Grid.periodic(nx, ny, period).</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operation</B><BR ALIGN="LEFT"/>normalize(x, y): wrap coordinates into the cell.<BR ALIGN="LEFT"/>Potential owns interpolation on this grid.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Boundary</B><BR ALIGN="LEFT"/>Physical periodicity is separate from the<BR ALIGN="LEFT"/>integration time grid and output sample grid.</TD></TR>
      </TABLE>
    >];
    Pad_potential_3 [shape=point, width=0, height=0, style=invis];
    Pad_potential_4 [shape=point, width=0, height=0, style=invis];
    Pad_potential_5 [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_dynamics {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="dynamics"];
    Head_dynamics [fillcolor="#263D59", color="#263D59", fontcolor="white", width=4.8, height=0.68, margin="0.22,0.16", label="02  dynamics/\nPhysical equations and capabilities"];
    Dynamics [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">PHYSICAL PROTOCOL</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>DynamicalSystem</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/dynamics/protocols.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Required interface</B><BR ALIGN="LEFT"/>state_dimension: coordinates per particle.<BR ALIGN="LEFT"/>vector_field(t, state): packed derivative [m].</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Consumers</B><BR ALIGN="LEFT"/>Classical and adaptive methods evaluate the field.<BR ALIGN="LEFT"/>Split formulations consume applicable capabilities.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Boundary</B><BR ALIGN="LEFT"/>Physics is independent of initial geometry,<BR ALIGN="LEFT"/>step size, solver tolerances and saved history.</TD></TR>
      </TABLE>
    >];
    GC [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">CONCRETE PHYSICAL SYSTEM</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GuidingCenterDynamics</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/dynamics/gc.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Construction</B><BR ALIGN="LEFT"/>potential: Potential; rho: normalized gyro-radius.<BR ALIGN="LEFT"/>effective_potential = potential.gyroaverage(rho).</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>vector_field; hamiltonian; momentum derivative.<BR ALIGN="LEFT"/>particle_vector_field_jacobians: [N, 2, 2].</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Coordinates</B><BR ALIGN="LEFT"/>N uncoupled planar particles; m = 2N.<BR ALIGN="LEFT"/>Field uses the gyroaveraged electric potential.</TD></TR>
      </TABLE>
    >];
    FC [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">CONCRETE PHYSICAL SYSTEM</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>FullCyclotronDynamics</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/dynamics/fc.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Coordinates</B><BR ALIGN="LEFT"/>Positions and velocities; m = 4N.<BR ALIGN="LEFT"/>Cyclotron parameters remain physical inputs.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>vector_field; hamiltonian; momentum derivative.<BR ALIGN="LEFT"/>electric_acceleration; larmor_frequency.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Capability</B><BR ALIGN="LEFT"/>CyclotronSplitSystem supports exact FC splits.<BR ALIGN="LEFT"/>Numerical families check their required interface.</TD></TR>
      </TABLE>
    >];
    Capabilities [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EDFF" ALIGN="LEFT"><FONT POINT-SIZE="9">OPTIONAL PHYSICAL CAPABILITIES</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Hamiltonian and Jacobians</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/dynamics/protocols.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>HamiltonianSystem</B><BR ALIGN="LEFT"/>hamiltonian(t, state): values per particle.<BR ALIGN="LEFT"/>extended_momentum_derivative = -partial_t H.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>GuidingCenterJacobianSystem</B><BR ALIGN="LEFT"/>particle_vector_field_jacobians(t, state).<BR ALIGN="LEFT"/>Analytic particle blocks for supported solvers.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Validation owner</B><BR ALIGN="LEFT"/>State formulations require HamiltonianSystem<BR ALIGN="LEFT"/>when track_energy=True. Methods check split<BR ALIGN="LEFT"/>and Jacobian capabilities where needed.</TD></TR>
      </TABLE>
    >];
    Pad_dynamics_4 [shape=point, width=0, height=0, style=invis];
    Pad_dynamics_5 [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_initial {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="initial"];
    Head_initial [fillcolor="#263D59", color="#263D59", fontcolor="white", width=4.8, height=0.68, margin="0.22,0.16", label="03  initial_conditions/\nInitial state and packed layout"];
    Initial [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">BASE INITIAL CONFIGURATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>StateConfiguration</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/base.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>State</B><BR ALIGN="LEFT"/>initial_state: finite packed physical vector [m].<BR ALIGN="LEFT"/>layout: matching PackedStateLayout.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Construction</B><BR ALIGN="LEFT"/>set_initial_state validates and copies the vector.<BR ALIGN="LEFT"/>Concrete geometry supplies the physical layout.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Assembly</B><BR ALIGN="LEFT"/>The caller combines this configuration and<BR ALIGN="LEFT"/>dynamics in InitialValueProblem (contracts/).</TD></TR>
      </TABLE>
    >];
    InitialModels [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">CONCRETE INITIAL CONFIGURATIONS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GC / FC initial configuration</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/gc.py; fc.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Guiding center</B><BR ALIGN="LEFT"/>GCInitialConfiguration.from_components(x, y).<BR ALIGN="LEFT"/>Packed state: [x_1,...,x_N, y_1,...,y_N].</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Full cyclotron</B><BR ALIGN="LEFT"/>FCInitialConfiguration.from_components(...).<BR ALIGN="LEFT"/>Packed blocks: x, y, vx, vy.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Boundary</B><BR ALIGN="LEFT"/>These objects define starting geometry.<BR ALIGN="LEFT"/>The dynamics supplies subsequent motion.</TD></TR>
      </TABLE>
    >];
    Layouts [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">CONCRETE LAYOUT IMPLEMENTATIONS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>PackedStateLayout</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/base.py; gc.py; fc.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>split; as_blocks; from_blocks; pack_components.<BR ALIGN="LEFT"/>validate_packed_state_layout; particle_count.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Convention</B><BR ALIGN="LEFT"/>Each coordinate block contains all N particles.<BR ALIGN="LEFT"/>Trailing sample axes are preserved.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Shared contract</B><BR ALIGN="LEFT"/>Implements contracts.configuration.StateLayout.<BR ALIGN="LEFT"/>Solution retains the source layout for interpretation.</TD></TR>
      </TABLE>
    >];
    Area [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E8EFF8" ALIGN="LEFT"><FONT POINT-SIZE="9">OPTIONAL GEOMETRIC CONFIGURATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Area</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/initial_conditions/area.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Construction</B><BR ALIGN="LEFT"/>GCInitialConfiguration subclass.<BR ALIGN="LEFT"/>Area.square(...) and Area.circle(...).</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>Initial boundary points and area calculation.<BR ALIGN="LEFT"/>Same packed GC state as other configurations.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Boundary</B><BR ALIGN="LEFT"/>Geometry does not own an integration loop.<BR ALIGN="LEFT"/>Studies choose initial positions and sampling.</TD></TR>
      </TABLE>
    >];
    Pad_initial_4 [shape=point, width=0, height=0, style=invis];
    Pad_initial_5 [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_formulations {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="formulations"];
    Head_formulations [fillcolor="#2E6651", color="#2E6651", fontcolor="white", width=4.8, height=0.68, margin="0.22,0.16", label="04  formulations/\nInternal coordinates and numerical maps"];
    Physical [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E2F1E9" ALIGN="LEFT"><FONT POINT-SIZE="9">STATE REPRESENTATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>PhysicalFormulation</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/formulations/state.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Bound inputs</B><BR ALIGN="LEFT"/>problem; initial_time; track_energy.<BR ALIGN="LEFT"/>One spatial copy; m physical coordinates.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>initial_state; pack; physical; finish; metadata.<BR ALIGN="LEFT"/>extract_history(times, history): physical + auxiliary.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Planar GC dimensions</B><BR ALIGN="LEFT"/>Without tracking: q = 2N.<BR ALIGN="LEFT"/>With per-particle time and kappa: q = 4N.</TD></TR>
      </TABLE>
    >];
    Doubled [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E2F1E9" ALIGN="LEFT"><FONT POINT-SIZE="9">SHARED ABBA / BM4 STATE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>DoubledFormulation</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/formulations/state.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Representation</B><BR ALIGN="LEFT"/>PhysicalFormulation subclass with two copies.<BR ALIGN="LEFT"/>GC internal size: q = 4N, or 6N with energy.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Invariant</B><BR ALIGN="LEFT"/>Accepted projected states have identical copies.<BR ALIGN="LEFT"/>Off-diagonal states occur inside the spatial maps.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Projection scope</B><BR ALIGN="LEFT"/>Only spatial differences enter the projection.<BR ALIGN="LEFT"/>Time and kappa remain passive coordinates.</TD></TR>
      </TABLE>
    >];
    Maps [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E2F1E9" ALIGN="LEFT"><FONT POINT-SIZE="9">BOUND GC DIRECT / ADJOINT MAPS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>GCDoubledMaps</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/formulations/gc.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Inputs</B><BR ALIGN="LEFT"/>InitialValueProblem and coupling_frequency.<BR ALIGN="LEFT"/>Spatial doubled state and signed stage duration.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Operations</B><BR ALIGN="LEFT"/>direct_map(duration, t, state)<BR ALIGN="LEFT"/>adjoint_map(duration, t, state)</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Numerics</B><BR ALIGN="LEFT"/>Spatial shears evaluate the physical dynamics.<BR ALIGN="LEFT"/>Optional harmonic coupling mixes the copies.<BR ALIGN="LEFT"/>Accepted shear inputs support energy and tangents.</TD></TR>
      </TABLE>
    >];
    Passive [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E2F1E9" ALIGN="LEFT"><FONT POINT-SIZE="9">STATE EXTRACTION / ENERGY BALANCE</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Passive time and momentum</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/formulations/state.py; base.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Dynamics</B><BR ALIGN="LEFT"/>d kappa / dt = -partial_t H; one value per particle.<BR ALIGN="LEFT"/>Time blocks follow the prescribed integration time.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Output</B><BR ALIGN="LEFT"/>extract_history separates physical samples from<BR ALIGN="LEFT"/>extended_time, kappa and Hamiltonian diagnostics.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Invariant</B><BR ALIGN="LEFT"/>Energy tracking does not alter the physical root<BR ALIGN="LEFT"/>or adaptive physical error control.</TD></TR>
      </TABLE>
    >];
    SplitContracts [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#E2F1E9" ALIGN="LEFT"><FONT POINT-SIZE="9">FORMULATION PROTOCOLS / OTHER SPLITS</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>Prepared direct / adjoint maps</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/formulations/base.py; gc.py; fc.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Interface</B><BR ALIGN="LEFT"/>DirectAdjointFormulation.prepare(problem, ...).<BR ALIGN="LEFT"/>Prepared maps expose direct_map / adjoint_map.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Available implementations</B><BR ALIGN="LEFT"/>GCExtendedFormulation; GCStageProjectedFormulation.<BR ALIGN="LEFT"/>FCSplitFormulation binds cyclotron split maps.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Current ABBA / BM4 path</B><BR ALIGN="LEFT"/>Methods bind GCDoubledMaps directly and use<BR ALIGN="LEFT"/>DoubledFormulation for accepted state and export.</TD></TR>
      </TABLE>
    >];
    Pad_formulations_5 [shape=point, width=0, height=0, style=invis];
  }
  subgraph cluster_methods {
    label=""; style="rounded,filled"; color="#C8D6E7"; fillcolor="#F8FAFD";
    node [group="methods"];
    Head_methods [fillcolor="#815E22", color="#815E22", fontcolor="white", width=4.8, height=0.68, margin="0.22,0.16", label="05  methods/\nMethod configuration and complete step"];
    Families [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#FBE0C7" ALIGN="LEFT"><FONT POINT-SIZE="9">PUBLIC NUMERICAL FAMILIES</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>13 public methods</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/methods/{classical,adaptive,hbvm,extended}/</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Classical / adaptive / HBVM</B><BR ALIGN="LEFT"/>ExplicitEuler; RK4; GaussLegendre4; SDIRK4.<BR ALIGN="LEFT"/>DOP853; Radau; HBVM42.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Extended family</B><BR ALIGN="LEFT"/>ABBA2Implicit; ABBA4Implicit; ABBA6Implicit.<BR ALIGN="LEFT"/>ABBA2Midpoint; BM4Implicit; BM4Midpoint.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Common lifecycle</B><BR ALIGN="LEFT"/>All extend IntegrationMethod. Public options are<BR ALIGN="LEFT"/>reusable; resources are initialized for each run.</TD></TR>
      </TABLE>
    >];
    Initialize [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
        <TR><TD WIDTH="330" BALIGN="LEFT" BGCOLOR="#FBE0C7" ALIGN="LEFT"><FONT POINT-SIZE="9">EXECUTION 3 / METHOD PREPARATION</FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="15"><B>method.initialize(problem, request)</B></FONT><BR ALIGN="LEFT"/><FONT POINT-SIZE="10" COLOR="#62748C">src/methods/; extended/{abba,bm4}.py</FONT></TD></TR>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Called by IntegrationMethod.new_run</B><BR ALIGN="LEFT"/>Select and bind the state formulation.<BR ALIGN="LEFT"/>Initialize state, metadata and numerical resources.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Extended family</B><BR ALIGN="LEFT"/>Bind composition recipe, maps and projection.<BR ALIGN="LEFT"/>Bind SolverOptions and optional event adapters.</TD></TR>
        <HR/>
        <TR><TD WIDTH="330" BALIGN="LEFT" ALIGN="LEFT"><B>Adaptive family</B><BR ALIGN="LEFT"/>Create one fresh SciPy solver session per run.<BR ALIGN="LEFT"/>The constructor remains a reusable configuration.</TD></TR>
      </TABLE>
    >];
    Advance [label=<
      <TABLE WIDTH="330" BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="8">
