@startuml Grid_potential_execution_flow
title Ejecución GridPotential basada en composición

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

actor User
database "PHI.h5" as hdf5

package "Entrada y configuración" {
  component "run_potential.py" as cli
  component "PotentialRunConfig" as config
  component "solver block" as solver_config
}

package "classes/potential" {
  component "Potential\nabstract" as potential
  component "GridPotential" as grid_potential
  component "Grid + fields + interpolators" as grid_data
}

package "classes/trajectory" {
  component "Trajectory\nabstract" as trajectory
  component "TrajectoryGC" as gc_trajectory
  component "TrajectoryFC" as fc_trajectory
}

package "classes/system" {
  component "create_system()" as factory
  component "SystemGC" as gc_system
  component "SystemFC" as fc_system
  component "simulate()" as simulate
  component "internal solver" as solver
  component "SimulationResult" as result
}

package "Output workflows" {
  component "plot" as plot
  component "NPZ export" as export
}

User --> cli
cli --> config
hdf5 --> config : optional
config --> grid_potential : HDF5 or mock
grid_potential --|> potential
grid_potential --> grid_data
config --> gc_trajectory : gc
config --> fc_trajectory : fc\nfo normalized
gc_trajectory --|> trajectory
fc_trajectory --|> trajectory
potential --> factory
trajectory --> factory
factory --> gc_system
factory --> fc_system
gc_system --> simulate
fc_system --> simulate
solver_config --> simulate
simulate --> solver
solver --> result
result --> plot
result --> export

note bottom of factory
  Potential and Trajectory remain
  separate, immutable collaborators.
end note

@enduml
