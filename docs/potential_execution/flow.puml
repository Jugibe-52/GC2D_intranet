@startuml PotentialSystem_potential_execution_flow
title Ejecucion run_potential.py - modelo PotentialSystem con Potential

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

actor "Usuario terminal" as user

package "Entry point" {
  component "run_potential.py\nparse_args()\nmain()" as cli
}

package "Configuracion" {
  component "conf/potential/<group>/<version>.py" as json
  component "config.py\nload_potential_config()\nPotentialConfig\nPotentialRunConfig" as config
}

package "Workflows" {
  component "workflows/potentials.py\nextract_potential()\nmock_potential()" as potentials
  component "workflows/plotting.py\nplot_sol()\nplot_potential()" as plotting
}

package "Modelo" {
  component "classes/potential.py\nPotential" as potential
  component "classes/potential_system.py\nPotentialSystem" as fourier_cli
}

package "Librerias externas" {
  component "h5py\nPHI.h5" as h5py
  component "NumPy / SciPy\nFFT, Bessel,\nRectBivariateSpline" as scipy
  component "pyhamsys\nsolve_ivp_sympext()\nsolve_ivp_symp()" as pyhamsys
  component "Matplotlib\nplots" as mpl
}

database "PHI.h5\nopcional" as hdf5
artifact "figuras / logs" as outputs

user --> cli : python run_potential.py
cli --> config : load_potential_config(args)
config --> json : lee CONFIG

config --> potentials : PotentialConfig.build()
potentials --> h5py : si type=hdf5
h5py --> hdf5 : lee Rcells, Zcells,\nfreqs, fields
potentials --> potential : crea Potential
potentials --> scipy : mock / denoising

config --> fourier_cli : PotentialRunConfig.build_system()
fourier_cli --> potential : copia campos,\ngyroaverage,\ninterpoladores

cli --> fourier_cli : initial_conditions()
cli --> pyhamsys : traj_type='gc'\nsolve_ivp_sympext(hs,...)
cli --> pyhamsys : traj_type='fo'\nsolve_ivp_symp(hs.chi, hs.chi_star,...)
pyhamsys --> fourier_cli : y_dot(), hamiltonian(),\nchi(), chi_star()

cli --> plotting : si plot=True\nplot_sol(hs, sol)
plotting --> mpl
mpl --> outputs

@enduml
