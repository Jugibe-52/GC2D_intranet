@startuml GC2Dt_execution_flow
title Ejecucion gc2d.py - modelo Fourier GC2Dt

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

actor "Usuario terminal" as user

package "Entry point" {
  component "gc2d.py\nparse_args()\nmain()" as cli
}

package "Configuracion" {
  component "conf/<group>/<version>/gc2d.json" as json
  component "config.py\nload_gc2dt_config()\nGC2DtConfig.cases()" as config
}

package "Workflows" {
  component "gc2d_workflows.py\nAPI publica" as api
  component "workflows/params.py\nmake_system()\nto_symp_params()" as params
  component "workflows/cases.py\nrun_case()" as cases
  component "workflows/integration.py\nintegrate_case()" as integration
  component "workflows/export.py\nsave_data()" as export
  component "workflows/plotting.py\nplot_poincare()" as plotting
}

package "Modelo" {
  component "classes/gc2dt.py\nGC2Dt" as gc2dt
}

package "Librerias externas" {
  component "pyhamsys\nsolve_ivp_sympext()\nsolve_ivp_symp()" as pyhamsys
  component "multiprocess\nPool" as mp
  component "Matplotlib\nplt.show()" as mpl
}

artifact "outputs\n.mat / figuras / logs" as outputs

user --> cli : python gc2d.py
cli --> config : load_gc2dt_config(args)
config --> json : lee JSON
config --> cli : params_list

cli --> mp : opcional\nparaleliza casos
cli --> api : run_case(params)
api --> cases
cases --> integration
integration --> params : ensure_system()
params --> gc2dt : GC2Dt(params)
integration --> gc2dt : initial_conditions()

integration --> pyhamsys : traj_type='gc'\nsolve_ivp_sympext(system,...)
integration --> pyhamsys : traj_type='fo'\nsolve_ivp_symp(chi, chi_star,...)
pyhamsys --> gc2dt : y_dot(), k_dot(),\nhamiltonian(), chi()

cases --> plotting : si plot y Method=poincare*
cli --> export : save_data(system, sol)
export --> outputs : .mat si SaveData=True
plotting --> outputs : figuras
cli --> mpl : plt.show()

@enduml
