@startuml GC2D_run_workflow
title Flujo de run_workflow con entidades separadas

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam activity {
  BackgroundColor #F7FAFC
  BorderColor #2D3748
  DiamondBackgroundColor #EBF8FF
  DiamondBorderColor #2B6CB0
}

start

:Recibir perfil o caso normalizado;

if (¿fuente Fourier?) then (sí)
  :Construir FourierPotential;
else (no)
  :Construir GridPotential\n(HDF5 o mock);
endif

:Leer tipo de trayectoria;

if (tipo legado fo?) then (sí)
  :Normalizar fo a fc;
endif

if (tipo gc?) then (sí)
  :Construir TrajectoryGC;
else (fc)
  :Construir TrajectoryFC;
endif

:system = create_system(potential, trajectory);

partition "create_system" {
  :Validar que Potential y Trajectory\ncumplen sus contratos;
  if (TrajectoryGC?) then (sí)
    :Crear SystemGC;
    :Preparar potencial efectivo psi;
  else (TrajectoryFC)
    :Crear SystemFC;
    :Conservar potencial físico phi;
  endif
}

:Normalizar bloque solver:\nTimeStep -> step\node_solver -> method\nCheckEnergy -> check_energy;

:result = system.simulate(...);

partition "System.simulate" {
  :Obtener o construir estado inicial\ndesde Trajectory;
  :Validar t_span, step y muestras;

  if (SystemGC?) then (GC)
    :Integrar en espacio de fases extendido\ncon y_dot, k_dot y hamiltonian;
  else (FC)
    :Aumentar k si se comprueba energía;
    :Integrar con chi y chi_star;
    :Rectificar al estado físico;
  endif

  :Crear SimulationResult;
}

if (output.plot?) then (sí)
  :Representar usando\nsystem.trajectory + result;
endif

if (output.data?) then (sí)
  :Exportar t, estado físico\ny diagnósticos;
endif

:Devolver SimulationResult;
stop

note right
  Potential nunca posee Trajectory.
  Trajectory nunca posee Potential.
  Solo System conoce ambas entidades.
end note

@enduml
