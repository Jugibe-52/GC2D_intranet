@startuml Fourier_execution_flow
title Ejecución Fourier basada en Potential, Trajectory y System

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

actor User

package "Entrada y configuración" {
  component "run_fourier.py" as cli
  component "FourierConfig\nprofiles + sweep" as config
  component "solver\nTimeStep, method,\nCheckEnergy" as solver_config
}

package "classes/potential" {
  component "Potential\nabstract" as potential
  component "FourierPotential\nspectral field" as fourier
}

package "classes/trajectory" {
  component "Trajectory\nabstract" as trajectory
  component "TrajectoryGC" as gc_trajectory
  component "TrajectoryFC" as fc_trajectory
}

package "classes/system" {
  component "create_system()" as factory
  component "System\nsimulate()" as system
  component "SystemGC" as gc_system
  component "SystemFC" as fc_system
  component "internal symplectic solver" as solver
  component "SimulationResult" as result
}

package "Workflows" {
  component "plot / export" as output
  component "multiprocess" as batch
}

User --> cli
cli --> config
config --> solver_config
cli --> batch
batch --> fourier : one potential per case
fourier --|> potential
batch --> gc_trajectory : gc
batch --> fc_trajectory : fc\nfo normalized here
gc_trajectory --|> trajectory
fc_trajectory --|> trajectory
potential --> factory
trajectory --> factory
factory --> gc_system
factory --> fc_system
gc_system --|> system
fc_system --|> system
solver_config --> system
system --> solver : simulate(...)
solver --> result
result --> output

note bottom of solver
  SystemGC: extended phase space
  SystemFC: chi / chi_star
end note

@enduml
