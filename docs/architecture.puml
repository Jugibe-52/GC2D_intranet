@startuml GC2D_architecture
title GC2D - Arquitectura de dominio

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowColor #4A5568
skinparam ComponentBorderColor #2D3748
skinparam ComponentBackgroundColor #F7FAFC
skinparam PackageBorderColor #718096
skinparam PackageBackgroundColor #EDF2F7

actor User

package "Entry points" {
  component "run_fourier.py" as fourier_cli
  component "run_potential.py" as potential_cli
  component "notebooks" as notebooks
}

package "Configuration" {
  component "FourierConfig" as fourier_config
  component "PotentialRunConfig" as grid_config
  component "solver options" as solver_config
}

package "classes/potential" {
  component "Potential\nABC" as potential
  component "FourierPotential" as fourier_potential
  component "GridPotential" as grid_potential
  component "Grid / fields /\ninterpolation" as potential_data
}

package "classes/trajectory" {
  component "Trajectory\nABC" as trajectory
  component "TrajectoryGC" as trajectory_gc
  component "TrajectoryFC" as trajectory_fc
  component "initial state +\nstate layout" as trajectory_state
}

package "classes/system" {
  component "create_system(\npotential, trajectory)" as factory
  component "System\nABC / shared contract" as system
  component "SystemGC" as system_gc
  component "SystemFC" as system_fc
  component "gc_solver\nextended phase space" as gc_engine
  component "fc_solver\nflow composition" as fc_engine
  component "SimulationResult" as result
}

package "Workflows" {
  component "configuration adapters" as adapters
  component "plotting" as plotting
  component "export" as export
  component "batch execution" as batch
}

database "HDF5 input" as hdf5
artifact "NPZ / figures / logs" as outputs

User --> fourier_cli
User --> potential_cli
User --> notebooks
fourier_cli --> fourier_config
potential_cli --> grid_config
notebooks --> adapters
fourier_config --> adapters
grid_config --> adapters
solver_config --> adapters

adapters --> fourier_potential
adapters --> grid_potential
fourier_potential --|> potential
grid_potential --|> potential
grid_potential --> potential_data
hdf5 --> grid_potential

adapters --> trajectory_gc
adapters --> trajectory_fc
trajectory_gc --|> trajectory
trajectory_fc --|> trajectory
trajectory --> trajectory_state

potential --> factory
trajectory --> factory
factory --> system_gc
factory --> system_fc
system_gc --|> system
system_fc --|> system
system_gc --> gc_engine : _integrate(...)
system_fc --> fc_engine : _integrate(...)
gc_engine --> result
fc_engine --> result

fourier_cli --> batch
batch --> adapters
result --> plotting
result --> export
plotting --> outputs
export --> outputs

note right of trajectory
  Internal kinds: gc, fc
  Legacy input alias: fo -> fc
end note

@enduml
