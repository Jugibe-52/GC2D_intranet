    + K = h(t, z) + kappa error histories
    + R6 splitting symplecticity defects
    + R4 complete projected-map defects
    + refinement orders and nonlinear work
  }
  class FullyExtendedImplicitStudy {
    + direct K = h(t,z) + k histories
    + analytic R8 base-map and R4 projected-map defects
    + centered D Psi / D R / D Phi audits
    + refinement orders and nonlinear work
  }
  class RK4SymplecticityStudy
  class MidpointABBASymplecticityStudy
  class ABBASymplecticityStudy
  class ImplicitABBASymplecticityStudy
  class BM4ImplicitSymplecticityStudy
  class MidpointBM4SymplecticityStudy {
    + same random trajectories for every step size
    + arithmetic mean of per-trajectory defects
  }
  class TrajectorySymplecticityStudy {
    + common initial configuration and saved-time grid
    + MidpointABBA / ImplicitABBA1 / ABBA4Implicit1 / BM4Implicit1 runners
    + ABBA4 exact tangent J3 @ J2 @ J1
    + arithmetic mean of per-trajectory defects
  }
  class ProjectedBM4SymplecticityStudy {
    + local complete-step physical defect
    + accumulated physical-flow defect
