@startuml
title GC2D Simulation Architecture

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam defaultTextAlignment center

package "Physical dynamics" as Dynamics {
  class Potential

  interface DynamicalSystem {
    + state_dimension: int
    + vector_field(t, state): Array
  }

  interface HamiltonianSystem {
    + hamiltonian(t, state): Array
  }

  interface ExtendedHamiltonianSystem {
    + extended_momentum_derivative(t, state): Array
  }

  interface GuidingCenterJacobianSystem {
    + particle_vector_field_jacobians(t, state): Array[N, 2, 2]
  }

  interface CyclotronSplitSystem {
    + rho: float
    + eta: float
    + larmor_frequency: float
    + electric_acceleration(t, x, y): (Array, Array)
  }

  class GuidingCenterDynamics {
    + rho: float
    + particle_vector_field_jacobians(t, state): Array[N, 2, 2]
  }

  class FullCyclotronDynamics {
    + rho: float
    + eta: float
  }

  HamiltonianSystem <|-- ExtendedHamiltonianSystem
  DynamicalSystem <|-- GuidingCenterJacobianSystem
  DynamicalSystem <|-- CyclotronSplitSystem

  GuidingCenterJacobianSystem <|.. GuidingCenterDynamics
  ExtendedHamiltonianSystem <|.. GuidingCenterDynamics

  DynamicalSystem <|.. FullCyclotronDynamics
  ExtendedHamiltonianSystem <|.. FullCyclotronDynamics
  CyclotronSplitSystem <|.. FullCyclotronDynamics

  GuidingCenterDynamics o-- Potential
  FullCyclotronDynamics o-- Potential
}

package "Initial configuration" as Initial {
  interface InitialConfiguration {
    + state_dimension: int
    + initial_state: Array
    + validate_packed_state(state): Array
    + split(state): Components
    + pack_components(components): Array
    + particle_count(state): int
    + positions(state): (Array, Array)
  }

  class GCInitialConfiguration
  class FCInitialConfiguration

  class Area {
    + shape: AreaShape
    + calculate_area(states, period=None): Array
  }

  InitialConfiguration <|.. GCInitialConfiguration
  InitialConfiguration <|.. FCInitialConfiguration
  GCInitialConfiguration <|-- Area

  note bottom of GCInitialConfiguration
    Initial configurations own state geometry
    and component-major layout only. Legacy
    TrajectoryGC and TrajectoryFC wrappers, plus
    Area's migration adapter, may carry deprecated
    non-authoritative physical metadata.
  end note
}

class InitialValueProblem {
  + dynamics: DynamicalSystem
  + initial_configuration: InitialConfiguration
}

InitialValueProblem o-- DynamicalSystem
InitialValueProblem o-- InitialConfiguration

package "Numerical formulations" as Formulations {
  interface DirectAdjointFormulation {
    + prepare(problem, track_energy): PreparedMaps
  }

  interface StageProjectedFormulation {
    + prepare(problem, track_energy): StageProjectedMaps
  }

  class GCExtendedFormulation {
    + coupling_frequency: float
  }

  class GCStageProjectedFormulation
  class FCSplitFormulation

  DirectAdjointFormulation <|-- StageProjectedFormulation
  DirectAdjointFormulation <|.. GCExtendedFormulation
  DirectAdjointFormulation <|.. FCSplitFormulation
  StageProjectedFormulation <|.. GCStageProjectedFormulation
}

note bottom of DirectAdjointFormulation
  PreparedMaps is an internal, immutable
  per-run value containing the initial
  internal state, direct and adjoint maps,
  and physical projection.
end note

GCExtendedFormulation ..> DynamicalSystem : requires vector field
GCExtendedFormulation ..> GCInitialConfiguration : requires GC layout
GCExtendedFormulation ..> ExtendedHamiltonianSystem : optional energy tracking
GCStageProjectedFormulation ..> DynamicalSystem : requires vector field
GCStageProjectedFormulation ..> GCInitialConfiguration : requires GC layout
GCStageProjectedFormulation ..> ExtendedHamiltonianSystem : optional energy tracking
FCSplitFormulation ..> CyclotronSplitSystem : requires FC split
FCSplitFormulation ..> FCInitialConfiguration : requires FC layout
FCSplitFormulation ..> ExtendedHamiltonianSystem : optional energy tracking

package "Numerical methods" as Methods {
  interface NumericalMethod {
    + integrate(problem, request): IntegrationData
  }

  class RK4
  class BM4Composition
  class ProjectedBM4Composition
  class BM4Implicit1 {
    + nonlinear_solver: newton / broyden
  }
  class BM4Implicit2 {
    + nonlinear_solver: newton / broyden
  }
  class MidpointABBA
  class ImplicitABBA1 {
    + nonlinear_solver: newton / broyden
  }
  class ImplicitABBA2 {
    + nonlinear_solver: newton / broyden
  }
  class BroydenResidualSolver {
    + solve(residual, initial_unknown, initial_jacobian, tolerance): root
    + good rank-one Jacobian update
  }

  NumericalMethod <|.. RK4
  NumericalMethod <|.. BM4Composition
  BM4Composition <|-- ProjectedBM4Composition
  NumericalMethod <|.. BM4Implicit1
  NumericalMethod <|.. BM4Implicit2
  NumericalMethod <|.. MidpointABBA
  NumericalMethod <|.. ImplicitABBA1
  NumericalMethod <|.. ImplicitABBA2
}

RK4 ..> DynamicalSystem : requires vector field
BM4Composition o-- DirectAdjointFormulation : formulation
ProjectedBM4Composition o-- StageProjectedFormulation : formulation
BM4Implicit1 ..> GCExtendedFormulation : full-cycle reduced projection
BM4Implicit2 ..> GCExtendedFormulation : full-cycle simultaneous projection
MidpointABBA ..> DynamicalSystem : requires planar vector field
ImplicitABBA1 ..> GuidingCenterJacobianSystem : exact reduced 2x2 Newton blocks
ImplicitABBA2 ..> GuidingCenterJacobianSystem : exact simultaneous 6x6 Newton blocks
ImplicitABBA1 ..> BroydenResidualSolver : reduced residual; K0 = 4 I
ImplicitABBA2 ..> BroydenResidualSolver : simultaneous residual; zero-step K0
BM4Implicit1 ..> BroydenResidualSolver : reduced residual; K0 = 4 I
BM4Implicit2 ..> BroydenResidualSolver : simultaneous residual; zero-step K0

package "Simulation" as Simulation {
  class SimulationRequest {
    + t_span: (float, float)
    + max_step: float
    + output_times: Array
  }

  class SimulationRunner {
    + simulate(problem, method, request): Solution
  }

  class IntegrationStage {
    + dynamics_name: str
    + formulation_name: str
    + method_name: str
    + flow_name: str
  }

  class IntegrationStep {
    + dynamics_name: str
    + method_name: str
    + step_index: int
    + time: float
    + duration: float
    + map_state(state): Array
  }

  class ImplicitIntegrationStep {
    + formulation_name: str
    + start_time: float
    + nonlinear_solver: newton / broyden
    + newton_iterations: int
    + residual_evaluations: int
    + newton_residual_norm: float
    + newton_tolerance: float
    + projection_multiplier_norm: float
  }

  class ImplicitABBAIntegrationStep {
    + dynamics: GuidingCenterJacobianSystem
    + multiplier: Array
    + converged ABBA stage snapshots
  }

  class ImplicitBM4IntegrationStep

IntegrationStep <|-- ImplicitIntegrationStep
ImplicitIntegrationStep <|-- ImplicitABBAIntegrationStep
ImplicitIntegrationStep <|-- ImplicitBM4IntegrationStep
ImplicitABBAIntegrationStep --> GuidingCenterJacobianSystem : exposes dynamics

  class Solution {
    + source: InitialConfiguration
    + t: Array
    + states: Array
    + diagnostics: read-only Mapping
    + components(): Components
    + positions(): (Array, Array)
  }
}

SimulationRunner ..> InitialValueProblem
SimulationRunner ..> NumericalMethod
SimulationRunner ..> SimulationRequest
SimulationRunner --> Solution : builds

Solution o-- InitialConfiguration : source
RK4 --> IntegrationStep : optional observation
BM4Implicit1 --> ImplicitBM4IntegrationStep : solver metrics
BM4Implicit2 --> ImplicitBM4IntegrationStep : solver metrics
MidpointABBA --> IntegrationStep : optional observation
ImplicitABBA1 --> ImplicitABBAIntegrationStep : converged stage data
ImplicitABBA2 --> ImplicitABBAIntegrationStep : converged stage data

note right of Area
  Area is a GC initial configuration
  with additional geometric meaning.
end note

note right of Solution
  Solution is the immutable computed trajectory:
  t provides the temporal dimension and
  states[:, index] is the state at t[index].

  Numerical diagnostics remain attached
  without introducing more result classes.
end note

note right of GuidingCenterDynamics
  Dynamics is the authoritative owner of rho.
  FullCyclotronDynamics owns both rho and eta.
end note

note bottom of NumericalMethod
  IntegrationData is an internal value:
  times, physical states, and diagnostics.
  The runner converts it into Solution.
end note

note bottom of ProjectedBM4Composition
  After every direct or adjoint map,
  the formulation averages both GC copies
  and embeds that mean back on the diagonal:
  twelve projections per complete BM4 step.
  This non-invertible projection is a distinct
  BM4-based method, not the coupled BM4 map.
end note

note bottom of BM4Implicit1
  Hairer's symmetric projection surrounds one complete
  twelve-stage BM4 cycle. The reduced formulation eliminates
  the duplicated output and solves only for the physical multiplier.
  Newton differentiates the BM4 map by centered differences;
  Broyden uses explicit reduced-residual evaluations.
end note

note bottom of BM4Implicit2
  The same projected BM4 root is expressed with the
  duplicated output and multiplier as simultaneous unknowns.
  It is algebraically equivalent to BM4Implicit1 through
  the reduced Schur complement. Both Newton and Broyden are selectable.
end note

note bottom of ImplicitABBA1
  Each second-order step applies endpoint-time
  A-B-B-A shears in a duplicated GC state and
  solves the reduced multiplier equation (11).
  Newton uses exact independent 2x2 blocks; Broyden
  needs only explicit evaluations of that residual.
end note

note bottom of ImplicitABBA2
  The projected physical map is the same as implicit 1.
  Equation (21) retains the duplicated output and
  multiplier as simultaneous unknowns. Newton produces
  exact 6x6 particle blocks; Broyden updates the shared
  zero-step Jacobian approximation by secant data.
end note

note bottom of MidpointABBA
  Each second-order step duplicates the physical
  state, applies endpoint-time A-B-B-A shears,
  and returns the arithmetic mean of both copies.
  The mean projection is explicit but does not
  guarantee physical symplecticity or reversibility.
end note

note bottom of SimulationRunner
  The runner validates and executes the supplied
  problem, numerical method, and request.
  Specialized methods may own a formulation.
end note

package "Reusable studies" as Studies {
  class AreaComparison
  class GeneralizedEnergyComparison
  class RK4SymplecticityStudy
  class MidpointABBASymplecticityStudy
  class ABBASymplecticityStudy
  class ImplicitABBASymplecticityStudy
  class BM4ImplicitSymplecticityStudy
  class ImplicitABBAJacobianStudy
  class ImplicitABBAIterationStudy
  class BM4ImplicitIterationStudy
  class ImplicitTrajectoryComparisonStudy {
    + same problem and step for four implicit methods
    + six pairwise periodic trajectory summaries
    + four per-step nonlinear-work series
  }
  class ImplicitABBAJacobianParticleStepSeries {
    + states before and after observed steps
    + effective electric field at step endpoints
    + Delta z[n] = z[n+1] - z[n]
    + norm and oriented atan2 direction of Delta z[n]
  }
  class ABBAComparisonStudy
}

package "Optional visualization" as Visualization {
  class PotentialVisualization
  class GCAreaVisualization
  class SingleParticleVisualization {
    + animate_fc_particle_solution(potential, solution, show_electric_field, frame_annotations): FuncAnimation
    + animate_gc_particle_solution(potential, solution, show_electric_field, frame_annotations): FuncAnimation
  }
  class ABBAJacobianVisualization
  class ImplicitIterationVisualization
  class ImplicitTrajectoryComparisonVisualization {
    + one trajectory color per method
    + 4 x 4 mean periodic-distance matrix in 2 x 2 family blocks
    + aligned iteration and residual-evaluation plots
    + notebook tables
  }
  class NotebookDisplay
}

package "Opt-in diagnostics" as Diagnostics {
  class SymplecticityObservers
  class ImplicitABBAJacobianObserver {
    + local physical Jacobian per step
    + per-particle spectrum and SVD
  }
  class ImplicitABBAIterationObserver {
    + nonlinear iterations and residual evaluations per accepted step
    + residual, tolerance, and multiplier norms
  }
  class ImplicitBM4IterationObserver {
    + nonlinear iterations and residual evaluations per accepted BM4 step
    + residual, tolerance, and multiplier norms
  }
  class ParticleJacobianAnalysis {
    + trace, determinant, discriminant
    + eigensystem and singular system
  }
  class StepJacobianDiagnostics {
    + finite_difference(step): Array
    + implicit_function(step): Array
    + stage_increment(step): Array
  }
  class DiagnosticBlockWriter
}

AreaComparison ..> SimulationRunner
AreaComparison ..> BM4Composition : coupled_bm4
AreaComparison ..> ProjectedBM4Composition : stage_projected_bm4
GeneralizedEnergyComparison ..> SimulationRunner
RK4SymplecticityStudy ..> SimulationRunner
RK4SymplecticityStudy ..> RK4
RK4SymplecticityStudy ..> IntegrationStep : analyzes
MidpointABBASymplecticityStudy ..> SimulationRunner
MidpointABBASymplecticityStudy ..> MidpointABBA
MidpointABBASymplecticityStudy ..> IntegrationStep : analyzes
ABBASymplecticityStudy ..> SimulationRunner
ABBASymplecticityStudy ..> ImplicitABBA1
ABBASymplecticityStudy ..> IntegrationStep : analyzes
ImplicitABBASymplecticityStudy ..> ImplicitABBA1
ImplicitABBASymplecticityStudy ..> ImplicitABBA2
ImplicitABBASymplecticityStudy ..> SymplecticityObservers : configurable fan-out
ImplicitABBASymplecticityStudy ..> ImplicitABBAIntegrationStep : analyzes
ImplicitABBAJacobianStudy ..> ImplicitABBA1
ImplicitABBAJacobianStudy ..> ImplicitABBA2
ImplicitABBAJacobianStudy ..> ImplicitABBAJacobianObserver : configures
ImplicitABBAJacobianStudy o-- ImplicitABBAJacobianParticleStepSeries : derives from observed samples
ImplicitABBAJacobianStudy ..> GuidingCenterDynamics : evaluates effective electric field
ImplicitABBAIterationStudy ..> ImplicitABBA1
ImplicitABBAIterationStudy ..> ImplicitABBA2
ImplicitABBAIterationStudy ..> ImplicitABBAIterationObserver : configures
BM4ImplicitIterationStudy ..> BM4Implicit1
BM4ImplicitIterationStudy ..> BM4Implicit2
BM4ImplicitIterationStudy ..> ImplicitBM4IterationObserver : configures
ImplicitTrajectoryComparisonStudy ..> ImplicitABBA1
ImplicitTrajectoryComparisonStudy ..> ImplicitABBA2
ImplicitTrajectoryComparisonStudy ..> BM4Implicit1
ImplicitTrajectoryComparisonStudy ..> BM4Implicit2
ImplicitTrajectoryComparisonStudy ..> Solution : compares aligned trajectories and diagnostics
BM4ImplicitSymplecticityStudy ..> BM4Implicit1
BM4ImplicitSymplecticityStudy ..> BM4Implicit2
BM4ImplicitSymplecticityStudy ..> IntegrationStep : analyzes
ABBAComparisonStudy ..> MidpointABBASymplecticityStudy : one run; times outside observer
ABBAComparisonStudy ..> ImplicitABBASymplecticityStudy : formulations 1 and 2
ABBAComparisonStudy ..> Solution : compares periodic trajectories
PotentialVisualization ..> Potential
GCAreaVisualization ..> Potential
GCAreaVisualization ..> Area
GCAreaVisualization ..> Solution
SingleParticleVisualization ..> Potential
SingleParticleVisualization ..> Solution
ABBAJacobianVisualization ..> ImplicitABBAJacobianObserver : presents samples
ABBAJacobianVisualization ..> ImplicitABBAJacobianParticleStepSeries : presents field and finite increments
ImplicitIterationVisualization ..> ImplicitABBAIterationObserver : presents solver work
ImplicitIterationVisualization ..> ImplicitBM4IterationObserver : presents solver work
ImplicitTrajectoryComparisonVisualization ..> Solution : animates and plots aligned results
SymplecticityObservers ..> IntegrationStage
SymplecticityObservers ..> IntegrationStep
SymplecticityObservers o-- StepJacobianDiagnostics : selected strategy
StepJacobianDiagnostics ..> ImplicitABBAIntegrationStep : analytic methods
SymplecticityObservers --> DiagnosticBlockWriter : persists CSV/NPZ/JSON
ImplicitABBAJacobianObserver ..> ImplicitABBAIntegrationStep : observes
ImplicitABBAJacobianObserver o-- StepJacobianDiagnostics : implicit-function tangent
ImplicitABBAJacobianObserver o-- ParticleJacobianAnalysis : one per particle
ImplicitABBAJacobianObserver --> DiagnosticBlockWriter : persists CSV/NPZ/JSON
ImplicitABBAIterationObserver ..> ImplicitABBAIntegrationStep : consumes solver metrics
ImplicitABBAIterationObserver --> DiagnosticBlockWriter : persists CSV/NPZ/JSON
ImplicitBM4IterationObserver ..> ImplicitBM4IntegrationStep : consumes solver metrics
ImplicitBM4IterationObserver --> DiagnosticBlockWriter : persists CSV/NPZ/JSON

note bottom of ImplicitABBAJacobianObserver
  This observer studies only the local physical
  Jacobian of each selected complete ABBA step.
  It does not accumulate tangent maps or calculate
  area and symplecticity quantities.
end note

note bottom of ImplicitABBAIterationObserver
  The method performs the nonlinear solve once.
  This observer records its accepted-step solver,
  correction count, residual evaluations, and convergence metrics
  and never reevaluates the implicit equations.
end note

note bottom of ImplicitBM4IterationObserver
  The observer samples one nonlinear solve around
  each complete twelve-stage BM4 cycle and does not
  execute additional BM4 maps or Jacobians.
end note

note top of Dynamics
  The implementation is split into top-level
  packages by responsibility: potential, dynamics,
  initial_conditions, simulation, diagnostics,
  studies, and visualization.
end note

legend bottom
  |= Relation |= Meaning |
  | <|.. | Implements an interface |
  | <|-- | Inherits or specializes |
  | ..> | Requires or adapts |
  | o-- | Aggregates |
  | --> | Uses or produces |
endlegend

@enduml
