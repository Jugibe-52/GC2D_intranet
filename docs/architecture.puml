@startuml GC2D_architecture
title Guiding-center Program Architecture

skinparam componentStyle rectangle
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultTextAlignment center
skinparam ArrowColor #4A5568
skinparam ComponentBorderColor #2D3748
skinparam ComponentBackgroundColor #F7FAFC
skinparam PackageBorderColor #718096
skinparam PackageBackgroundColor #EDF2F7
skinparam DatabaseBorderColor #2D3748
skinparam DatabaseBackgroundColor #EBF8FF
skinparam ArtifactBorderColor #2D3748
skinparam ArtifactBackgroundColor #FFFFF0

actor "User" as user

package "Entry points" {
  component "run_fourier.py\nmain batch runner" as fourier_cli
  component "run_potential.py\nstandalone showcase" as potential_cli
  component "notebooks/\nworkflows_demo.ipynb" as notebook
}

package "Configuration" {
  component "conf/<surface>/fourier/<group>/<version>.json\nMethod, Ntraj, Tf,\nA, rho, plotting, saving" as fourier_config
}

package "src modules" {
  component "config_logging.py\nconfigure_logging()\nsimulation_label()" as config_logging

  component "workflows_api.py\nmake_system()\nrun_workflow()\nintegrate_simulation()\nplot_poincare()\nsave_data()\nextract_potential()" as notebook_api

  component "classes/fourier_system.py\nFourierSystem\nFourier turbulent model" as fourier_system

  component "workflows/symplectic_legacy.py\nrun_method()\nlegacy execution flow" as symp_modules

  component "workflows/symplectic_cli.py\nparse_args()\nmain()" as symp_cli

  component "classes/trajectory/\nTrajectory, TrajectoryGC, TrajectoryFC\n+ Potential" as classes
}

package "External libraries" {
  component "pyhamsys\nsolve_ivp_sympext()\nsolve_ivp_symp()\nHamSys" as pyhamsys
  component "multiprocess\nPool / cpu_count" as multiprocess
  component "NumPy / SciPy\nFFT, Bessel, interpolation,\nNumPy export" as scientific_stack
  component "Matplotlib\nfigures and interactive plots" as matplotlib
  component "h5py\nPHI.h5 input" as h5py
}

database "Input data\nPHI.h5" as phi_h5

artifact "Runtime outputs\n.npz data files\n.png/.pdf/.svg figures\nstdout/file logs" as outputs

user --> fourier_cli : python3 run_fourier.py
user --> potential_cli : python3 run_potential.py
user --> notebook : open notebook

fourier_cli --> fourier_config : reads cases\nand parallelization
fourier_cli --> config_logging : configures logging
fourier_cli --> multiprocess : parallel case map
fourier_cli --> notebook_api : run_workflow(params)\ncompatibility path
fourier_cli --> matplotlib : show plots

notebook --> notebook_api : make_system(params)\nrun_workflow(system)
notebook --> fourier_config : optional base params

notebook_api --> config_logging : labels and logs
notebook_api --> fourier_system : make_system builds\nFourierSystem(params)
notebook_api --> pyhamsys : integrates gc / fo trajectories
notebook_api --> matplotlib : Poincare plots
notebook_api --> outputs : figures via plot_poincare()

fourier_system --> pyhamsys : extends HamSys\nuses OdeSolution contract
fourier_system --> scientific_stack : Fourier potential,\nBessel FLR correction
notebook_api --> outputs : save_data()

symp_cli --> symp_modules : creates FourierSystem\nper params
symp_modules --> pyhamsys : integrates trajectories
symp_modules --> matplotlib : optional Poincare plot
symp_modules --> outputs : saved data / figures
symp_modules --> config_logging : logs progress

potential_cli --> config_logging : configures logging
potential_cli --> notebook_api : extract_potential()\nmock_potential()\nplot_sol()
potential_cli --> classes : create_trajectory()
potential_cli --> pyhamsys : integrates showcase
potential_cli --> matplotlib : plotting workflows

phi_h5 --> h5py
h5py --> notebook_api : loaded by extract_potential()
classes --> scientific_stack : interpolation,\ngyroaverage, derivatives
classes --> pyhamsys : extends HamSys
notebook_api --> matplotlib : potential / trajectory plots
notebook_api --> outputs : showcase figures

legend right
  Main production path:
  run_fourier.py -> config.py -> workflows_api.py -> FourierSystem -> pyhamsys -> outputs

  Standalone data-potential path:
  run_potential.py -> workflows_api.py -> classes/ -> pyhamsys -> plots

  Legacy package entry:
  symplectic.py -> workflows/symplectic_cli.py -> workflows/symplectic_legacy.py
endlegend

@enduml
