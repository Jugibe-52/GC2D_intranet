  class SymplecticityObservers
  class ProjectedSymplecticityAreaObserver {
    + differentiates all twelve projected BM4 stages
    + local and accumulated physical Jacobians
  }
  class MidpointBM4SymplecticityObserver {
    + exact uncoupled 4x4 stage factors per particle
    + local and accumulated 2x2 physical tangents
    + arithmetic trajectory-mean defects
  }
  class GCTrajectorySymplecticityObserver {
    + exact local 2x2 Jacobian per trajectory
    + accumulated physical 2x2 tangent
    + arithmetic mean, standard deviation, and maximum defects
  }
  class ImplicitABBAJacobianObserver {
    + local physical Jacobian per step
    + per-particle spectrum and SVD
  }
  class ImplicitABBAReversibilityObserver {
    + independently solved signed reverse step
    + exact forward and backward IFT tangents
    + proposed increments and relative closure
  }
  class ImplicitABBAIterationObserver {
    + nonlinear iterations and residual evaluations per accepted step
    + residual, tolerance, and multiplier norms
  }
  class ImplicitBM4IterationObserver {
    + nonlinear iterations and residual evaluations per accepted BM4 step
