ImplicitABBA1TangentTaylor ..> ImplicitABBA1 : solves and differentiates one base root
ABBA4Implicit1TangentTaylor ..> ABBA4Implicit1 : composes three base tangent factors
ImplicitABBA1 ..> BroydenResidualSolver : reduced residual; K0 = 4 I
ImplicitABBA2 ..> BroydenResidualSolver : simultaneous residual; zero-step K0
ABBA4Implicit1 ..> BroydenResidualSolver : separate reduced solve per signed substep
ABBA4SingleProjectionImplicit1 ..> BroydenResidualSolver : one complete-base residual; K0 = 4 I
ABBA6 ..> BroydenResidualSolver : separate reduced solve per signed substep
BM4Implicit1 ..> BroydenResidualSolver : reduced residual; K0 = 4 I
BM4Implicit2 ..> BroydenResidualSolver : simultaneous residual; zero-step K0

package "Simulation" as Simulation {
  class SimulationRequest {
    + t_span: (float, float)
    + max_step: float
    + output_times: Array
  }

  class SimulationRunner {
    + simulate(problem, method, request): Solution
  }

  class IntegrationStage {
    + dynamics_name: str
    + dynamics: DynamicalSystem | None
    + formulation_name: str
    + method_name: str
    + flow_name: str
  }

  class IntegrationStep {
    + dynamics_name: str
    + method_name: str
    + step_index: int
    + time: float
    + duration: float
    + start_time: float
    + dynamics: DynamicalSystem | None
    + map_state(state): Array
  }

  class ImplicitIntegrationStep {
    + formulation_name: str
    + nonlinear_solver: newton / broyden
    + newton_iterations: int
    + residual_evaluations: int
    + newton_residual_norm: float
    + newton_tolerance: float
    + projection_multiplier_norm: float
  }

  class ImplicitABBAIntegrationStep {
    + multiplier: Array
    + converged ABBA stage snapshots
  }

  class UnprojectedABBAIntegrationStep {
    + start_time / time / duration
    + converged ABBA stage snapshots
    + no multiplier or nonlinear solve
  }

  class ABBA4SingleProjectionIntegrationStep {
    + one exterior multiplier
    + composition_coefficients: Array
    + substeps: tuple[UnprojectedABBAIntegrationStep]
    + aggregate exterior-root solver metrics
  }

  class ImplicitABBACompositionIntegrationStep {
    + composition_coefficients: Array
    + substeps: tuple[ImplicitABBAIntegrationStep]
    + aggregate nonlinear-solver metrics
  }

  class ImplicitABBA4IntegrationStep {
    + three signed substeps
  }

  class ImplicitABBA6IntegrationStep {
    + seven signed substeps
  }

  class ImplicitBM4IntegrationStep {
    + coupling_frequency: float
    + multiplier: Array
    + twelve accepted base stages
  }

  class FullyExtendedBaseMap {
    + state_before / state_after: R8
    + map_state: R8 -> R8
    + analytic jacobian_state: R8 -> Matrix8
    + analytic residual_jacobian: Matrix4
  }

  class FullyExtendedImplicitIntegrationStep {
    + state_before / state_after: R4
    + multiplier: R4
    + analytic projected jacobian: Matrix4
    + base_maps: tuple[FullyExtendedBaseMap]
  }

IntegrationStep <|-- ImplicitIntegrationStep
ImplicitIntegrationStep <|-- ImplicitABBAIntegrationStep
ImplicitIntegrationStep <|-- ABBA4SingleProjectionIntegrationStep
ImplicitIntegrationStep <|-- ImplicitABBACompositionIntegrationStep
ImplicitABBACompositionIntegrationStep <|-- ImplicitABBA4IntegrationStep
ImplicitABBACompositionIntegrationStep <|-- ImplicitABBA6IntegrationStep
ImplicitIntegrationStep <|-- ImplicitBM4IntegrationStep
ImplicitIntegrationStep <|-- FullyExtendedImplicitIntegrationStep
