@startuml
title GC2D Simulation Architecture

skinparam componentStyle rectangle
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam defaultTextAlignment center

package "Physical dynamics" as Dynamics {
  class Potential

  class GC2DH5Potential {
    + frequencies: Array
    + evaluate(t, x, y, dx, dy, dt): Array
    + dynamic_part(t, x, y, dx, dy, dt): Array
    + gyroaverage(rho): GC2DH5Potential
  }

  interface DynamicalSystem {
    + state_dimension: int
    + vector_field(t, state): Array
  }

  interface HamiltonianSystem {
    + hamiltonian(t, state): Array
  }

  interface ExtendedHamiltonianSystem {
    + extended_momentum_derivative(t, state): Array
  }

  interface GuidingCenterJacobianSystem {
    + particle_vector_field_jacobians(t, state): Array[N, 2, 2]
  }

  interface CyclotronSplitSystem {
    + rho: float
    + eta: float
    + larmor_frequency: float
    + electric_acceleration(t, x, y): (Array, Array)
  }

  class GuidingCenterDynamics {
    + rho: float
    + particle_vector_field_jacobians(t, state): Array[N, 2, 2]
  }

  class FullCyclotronDynamics {
    + rho: float
    + eta: float
  }

  Potential <|-- GC2DH5Potential

  HamiltonianSystem <|-- ExtendedHamiltonianSystem
  DynamicalSystem <|-- GuidingCenterJacobianSystem
  DynamicalSystem <|-- CyclotronSplitSystem

  GuidingCenterJacobianSystem <|.. GuidingCenterDynamics
  ExtendedHamiltonianSystem <|.. GuidingCenterDynamics

  DynamicalSystem <|.. FullCyclotronDynamics
  ExtendedHamiltonianSystem <|.. FullCyclotronDynamics
  CyclotronSplitSystem <|.. FullCyclotronDynamics

  GuidingCenterDynamics o-- Potential
  FullCyclotronDynamics o-- Potential
}

package "Initial configuration" as Initial {
  interface InitialConfiguration {
    + state_dimension: int
    + initial_state: Array
    + validate_packed_state_layout(state): Array
    + split(state): Components
    + pack_components(components): Array
    + particle_count(state): int
    + positions(state): (Array, Array)
  }

  class StateConfiguration <<partial base>> {
    + initial_state: Array
    + validate_packed_state_layout(state): Array
    + split(state): Components
    + pack_components(components): Array
    + particle_count(state): int
    + positions(state): (Array, Array)
  }

  class GCInitialConfiguration
  class FCInitialConfiguration

  class Area {
    + shape: AreaShape
    + calculate_area(states, period=None): Array
  }

  InitialConfiguration <|.. GCInitialConfiguration
  InitialConfiguration <|.. FCInitialConfiguration
  StateConfiguration <|-- GCInitialConfiguration
  StateConfiguration <|-- FCInitialConfiguration
  GCInitialConfiguration <|-- Area

  note bottom of StateConfiguration
    Shared partial implementation. Concrete subclasses
    provide state_dimension and thereby complete the
    InitialConfiguration structural contract.
  end note

  note bottom of GCInitialConfiguration
    Initial configurations own state geometry
    and component-major layout only. Legacy
    TrajectoryGC and TrajectoryFC wrappers, plus
    Area's migration adapter, may carry deprecated
    non-authoritative physical metadata.
  end note
}

class InitialValueProblem {
  + dynamics: DynamicalSystem
  + initial_configuration: InitialConfiguration
}

InitialValueProblem o-- DynamicalSystem
InitialValueProblem o-- InitialConfiguration

package "Numerical formulations" as Formulations {
  interface DirectAdjointFormulation {
    + prepare(problem, track_energy): PreparedMaps
  }

  interface StageProjectedFormulation {
    + prepare(problem, track_energy): StageProjectedMaps
  }

  class GCExtendedFormulation {
    + coupling_frequency: float
  }

  class GCStageProjectedFormulation
  class FCSplitFormulation

  DirectAdjointFormulation <|-- StageProjectedFormulation
  DirectAdjointFormulation <|.. GCExtendedFormulation
  DirectAdjointFormulation <|.. FCSplitFormulation
  StageProjectedFormulation <|.. GCStageProjectedFormulation
}

note bottom of DirectAdjointFormulation
  PreparedMaps is an internal, immutable
  per-run value containing the initial
  internal state, direct and adjoint maps,
  and physical projection.
end note

GCExtendedFormulation ..> DynamicalSystem : requires vector field
GCExtendedFormulation ..> GCInitialConfiguration : requires GC layout
GCExtendedFormulation ..> ExtendedHamiltonianSystem : optional energy tracking
GCStageProjectedFormulation ..> DynamicalSystem : requires vector field
GCStageProjectedFormulation ..> GCInitialConfiguration : requires GC layout
GCStageProjectedFormulation ..> ExtendedHamiltonianSystem : optional energy tracking
FCSplitFormulation ..> CyclotronSplitSystem : requires FC split
FCSplitFormulation ..> FCInitialConfiguration : requires FC layout
FCSplitFormulation ..> ExtendedHamiltonianSystem : optional energy tracking

package "Numerical methods" as Methods {
  interface NumericalMethod {
    + integrate(problem, request): IntegrationData
  }

  class ExplicitEuler {
    + z_next = z + h f(t, z)
  }
  class RK4
  class BM4Composition
  class MidpointBM4
  class ProjectedBM4Composition
  class BM4Implicit1 {
    + nonlinear_solver: newton / broyden
    + newton_jacobian_method: analytic / finite_difference
  }
  class BM4Implicit2 {
    + nonlinear_solver: newton / broyden
    + newton_jacobian_method: analytic / finite_difference
  }
  class MidpointABBA
  class ImplicitABBA1 {
    + nonlinear_solver: newton / broyden
  }
  class ImplicitABBA2 {
    + nonlinear_solver: newton / broyden
  }
  class ABBA4Implicit1 {
    + nonlinear_solver: newton / broyden
  }
  class ABBA4SingleProjectionImplicit1 {
    + nonlinear_solver: newton / broyden
    + three continuous unprojected signed ABBA maps
    + one reduced exterior projection
  }
  class ABBA6 {
    + nonlinear_solver: newton / broyden
  }
  class ABBA_implicit2 {
    + duplicate and project complete (z,t,k) state
    + analytic shear-product D Psi and D R
  }
  class ABBA4_implicit2 {
    + three signed full-state projected ABBA roots
  }
  class BM4_implicit2 {
    + full-state projected twelve-stage BM4 cycle
  }
  class ImplicitABBA1TangentTaylor {
    + z_next = z + h f + h^2 / 2 D(Psi_ABBA) f
  }
  class ABBA4Implicit1TangentTaylor {
    + z_next = z + h f + h^2 / 2 D(Psi_ABBA4) f
  }
  class BroydenResidualSolver {
    + solve(residual, initial_unknown, initial_jacobian, tolerance): root
    + good rank-one Jacobian update
  }

  NumericalMethod <|.. ExplicitEuler
  NumericalMethod <|.. RK4
  NumericalMethod <|.. BM4Composition
  NumericalMethod <|.. MidpointBM4
  BM4Composition <|-- ProjectedBM4Composition
  NumericalMethod <|.. BM4Implicit1
  NumericalMethod <|.. BM4Implicit2
  NumericalMethod <|.. MidpointABBA
  NumericalMethod <|.. ImplicitABBA1
  NumericalMethod <|.. ImplicitABBA2
  NumericalMethod <|.. ABBA4Implicit1
  NumericalMethod <|.. ABBA4SingleProjectionImplicit1
  NumericalMethod <|.. ABBA6
  NumericalMethod <|.. ABBA_implicit2
  NumericalMethod <|.. ABBA4_implicit2
  NumericalMethod <|.. BM4_implicit2
  NumericalMethod <|.. ImplicitABBA1TangentTaylor
  NumericalMethod <|.. ABBA4Implicit1TangentTaylor
}

