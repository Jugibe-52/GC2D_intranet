@startuml PotentialSystem_run_case_flow
title run_case Execution Flow in workflows_api

skinparam shadowing false
skinparam defaultTextAlignment center
skinparam activity {
  BackgroundColor #F7FAFC
  BorderColor #2D3748
  DiamondBackgroundColor #EBF8FF
  DiamondBorderColor #2B6CB0
  StartColor #2F855A
  EndColor #C53030
}
skinparam note {
  BackgroundColor #FFFFF0
  BorderColor #744210
}

start

:Notebook or caller creates params;
note right
  Typical caller:
  config = load_fourier_config(...)
  params = make_params(config.cases()[0], ...)
  system = make_system(params)
  result = run_case(system, plot=True, save=True)
end note

:system = make_system(params);

partition "make_system(params)" {
  :params = to_symp_params(params);
  :system = FourierSystem(params);

  partition "FourierSystem(params)" {
    :copy params into object attributes;
    :build random Fourier phases;
    :build phic Fourier coefficients;

    if (traj_type == "gc"?) then (yes)
      :apply FLR correction\nwith jv(0, rho * |n,m|);
    else (no)
      :keep full-orbit coefficients;
    endif

    :build fft_phi_ vector field;
  }
}

:run_case(system, plot=True, save=True);
:logger.info("Running notebook case");

:integrate_case(system);

partition "integrate_case(system)" {
  :y0 = system.initial_conditions(type=system.init);

  partition "initial_conditions()" {
    if (init == "random"?) then (yes)
      :sample random x/y positions;
    elseif (init == "fixed"?) then (yes)
      :adjust Ntraj to square grid;
      :create meshgrid in [0, 2*pi);
    elseif (init == "selected"?) then (yes)
      :read x0/y0 arrays;
      :validate matching shapes;
      :flatten selected positions;
    else (invalid)
      :raise ValueError;
      stop
    endif

    if (traj_type == "fo"?) then (yes)
      :append perpendicular velocity\ncos(phi_perp), sin(phi_perp);
      if (CheckEnergy?) then (yes)
        :append zero energy variable k;
      endif
    endif
  }

  :t_eval = 2*pi*arange(0, Tf + 1);
  :start timer;

  if (system.traj_type == "gc"?) then (gc)
    :solve_ivp_sympext(\n system,\n (0, t_eval.max()),\n y0,\n step=TimeStep,\n t_eval=t_eval,\n method=ode_solver,\n check_energy=CheckEnergy\n);
    note right
      pyhamsys calls the HamSys interface
      implemented by FourierSystem:
      y_dot(), k_dot(), potential(),
      hamiltonian()
    end note
  else (fo)
    :solve_ivp_symp(\n system.chi,\n system.chi_star,\n (0, t_eval.max()),\n y0,\n step=TimeStep,\n t_eval=t_eval,\n method=ode_solver\n);
    :system.rectify_sol(sol,\n check_energy=CheckEnergy);
    note right
      Full-orbit integration uses
      the splitting maps:
      chi() and chi_star()
    end note
  endif

  :elapsed = time.time() - start;

  if (system.CheckEnergy?) then (yes)
    :logger.info("Energy error", sol.err);
  endif

  :return SimulationResult(\n system=system,\n sol=sol,\n elapsed=elapsed\n);
}

if (plot and Method startswith "poincare"?) then (yes)
  :plot_poincare(result);

  partition "plot_poincare(result)" {
    :read system and sol from result;
    if (system.traj_type == "gc"?) then (gc)
      :x, y = split(sol.y, 2);
    else (fo)
      :x, y = first two blocks\nof split(sol.y, 4);
    endif

    if (modulo enabled?) then (yes)
      :x, y = x % (2*pi), y % (2*pi);
      :set axes limits and pi ticks;
    endif

    :ax.plot(x, y, ".");
    :result.fig = fig;
    :result.ax = ax;
  }
elseif (plot enabled but not poincare?) then (yes)
  :logger.debug("Skipping automatic plot");
else (plot disabled)
  :no automatic plot;
endif

:return result;

stop

legend right
  Main code locations:
  - src/workflows_api.py
  - src/classes/fourier_system.py

  Returned object:
  SimulationResult(system, sol, elapsed, fig, ax)
endlegend

@enduml
