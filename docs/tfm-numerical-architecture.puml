@startuml
title GC2D Scientific Simulation Architecture

left to right direction

skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 30
skinparam ranksep 55
skinparam defaultTextAlignment center
skinparam wrapWidth 180

component "1. Physical model\nPotential and guiding-center dynamics" as PhysicalModel

component "2. Initial-value problem\nInitial configuration and state geometry" as InitialValueProblem

component "3. Numerical formulation\nPhysical R2, autonomous R4, or duplicated R8" as NumericalFormulation

component "4. Simulation execution\nRK4, ABBA, or BM4\nTime span, step size, and sampling" as SimulationExecution

component "5. Solution\nImmutable sampled times, states, and diagnostics" as Solution

component "6. Validation and presentation\nAccuracy, area, energy,\nsymplecticity, and reversibility" as Validation

PhysicalModel --> InitialValueProblem
InitialValueProblem --> NumericalFormulation
NumericalFormulation --> SimulationExecution
SimulationExecution --> Solution
Solution --> Validation

@enduml
