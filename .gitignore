.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

.matplotlib/
.ipynb_checkpoints/

logs/
*.log
*.mat

# Only experiment and symbolic-derivation notebooks are versioned. Development
# notebooks remain local working files outside the supported repository API.
notebooks/*
!notebooks/experiments/
!notebooks/experiments/**
!notebooks/sympy/
!notebooks/sympy/**

# LaTeX sources and deliberate PDFs are versioned; compiler intermediates are
# reproducible build products.
docs/tex/**/*.aux
docs/tex/**/*.fdb_latexmk
docs/tex/**/*.fls
docs/tex/**/*.out
docs/tex/**/*.synctex.gz
